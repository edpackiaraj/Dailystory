---
import { getStoryVisual, type StoryVisual } from '../lib/story-visuals';

interface Props {
  story: {
    slug?: string;
    id?: string;
    title?: string;
    summary?: string;
    collection?: string;
    keywords?: string[];
    image?: string;
  };
  size?: 'card' | 'hero' | 'compact';
  lang?: string;
  class?: string;
}

const { story, size = 'card', lang = 'ta', class: extraClass = '' } = Astro.props;
const visual: StoryVisual = getStoryVisual(story);
const localizedLabel = visual.label[lang] || visual.label['en'] || visual.label['ta'];

const isHero = size === 'hero';
const isCompact = size === 'compact';
---

<div
  class={`relative overflow-hidden flex items-center justify-center select-none bg-linear-to-br ${visual.bgGradient} ${
    isHero
      ? 'w-full aspect-16/9 sm:aspect-21/9 rounded-3xl shadow-xl border-2 border-white/20 dark:border-white/10'
      : (isCompact
          ? 'w-full aspect-16/10 rounded-xl shadow-xs border border-white/10'
          : 'w-full aspect-16/10 rounded-2xl shadow-sm border border-white/10')
  } ${extraClass}`}
>
  <!-- Background Atmospheric SVG Silhouettes -->
  <svg
    class="absolute inset-0 w-full h-full opacity-25 pointer-events-none mix-blend-overlay"
    preserveAspectRatio="none"
    viewBox="0 0 400 240"
    fill="currentColor"
  >
    {visual.decorType === 'palace' && (
      <g>
        <!-- Palace Arches & Minarets -->
        <path d="M 0 240 L 0 170 Q 50 140 100 170 Q 150 130 200 170 Q 250 130 300 170 Q 350 140 400 170 L 400 240 Z" fill="#ffffff" opacity="0.4" />
        <path d="M 60 170 Q 100 110 140 170 Z M 260 170 Q 300 110 340 170 Z" fill="#ffffff" opacity="0.3" />
        <circle cx="200" cy="50" r="28" fill="#FDE047" opacity="0.25" />
      </g>
    )}

    {visual.decorType === 'forest' && (
      <g>
        <!-- Forest Canopy & Rolling Hills -->
        <path d="M 0 240 Q 80 180 180 210 Q 280 170 400 220 L 400 240 Z" fill="#ffffff" opacity="0.3" />
        <path d="M 30 220 C 50 150 80 150 100 220 Z M 300 220 C 330 140 370 140 390 220 Z" fill="#ffffff" opacity="0.25" />
        <circle cx="80" cy="50" r="22" fill="#FDE047" opacity="0.2" />
      </g>
    )}

    {visual.decorType === 'stars' && (
      <g>
        <!-- Arabian Night Stars & Dunes -->
        <path d="M 0 240 Q 120 180 250 220 Q 340 190 400 210 L 400 240 Z" fill="#ffffff" opacity="0.3" />
        <circle cx="340" cy="45" r="20" fill="#FDE047" opacity="0.4" />
        <circle cx="60" cy="40" r="2" fill="#ffffff" opacity="0.8" />
        <circle cx="120" cy="70" r="1.5" fill="#ffffff" opacity="0.7" />
        <circle cx="220" cy="35" r="2.5" fill="#ffffff" opacity="0.9" />
        <circle cx="290" cy="75" r="1.5" fill="#ffffff" opacity="0.6" />
      </g>
    )}

    {visual.decorType === 'waves' && (
      <g>
        <!-- Flowing River Ripples -->
        <path d="M 0 190 C 80 170 120 210 200 190 C 280 170 320 210 400 190 L 400 240 L 0 240 Z" fill="#ffffff" opacity="0.3" />
        <path d="M 0 210 C 100 200 150 230 250 210 C 320 200 360 220 400 215 L 400 240 L 0 240 Z" fill="#ffffff" opacity="0.2" />
        <circle cx="320" cy="60" r="25" fill="#38BDF8" opacity="0.25" />
      </g>
    )}

    {visual.decorType === 'village' && (
      <g>
        <!-- Village Cottage & Sunrise -->
        <circle cx="200" cy="80" r="50" fill="#F59E0B" opacity="0.2" />
        <path d="M 0 240 Q 150 190 400 210 L 400 240 Z" fill="#ffffff" opacity="0.3" />
        <polygon points="40,210 70,170 100,210" fill="#ffffff" opacity="0.35" />
        <polygon points="320,210 350,175 380,210" fill="#ffffff" opacity="0.3" />
      </g>
    )}

    {visual.decorType === 'castle' && (
      <g>
        <!-- Fairytale Castle Turrets -->
        <path d="M 160 240 L 160 160 L 175 140 L 190 160 L 190 240 Z" fill="#ffffff" opacity="0.3" />
        <path d="M 210 240 L 210 150 L 225 130 L 240 150 L 240 240 Z" fill="#ffffff" opacity="0.35" />
        <circle cx="80" cy="60" r="24" fill="#F43F5E" opacity="0.2" />
      </g>
    )}

    {visual.decorType === 'scroll' && (
      <g>
        <!-- Wisdom Sunburst & Moral Scroll -->
        <circle cx="200" cy="120" r="70" fill="#F59E0B" opacity="0.15" />
        <path d="M 0 240 Q 200 170 400 240 Z" fill="#ffffff" opacity="0.25" />
      </g>
    )}
  </svg>

  <!-- Central Character & Motif Emblem -->
  <div class="relative z-10 flex flex-col items-center justify-center p-3 text-center space-y-1.5 transition-transform duration-300 group-hover:scale-105">
    
    <!-- Iconic Floating Medallion -->
    <div
      class={`flex items-center justify-center rounded-full bg-white/15 backdrop-blur-md border border-white/30 shadow-lg ${
        isHero
          ? 'w-24 h-24 sm:w-28 sm:h-28 text-4xl sm:text-5xl ring-4 ring-white/20'
          : (isCompact ? 'w-12 h-12 text-2xl' : 'w-16 h-16 sm:w-18 sm:h-18 text-3xl ring-2 ring-white/20')
      }`}
      style={{ borderColor: visual.accentColor }}
    >
      <span class="filter drop-shadow-md tracking-widest">{visual.icon}</span>
    </div>

    <!-- Motif Title Tag (Hero & Card) -->
    {!isCompact && (
      <div class="max-w-[90%] pt-1">
        <span
          class={`inline-block font-black tracking-normal px-2.5 py-0.5 rounded-full text-white bg-black/40 backdrop-blur-md border border-white/20 shadow-xs line-clamp-1 ${
            isHero ? 'text-xs sm:text-sm font-bold' : 'text-[10px] sm:text-[11px]'
          }`}
          style={{ borderColor: `${visual.accentColor}80` }}
        >
          {localizedLabel}
        </span>
      </div>
    )}

  </div>

  <!-- Ambient Bottom Decorative Lighting Edge -->
  <div
    class="absolute inset-x-0 bottom-0 h-1.5 opacity-90"
    style={{ backgroundColor: visual.accentColor }}
  ></div>

</div>
