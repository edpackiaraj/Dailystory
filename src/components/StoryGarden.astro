---
---

<div class="p-6 sm:p-8 rounded-3xl bg-linear-to-b from-emerald-50 to-teal-50 dark:from-slate-900 dark:to-slate-950 border border-emerald-200 dark:border-emerald-950 shadow-sm" id="story-garden-root">
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
      <div class="w-12 h-12 rounded-2xl bg-emerald-500 text-white flex items-center justify-center text-2xl shadow-sm">
        🌱
      </div>
      <div>
        <h3 class="text-lg sm:text-xl font-black text-slate-900 dark:text-white">
          Your Story Garden
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400">
          Every story you read grows a leaf, flower or starlight petal. (No shame for paused days!).
        </p>
      </div>
    </div>
    
    <!-- Gentle Streak Display -->
    <div class="px-4 py-2 rounded-2xl bg-white dark:bg-slate-800 border border-emerald-200 dark:border-emerald-800 text-right">
      <div class="text-xs font-bold text-slate-500 uppercase">Reading Streak</div>
      <div class="text-base sm:text-lg font-black text-emerald-600 dark:text-emerald-400 flex items-center gap-1 justify-end">
        <span>🔥</span>
        <span id="streak-counter-number">1 Day</span>
      </div>
    </div>
  </div>

  <!-- Garden Canvas Container -->
  <div class="relative min-h-[160px] bg-white/80 dark:bg-slate-900/80 rounded-2xl p-6 border border-emerald-100 dark:border-slate-800 flex flex-wrap items-center justify-center gap-4" id="garden-plants-container">
    <!-- Populated dynamically via JS from localStorage -->
  </div>

  <!-- Encouraging Message -->
  <div class="mt-4 text-center text-xs text-slate-500 dark:text-slate-400 italic">
    "Welcome back anytime! Your story garden never withers."
  </div>
</div>

<script is:inline>
  (function renderGarden() {
    const container = document.getElementById('garden-plants-container');
    const streakElem = document.getElementById('streak-counter-number');
    if (!container) return;

    const streak = parseInt(localStorage.getItem('story_streak_count') || '1', 10);
    if (streakElem) streakElem.textContent = `${streak} ${streak === 1 ? 'Day' : 'Days'}`;

    const history = JSON.parse(localStorage.getItem('story_history') || '[]');
    const count = Math.max(1, history.length);

    container.innerHTML = '';
    const icons = ['🌱', '🌿', '🌸', '🌼', '🌻', '🌺', '🌷', '🪻', '⭐', '🦋', '🐝', '🦔'];

    for (let i = 0; i < Math.min(24, count); i++) {
      const plant = document.createElement('div');
      plant.className = 'w-12 h-12 rounded-xl bg-emerald-50 dark:bg-slate-800 flex items-center justify-center text-2xl shadow-2xs hover:scale-125 transition-transform cursor-pointer animate-in fade-in';
      plant.textContent = icons[i % icons.length];
      plant.title = `Story Bloom #${i + 1}`;
      container.appendChild(plant);
    }
  })();
</script>
