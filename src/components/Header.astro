---
import brandConfig from '../../config/brand.json';
import { getT, getLanguageMeta } from '../lib/i18n';

interface Props {
  currentLang: string;
  storyId?: string;
}

const { currentLang, storyId } = Astro.props;
const t = getT(currentLang);
const currentLangObj = getLanguageMeta(currentLang);
---

<header class="sticky top-0 z-30 bg-[#FFF8EC]/95 dark:bg-[#1B1A2E]/95 backdrop-blur-md border-b border-[#EEDFC8] dark:border-[#383659] transition-colors duration-200">
  <!-- Skip to Content Accessibility Link -->
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2.5 focus:bg-[#D97706] focus:text-white focus:rounded-xl focus:shadow-xl focus:outline-none"
  >
    Skip to main content
  </a>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20 gap-3">
      
      <!-- Brand Logo & Wordmark -->
      <a
        href={`/${currentLang}/`}
        class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-[#D97706] rounded-xl p-1 -ml-1 transition-all"
        aria-label={`${brandConfig.name} - Home`}
      >
        <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-[#D97706] flex items-center justify-center shadow-md group-hover:scale-105 transition-transform overflow-hidden">
          <img
            src="/favicon.svg"
            alt="Daily Tale Story Owl Mascot"
            width="36"
            height="36"
            class="w-7 h-7 sm:w-8 sm:h-8 object-contain"
          />
        </div>
        <div class="flex flex-col">
          <span class="text-xl sm:text-2xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD] tracking-tight leading-none group-hover:text-[#D97706] transition-colors">
            {brandConfig.name}
          </span>
          <span class="text-[11px] sm:text-xs font-medium text-[#6B5644] dark:text-[#C8BFAF] tracking-tight mt-0.5 leading-none">
            {brandConfig.tagline}
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links (PC: 1024px+) -->
      <nav class="hidden lg:flex items-center gap-6 text-sm font-semibold text-[#3B2A1A] dark:text-[#F3EBDD]" aria-label="Main Navigation">
        <a href={`/${currentLang}/`} class="hover:text-[#D97706] transition-colors">
          {t.home}
        </a>
        <a href={`/${currentLang}/collections/`} class="hover:text-[#D97706] transition-colors">
          {t.collections}
        </a>
        <a href={`/${currentLang}/search/`} class="hover:text-[#D97706] transition-colors flex items-center gap-1.5">
          <span>{t.search}</span>
          <kbd class="hidden xl:inline text-[10px] px-1.5 py-0.5 bg-[#EEDFC8]/60 dark:bg-[#2E2D4D] rounded font-mono border border-[#EEDFC8] dark:border-[#383659]">
            /
          </kbd>
        </a>
        <a href={`/${currentLang}/favourites/`} class="hover:text-[#D97706] transition-colors flex items-center gap-1">
          <span>⭐</span> {t.favourites}
        </a>
        <a href={`/${currentLang}/about/`} class="hover:text-[#D97706] transition-colors">
          {t.about}
        </a>
      </nav>

      <!-- Right Utility Bar -->
      <div class="flex items-center gap-2 sm:gap-2.5">
        
        <!-- Search Button (Mobile & Tablet) -->
        <a
          href={`/${currentLang}/search/`}
          aria-label="Search stories"
          class="lg:hidden p-2.5 rounded-full text-[#6B5644] dark:text-[#C8BFAF] hover:bg-[#EEDFC8] dark:hover:bg-[#2E2D4D] transition-colors flex items-center justify-center min-w-[44px] min-h-[44px]"
        >
          <span class="text-lg">🔍</span>
        </a>

        <!-- Reading Aa Settings Trigger -->
        <button
          type="button"
          data-open-aa-panel
          title="Reader Settings (Font size, style, theme)"
          aria-label="Open Reader Settings"
          class="p-2 sm:px-3 sm:py-2 rounded-2xl border border-[#EEDFC8] dark:border-[#383659] bg-white dark:bg-[#25243E] text-[#3B2A1A] dark:text-[#F3EBDD] hover:border-[#D97706] transition-all flex items-center gap-1.5 text-xs sm:text-sm font-bold min-h-[44px]"
        >
          <span class="text-sm font-serif font-black">Aa</span>
        </button>

        <!-- Searchable Language Switcher Pill -->
        <button
          type="button"
          data-open-lang-modal
          title="Change language / மொழியை மாற்று"
          aria-label="Change Language"
          class="px-3 py-2 rounded-2xl border border-[#D97706]/40 bg-[#D97706]/10 text-[#D97706] dark:text-[#F59E0B] hover:bg-[#D97706]/20 transition-all flex items-center gap-2 text-xs sm:text-sm font-bold min-h-[44px]"
        >
          <span class="text-base leading-none">{currentLangObj.flag}</span>
          <span class="hidden sm:inline font-bold">{currentLangObj.native}</span>
          <span class="text-[10px] opacity-70">▼</span>
        </button>

      </div>

    </div>
  </div>
</header>

<script is:inline>
  // Global Keyboard Shortcuts (PC):
  // "/" focuses the search bar
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName)) {
      e.preventDefault();
      const searchBox = document.querySelector('input[type="search"]');
      if (searchBox) {
        searchBox.focus();
      } else {
        const lang = document.documentElement.lang || 'en';
        window.location.href = `/${lang}/search/`;
      }
    }
  });
</script>
