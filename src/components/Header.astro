---
import brandConfig from '../../config/brand.json';
import { getT } from '../lib/i18n';
import { getSiblingStoryInLang, getStoryUrl } from '../lib/stories';

interface Props {
  currentLang: string;
  storyId?: string;
  isBedtimeActive?: boolean;
}

const { currentLang, storyId } = Astro.props;
const t = getT(currentLang);
const currentLangObj = brandConfig.supportedLanguages.find(l => l.code === currentLang) || brandConfig.supportedLanguages[0];

// Compute language switch target URLs for each language
const langLinks = brandConfig.supportedLanguages.map(lang => {
  let targetUrl = `/${lang.code}/`;
  if (storyId) {
    const sibling = getSiblingStoryInLang(storyId, lang.code);
    if (sibling) {
      targetUrl = getStoryUrl(sibling, lang.code);
    }
  }
  return {
    ...lang,
    targetUrl
  };
});
---

<header class="sticky top-0 z-40 bg-brand-50/95 dark:bg-slate-900/95 backdrop-blur-md border-b border-brand-200 dark:border-slate-800 transition-colors duration-300">
  <!-- Skip to Content Accessibility Link -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-amber-600 focus:text-white focus:rounded-md focus:shadow-lg">
    Skip to main content
  </a>

  <!-- Non-blocking Browser Language Suggestion Banner -->
  <div id="browser-lang-banner" class="hidden bg-amber-500 text-amber-950 text-xs sm:text-sm font-medium px-4 py-2 border-b border-amber-600">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
      <span id="browser-lang-text"></span>
      <div class="flex items-center gap-2">
        <a id="browser-lang-switch-btn" href="#" class="px-3 py-1 bg-amber-950 text-amber-50 rounded-full hover:bg-amber-900 transition-colors">
          Switch Language
        </a>
        <button id="browser-lang-dismiss" aria-label="Dismiss language suggestion" class="px-2 py-1 text-amber-900 hover:text-black">
          ✕
        </button>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20 gap-2 sm:gap-4">
      
      <!-- Brand Logo & Name -->
      <a href={`/${currentLang}/`} class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-amber-500 rounded-lg p-1">
        <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-amber-500 flex items-center justify-center shadow-md group-hover:scale-105 transition-transform overflow-hidden">
          <img src="/favicon.svg" alt="Dhinam Oru Kathai Owl Mascot" class="w-8 h-8 sm:w-9 sm:h-9" />
        </div>
        <div class="flex flex-col">
          <span class="text-base sm:text-xl font-extrabold text-amber-950 dark:text-amber-100 tracking-tight leading-tight group-hover:text-amber-600 transition-colors">
            {brandConfig.name}
          </span>
          <span class="text-xs sm:text-sm font-medium text-amber-700 dark:text-amber-300/80 leading-none">
            {brandConfig.nativeName}
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-6 text-sm font-semibold text-slate-700 dark:text-slate-200" aria-label="Primary Navigation">
        <a href={`/${currentLang}/`} class="hover:text-amber-600 transition-colors">{t.todaysStory}</a>
        <a href={`/${currentLang}/search/`} class="hover:text-amber-600 transition-colors">Search</a>
        <a href={`/${currentLang}/favorites/`} class="hover:text-amber-600 transition-colors flex items-center gap-1.5">
          <span>⭐</span> {t.myCorner}
        </a>
        <a href={`/${currentLang}/submit/`} class="hover:text-amber-600 transition-colors">{t.submitStory}</a>
        <a href={`/${currentLang}/about/`} class="hover:text-amber-600 transition-colors">About</a>
      </nav>

      <!-- Right Utility Bar: Language Switcher, Bedtime, Accessibility -->
      <div class="flex items-center gap-2 sm:gap-3">
        
        <!-- Bedtime Mode Button -->
        <button id="toggle-bedtime-btn" type="button" title="Toggle Bedtime Calm Mode" aria-label="Toggle Bedtime Mode" class="p-2 sm:px-3 sm:py-1.5 rounded-full bg-indigo-50 dark:bg-indigo-950/80 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800 hover:bg-indigo-100 dark:hover:bg-indigo-900 transition-all flex items-center gap-1.5 text-xs sm:text-sm font-medium shadow-sm">
          <span class="text-base">🌙</span>
          <span class="hidden lg:inline">{t.bedtimeMode}</span>
        </button>

        <!-- Accessibility Controls Button -->
        <button id="toggle-a11y-btn" type="button" title="Dyslexia Font & Text Sizing" aria-label="Accessibility Settings" class="p-2 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-700 transition-colors">
          <span class="text-base font-bold">Aa</span>
        </button>

        <!-- Header Language Switcher Dropdown -->
        <div class="relative" id="lang-dropdown-wrapper">
          <button id="lang-dropdown-btn" type="button" aria-expanded="false" aria-haspopup="true" class="flex items-center gap-1.5 px-2.5 py-1.5 sm:px-3 sm:py-2 rounded-full bg-white dark:bg-slate-800 border border-amber-300 dark:border-slate-700 text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-100 hover:bg-amber-50 dark:hover:bg-slate-700 shadow-sm transition-all">
            <span class="text-sm">{currentLangObj.flag}</span>
            <span class="hidden sm:inline">{currentLangObj.native}</span>
            <span class="text-[10px] text-slate-400">▼</span>
          </button>

          <div id="lang-dropdown-menu" class="hidden absolute right-0 mt-2 w-52 sm:w-60 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl shadow-xl py-2 z-50 animate-in fade-in-50">
            <div class="px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-slate-400 border-b border-slate-100 dark:border-slate-800 mb-1">
              Select Language / மொழி
            </div>
            {langLinks.map(lang => (
              <a
                href={lang.targetUrl}
                data-lang-code={lang.code}
                class={`flex items-center justify-between px-3.5 py-2 text-xs sm:text-sm transition-colors ${
                  lang.code === currentLang
                    ? 'bg-amber-100/70 dark:bg-amber-950/60 font-bold text-amber-900 dark:text-amber-200'
                    : 'text-slate-700 dark:text-slate-200 hover:bg-amber-50 dark:hover:bg-slate-800'
                }`}
              >
                <div class="flex items-center gap-2">
                  <span>{lang.flag}</span>
                  <span>{lang.native}</span>
                </div>
                <span class="text-[11px] text-slate-400">{lang.name}</span>
              </a>
            ))}
          </div>
        </div>

        <!-- Mobile Menu Hamburger -->
        <button id="mobile-menu-btn" type="button" aria-label="Open Navigation Menu" class="md:hidden p-2 rounded-lg bg-amber-100/60 dark:bg-slate-800 text-slate-800 dark:text-slate-200">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>

      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-nav" class="hidden md:hidden border-t border-brand-200 dark:border-slate-800 bg-brand-50 dark:bg-slate-900 px-4 pt-3 pb-6 space-y-3">
    <a href={`/${currentLang}/`} class="block py-2 text-base font-semibold text-slate-800 dark:text-slate-100">{t.todaysStory}</a>
    <a href={`/${currentLang}/search/`} class="block py-2 text-base font-semibold text-slate-800 dark:text-slate-100">Search Stories</a>
    <a href={`/${currentLang}/favorites/`} class="block py-2 text-base font-semibold text-slate-800 dark:text-slate-100">⭐ {t.myCorner}</a>
    <a href={`/${currentLang}/submit/`} class="block py-2 text-base font-semibold text-slate-800 dark:text-slate-100">{t.submitStory}</a>
    <a href={`/${currentLang}/about/`} class="block py-2 text-base font-semibold text-slate-800 dark:text-slate-100">About & Mission</a>
    <a href={`/${currentLang}/parent-guide/`} class="block py-2 text-base font-semibold text-slate-800 dark:text-slate-100">Parent & Teacher Guide</a>
  </div>

  <!-- Accessibility Drawer Popup -->
  <div id="a11y-panel" class="hidden border-t border-slate-200 dark:border-slate-800 bg-amber-50/95 dark:bg-slate-950/95 px-4 py-4 text-xs sm:text-sm">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="font-bold text-slate-700 dark:text-slate-300">Reading Comfort:</span>
        <button id="btn-font-smaller" class="px-2.5 py-1 bg-white dark:bg-slate-800 border rounded font-bold">A-</button>
        <button id="btn-font-reset" class="px-2.5 py-1 bg-white dark:bg-slate-800 border rounded font-bold">Reset</button>
        <button id="btn-font-larger" class="px-2.5 py-1 bg-white dark:bg-slate-800 border rounded font-bold">A+</button>
      </div>

      <div class="flex items-center gap-4">
        <label class="flex items-center gap-2 cursor-pointer font-medium text-slate-700 dark:text-slate-300">
          <input type="checkbox" id="toggle-dyslexic-font" class="rounded text-amber-600 focus:ring-amber-500" />
          <span>OpenDyslexic Font</span>
        </label>

        <label class="flex items-center gap-2 cursor-pointer font-medium text-slate-700 dark:text-slate-300">
          <input type="checkbox" id="toggle-line-height" class="rounded text-amber-600 focus:ring-amber-500" />
          <span>Spacious Line Height</span>
        </label>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  // Language Switcher Memory & Dropdown Logic
  const langBtn = document.getElementById('lang-dropdown-btn');
  const langMenu = document.getElementById('lang-dropdown-menu');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileNav = document.getElementById('mobile-nav');
  const a11yBtn = document.getElementById('toggle-a11y-btn');
  const a11yPanel = document.getElementById('a11y-panel');

  if (langBtn && langMenu) {
    langBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = langBtn.getAttribute('aria-expanded') === 'true';
      langBtn.setAttribute('aria-expanded', !isExpanded);
      langMenu.classList.toggle('hidden');
    });

    document.addEventListener('click', (e) => {
      if (!langMenu.contains(e.target) && !langBtn.contains(e.target)) {
        langMenu.classList.add('hidden');
        langBtn.setAttribute('aria-expanded', 'false');
      }
    });

    // Save language choice upon clicking any language option
    langMenu.querySelectorAll('a[data-lang-code]').forEach(link => {
      link.addEventListener('click', () => {
        const selectedCode = link.getAttribute('data-lang-code');
        if (selectedCode) {
          localStorage.setItem('story_lang', selectedCode);
          document.cookie = `story_lang=${selectedCode};path=/;max-age=31536000;SameSite=Lax`;
        }
      });
    });
  }

  // Mobile navigation toggle
  if (mobileMenuBtn && mobileNav) {
    mobileMenuBtn.addEventListener('click', () => {
      mobileNav.classList.toggle('hidden');
    });
  }

  // Accessibility settings toggle
  if (a11yBtn && a11yPanel) {
    a11yBtn.addEventListener('click', () => {
      a11yPanel.classList.toggle('hidden');
    });
  }

  // Dyslexic Font and Spacing controls
  const dyslexicCheckbox = document.getElementById('toggle-dyslexic-font');
  const lineHeightCheckbox = document.getElementById('toggle-line-height');
  const smallerBtn = document.getElementById('btn-font-smaller');
  const largerBtn = document.getElementById('btn-font-larger');
  const resetBtn = document.getElementById('btn-font-reset');

  if (dyslexicCheckbox) {
    if (localStorage.getItem('a11y_dyslexic') === 'true') {
      dyslexicCheckbox.checked = true;
      document.documentElement.classList.add('font-dyslexic');
    }
    dyslexicCheckbox.addEventListener('change', () => {
      if (dyslexicCheckbox.checked) {
        document.documentElement.classList.add('font-dyslexic');
        localStorage.setItem('a11y_dyslexic', 'true');
      } else {
        document.documentElement.classList.remove('font-dyslexic');
        localStorage.setItem('a11y_dyslexic', 'false');
      }
    });
  }

  if (lineHeightCheckbox) {
    if (localStorage.getItem('a11y_line_height') === 'true') {
      lineHeightCheckbox.checked = true;
      document.body.classList.add('leading-loose');
    }
    lineHeightCheckbox.addEventListener('change', () => {
      if (lineHeightCheckbox.checked) {
        document.body.classList.add('leading-loose');
        localStorage.setItem('a11y_line_height', 'true');
      } else {
        document.body.classList.remove('leading-loose');
        localStorage.setItem('a11y_line_height', 'false');
      }
    });
  }

  // Non-blocking browser language suggestion banner
  (function initBrowserLang() {
    const banner = document.getElementById('browser-lang-banner');
    const bannerText = document.getElementById('browser-lang-text');
    const switchBtn = document.getElementById('browser-lang-switch-btn');
    const dismissBtn = document.getElementById('browser-lang-dismiss');

    if (!banner || !bannerText || !switchBtn || !dismissBtn) return;
    if (localStorage.getItem('dismiss_browser_lang_banner') === 'true') return;

    const currentPath = window.location.pathname;
    const currentLang = currentPath.split('/')[1] || 'en';
    const browserLang = (navigator.language || navigator.userLanguage || 'en').slice(0, 2).toLowerCase();

    const supported = ['en', 'ta', 'hi', 'es', 'zh', 'pt', 'ml', 'te', 'kn', 'mr'];
    if (supported.includes(browserLang) && browserLang !== currentLang) {
      bannerText.textContent = `Looking for stories in your browser language (${browserLang.toUpperCase()})?`;
      switchBtn.href = `/${browserLang}/`;
      switchBtn.textContent = `Read in ${browserLang.toUpperCase()}`;
      banner.classList.remove('hidden');

      dismissBtn.addEventListener('click', () => {
        banner.classList.add('hidden');
        localStorage.setItem('dismiss_browser_lang_banner', 'true');
      });
    }
  })();
</script>
