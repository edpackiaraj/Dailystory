---
interface Props {
  currentLang: string;
}

const { currentLang } = Astro.props;
const isTa = currentLang === 'ta';
---

<div class="max-w-5xl mx-auto space-y-12">
  <!-- Hero Header -->
  <header class="text-center space-y-4 max-w-3xl mx-auto">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#D97706]/10 text-[#D97706] text-xs font-black tracking-wide uppercase">
      <span>🦉</span> {isTa ? 'உலக ஞானக் கருவூலமும் விவேக நாட்டார் கதைகளும்' : 'World Wisdom & Folklore Sanctuary'}
    </div>
    <h1 class="text-3xl sm:text-5xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD] tracking-tight leading-tight">
      {isTa ? 'Daily Tale பற்றி' : 'About Daily Tale'}
    </h1>
    <p class="text-base sm:text-lg font-bold text-[#D97706]">
      {isTa ? 'Daily Tale – நீதிக்கதைகளும் பண்பாட்டு மரபுக் கதைகளும்' : 'Daily Tale – Moral Stories & Interesting Folktales'}
    </p>
    <p class="text-sm sm:text-base text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
      {isTa
        ? 'Daily Tale என்பது உலகம் முழுவதிலுமிருந்து திரட்டப்பட்ட காலத்தால் அழியாத மரபுக் கதைகள், ஈசாப் கதைகள் மற்றும் பண்பாட்டு ஞானத்தின் மூலம் நற்பண்புகளையும், கற்பனை வளத்தையும், மனிதநேயத்தையும் வளர்க்கும் ஒரு பன்மொழி எண்ணிம கதைக்களஞ்சியம்.'
        : 'Daily Tale is a multilingual digital storytelling sanctuary dedicated to nourishing character, imagination, and empathy through timeless folktales, fables, and heritage wisdom from world cultures.'}
    </p>
  </header>

  <!-- Grouped Feature Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Feature 1: Multilingual Story Treasury -->
    <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] shadow-sm hover:border-[#D97706] hover:shadow-md transition-all space-y-3">
      <div class="w-12 h-12 rounded-2xl bg-[#D97706]/15 flex items-center justify-center text-2xl text-[#D97706]">
        📚
      </div>
      <h2 class="text-xl font-black text-[#3B2A1A] dark:text-[#F3EBDD]">
        {isTa ? 'பன்மொழி நாட்டார் கதைப் பேழை' : 'Multilingual Folklore Treasury'}
      </h2>
      <p class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
        {isTa
          ? 'தமிழ், ஆங்கிலம், இந்தி, தெலுங்கு, மலையாளம், கன்னடம், மராத்தி மற்றும் சீனம் ஆகிய 8 உலக மொழிகளில் தொகுக்கப்பட்ட 2,448-க்கும் மேற்பட்ட கதைகளை நாங்கள் வழங்குகிறோம். அக்பர்–பீர்பால், தெனாலிராமன், பஞ்சதந்திரம், ஈசாப் நீதிக்கதைகள், ஜாதகக் கதைகள், ஆண்டர்சன் கதைகள், கிரிம் சகோதரர்களின் கதைகள், அரேபிய இரவுகள் மற்றும் ஆசியா, ஆப்பிரிக்கா, ஐரோப்பா, அமெரிக்க நாடுகளின் பாரம்பரியக் கதைகள் இதில் அடங்கும்.'
          : 'We bring together over 2,448 curated stories across 8 languages: English, Tamil, Hindi, Telugu, Malayalam, Kannada, Marathi, and Chinese. Our collections span Akbar–Birbal, Tenali Rama, Panchatantra, Aesop\'s Fables, Jataka Tales, Hans Christian Andersen, Brothers Grimm, Arabian Nights, and cultural folklore from across Asia, Africa, Europe, and the Americas.'}
      </p>
      <div class="flex flex-wrap gap-2 pt-2 text-[11px] font-semibold text-[#0F766E] dark:text-[#2DD4BF]">
        <span class="px-2.5 py-1 rounded-lg bg-[#0F766E]/10">{isTa ? '2,448+ கதைகள்' : '2,448+ Stories'}</span>
        <span class="px-2.5 py-1 rounded-lg bg-[#0F766E]/10">{isTa ? '8 உலக மொழிகள்' : '8 World Languages'}</span>
        <span class="px-2.5 py-1 rounded-lg bg-[#0F766E]/10">{isTa ? '13 முக்கிய மரபுகள்' : '13 Major Traditions'}</span>
      </div>
    </div>

    <!-- Feature 2: Audio & Adaptive Reading Toolbar -->
    <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] shadow-sm hover:border-[#D97706] hover:shadow-md transition-all space-y-3">
      <div class="w-12 h-12 rounded-2xl bg-blue-500/15 flex items-center justify-center text-2xl text-blue-600">
        🎧
      </div>
      <h2 class="text-xl font-black text-[#3B2A1A] dark:text-[#F3EBDD]">
        {isTa ? 'ஒலி வாசிப்பு & தகவமைக்கும் வாசிப்புக் கருவிப்பட்டி' : 'Audio & Adaptive Reading Toolbar'}
      </h2>
      <p class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
        {isTa
          ? 'எமது தளம் உலவி-சார்ந்த குரல் வாசிப்பு வசதியையும், வாசிப்பு வேகக் கட்டுப்பாட்டையும் (0.8x முதல் 1.5x வரை), வாக்கியம்-வாக்கியமாக ஒளிரும் வாசிப்பு உதவியையும் வழங்குகிறது. இளம் வாசகர்களுக்கும் சிறப்புத் தேவையுடையோருக்கும் உதவும் வகையில் டிஸ்லெக்ஸியா நட்பு எழுத்துரு (OpenDyslexic), எழுத்து அளவு மாற்றம், வரி இடைவெளி சரிசெய்தல் மற்றும் இரவு/செபியா வாசிப்பு முறைகள் ஆகியவையும் உள்ளன.'
          : 'Our platform offers browser-native read-aloud audio narration powered by text-to-speech, complete with adjustable playback speed (0.8x to 1.5x) and sentence-by-sentence reading assistance. To ensure maximum accessibility for neurodivergent and young readers, our reading toolbar features specialized typography controls including the OpenDyslexic typeface, custom font sizing, fluid line-height adjustment, and night/sepia reading themes.'}
      </p>
      <div class="flex flex-wrap gap-2 pt-2 text-[11px] font-semibold text-blue-700 dark:text-blue-400">
        <span class="px-2.5 py-1 rounded-lg bg-blue-500/10">{isTa ? 'இயற்கைக் குரல் வாசிப்பு' : 'Natural TTS'}</span>
        <span class="px-2.5 py-1 rounded-lg bg-blue-500/10">{isTa ? 'டிஸ்லெக்ஸியா எழுத்துரு' : 'OpenDyslexic Font'}</span>
        <span class="px-2.5 py-1 rounded-lg bg-blue-500/10">{isTa ? '0.8x–1.5x வேகம்' : '0.8x–1.5x Speed'}</span>
      </div>
    </div>

    <!-- Feature 3: Structured Pedagogical Depth -->
    <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] shadow-sm hover:border-[#D97706] hover:shadow-md transition-all space-y-3">
      <div class="w-12 h-12 rounded-2xl bg-purple-500/15 flex items-center justify-center text-2xl text-purple-600">
        🎓
      </div>
      <h2 class="text-xl font-black text-[#3B2A1A] dark:text-[#F3EBDD]">
        {isTa ? 'கற்பித்தல் ஆழமும் வினாடி வினாக்களும்' : 'Structured Pedagogical Depth'}
      </h2>
      <p class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
        {isTa
          ? 'பெற்றோர்கள், ஆசிரியர்கள் மற்றும் மொழி கற்போருக்கு உதவும் வகையில், ஒவ்வொரு கதையும் புளூமின் வகைப்பாட்டியல் (Bloom\'s Taxonomy) அடிப்படையிலான கலந்துரையாடல் வினாக்கள் (நினைவுகூர்தல், புரிதல், பயன்படுத்துதல், பகுப்பாய்வு, மதிப்பீடு, உருவாக்குதல்), தெளிவான கலைச்சொல் விளக்கங்கள் மற்றும் ஊடாடும் வினாடி வினாக்களுடன் வடிவமைக்கப்பட்டுள்ளது.'
          : 'To support parents, educators, and language learners, every story is enriched with structured pedagogical resources: Bloom\'s Taxonomy reflection prompts (spanning Remember, Understand, Apply, Analyze, Evaluate, and Create levels), curated in-text vocabulary glossaries with exact definitions, and interactive comprehension quizzes that cultivate critical thinking.'}
      </p>
      <div class="flex flex-wrap gap-2 pt-2 text-[11px] font-semibold text-purple-700 dark:text-purple-400">
        <span class="px-2.5 py-1 rounded-lg bg-purple-500/10">{isTa ? 'புளூமின் 6 நிலைகள்' : 'Bloom\'s Taxonomy'}</span>
        <span class="px-2.5 py-1 rounded-lg bg-purple-500/10">{isTa ? 'கலைச்சொற்கள் விளக்கம்' : 'Vocabulary Glossaries'}</span>
        <span class="px-2.5 py-1 rounded-lg bg-purple-500/10">{isTa ? 'ஊடாடும் வினாடி வினாக்கள்' : 'Interactive Quizzes'}</span>
      </div>
    </div>

    <!-- Feature 4: Classroom & Community Resources -->
    <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] shadow-sm hover:border-[#D97706] hover:shadow-md transition-all space-y-3">
      <div class="w-12 h-12 rounded-2xl bg-emerald-500/15 flex items-center justify-center text-2xl text-emerald-600">
        🏫
      </div>
      <h2 class="text-xl font-black text-[#3B2A1A] dark:text-[#F3EBDD]">
        {isTa ? 'வகுப்பறை & சமூக வளங்கள்' : 'Classroom & Community Resources'}
      </h2>
      <p class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
        {isTa
          ? 'Daily Tale பதிவிறக்கம் செய்து பகிரக்கூடிய \'இன்றைய நீதி\' அட்டைகள், வாசிப்புச் சான்றிதழ்கள், அச்சிடத்தக்க கதைச் சுருக்கங்கள் மற்றும் வாட்ஸ்அப், டெலிகிராம் வழியாக எளிதாகப் பகிரும் வசதிகளை வழங்குகிறது.'
          : 'Daily Tale provides ready-to-share educational tools, including exportable \'Moral of the Day\' cards, reading milestone certificates, printable story summaries, and seamless one-click sharing via WhatsApp, Telegram, and email for home, community, and classroom reflection.'}
      </p>
      <div class="flex flex-wrap gap-2 pt-2 text-[11px] font-semibold text-emerald-700 dark:text-emerald-400">
        <span class="px-2.5 py-1 rounded-lg bg-emerald-500/10">{isTa ? 'நீதிநெறி அட்டைகள்' : 'Exportable Cards'}</span>
        <span class="px-2.5 py-1 rounded-lg bg-emerald-500/10">{isTa ? 'அச்சிடத்தக்க சுருக்கங்கள்' : 'Printable Summaries'}</span>
        <span class="px-2.5 py-1 rounded-lg bg-emerald-500/10">{isTa ? 'எளிதான பகிர்வு' : 'One-Click Sharing'}</span>
      </div>
    </div>
  </div>

  <!-- Privacy & PWA Commitment Banner -->
  <div class="p-6 sm:p-8 rounded-3xl bg-linear-to-r from-[#FFF8EC] to-amber-500/10 dark:from-[#25243E] dark:to-[#1E1D36] border-2 border-[#EEDFC8] dark:border-[#383659] flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="space-y-2 text-center md:text-left">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 font-bold text-xs">
        <span>🔒</span> {isTa ? '100% இலவசம், பாதுகாப்பானது & தனியுரிமை முதன்மை' : '100% Free, Safe & Privacy-First'}
      </div>
      <h2 class="text-xl sm:text-2xl font-black text-[#3B2A1A] dark:text-[#F3EBDD]">
        {isTa ? 'இலகுரக PWA & பயனர்களைக் கண்காணிக்காத உறுதிப்பாடு' : 'Lightweight PWA & Zero Tracking Commitment'}
      </h2>
      <p class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF] max-w-2xl leading-relaxed">
        {isTa
          ? 'குறைந்த இணைய வேகத்திலும் இயங்கும் முற்போக்கு வலைச் செயலி (PWA) தொழில்நுட்பத்தில் உருவாக்கப்பட்ட Daily Tale, முழுமையான ஆஃப்லைன் வாசிப்பையும் ஆதரிக்கிறது. எமது உறுதிமொழி: 100% இலவசம், 100% விளம்பரமற்றது, பயனர்களைக் கண்காணிக்கும் நிரல்கள் எதுவுமில்லை, பதிவு செய்யத் தேவையில்லை.'
          : 'Built with ultra-lightweight Progressive Web App technology and browser-native audio capabilities, Daily Tale is engineered for instant offline reading and minimal server dependency. Our commitment to children, families, and classrooms is absolute: 100% free, 100% ad-free, zero tracking, and zero user registration.'}
      </p>
    </div>
    <div class="shrink-0 flex items-center gap-3 text-xs font-bold text-[#D97706]">
      <span class="px-3 py-2 rounded-xl bg-white dark:bg-[#1B1A2E] border border-[#EEDFC8] dark:border-[#383659]">{isTa ? 'விளம்பரமில்லை' : 'Zero Ads'}</span>
      <span class="px-3 py-2 rounded-xl bg-white dark:bg-[#1B1A2E] border border-[#EEDFC8] dark:border-[#383659]">{isTa ? 'பதிவு தேவையில்லை' : 'Zero Logins'}</span>
      <span class="px-3 py-2 rounded-xl bg-white dark:bg-[#1B1A2E] border border-[#EEDFC8] dark:border-[#383659]">{isTa ? 'ஆஃப்லைன் PWA' : 'Offline PWA'}</span>
    </div>
  </div>

  <!-- Our Mission Card -->
  <div class="p-8 sm:p-10 rounded-3xl bg-[#D97706]/10 dark:bg-[#D97706]/15 border-2 border-[#D97706]/40 text-center space-y-3">
    <span class="text-3xl">⭐</span>
    <h2 class="text-2xl sm:text-3xl font-black text-[#D97706] dark:text-[#F59E0B]">
      {isTa ? 'எமது இலட்சியம்' : 'Our Mission'}
    </h2>
    <p class="text-base sm:text-lg font-medium text-[#3B2A1A] dark:text-[#F3EBDD] max-w-3xl mx-auto leading-relaxed">
      {isTa
        ? '"காலத்தால் அழியாத நற்பண்புகளையும் உலக நாட்டார் கதை ஞானத்தையும் அனைவருக்கும் இலவசமாகவும் எளிமையாகவும் வழங்கி, குடும்பங்களும் வகுப்பறைகளும் மனிதநேயத்துடனும் மொழிவளத்துடனும் ஒன்றிணைந்து வளர உதவுவதே எமது இலட்சியம்."'
        : '"To make timeless moral wisdom, character values, and world folklore freely accessible, understandable, and inspiring every day, supporting families, educators, and language learners in growing together in empathy and global literacy."'}
    </p>
  </div>

  <!-- SECTION: About Me — Edward Packiaraj -->
  <section id="about-me" class="relative overflow-hidden rounded-3xl bg-linear-to-br from-[#FFF8EC] via-white to-[#FDF4E7] dark:from-[#25243E] dark:via-[#1E1D36] dark:to-[#17162B] border-2 border-[#EEDFC8] dark:border-[#383659] p-6 sm:p-10 shadow-lg space-y-8">
    <div class="flex flex-col md:flex-row items-center md:items-start gap-6 sm:gap-8">
      <div class="shrink-0 flex flex-col items-center text-center space-y-3">
        <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-3xl bg-linear-to-br from-[#D97706] to-[#B45309] text-white flex items-center justify-center text-4xl sm:text-5xl shadow-md border-4 border-white dark:border-[#25243E]">
          🎓
        </div>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 font-bold text-xs">
          OER Pioneer
        </span>
      </div>

      <div class="space-y-4 text-center md:text-left flex-1">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#D97706]/15 text-[#D97706] dark:text-[#F59E0B] text-xs font-black uppercase tracking-wider mb-2">
            {isTa ? 'நிறுவனர் & கல்விக் கட்டமைப்பாளர்' : 'Founder & Educational Architect'}
          </div>
          <h2 class="text-2xl sm:text-4xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD]">
            {isTa ? 'என்னைப்பற்றி — ' : 'About Me — '}
            <a href="https://edwardpackiaraj.blogspot.com/" target="_blank" rel="noopener noreferrer" class="hover:text-[#D97706] underline decoration-[#D97706]/50">
              {isTa ? 'எஸ். எட்வர்ட் பாக்கியராஜ்' : 'S. Edward Packiaraj'}
            </a>
          </h2>
          <p class="text-xs sm:text-sm font-semibold text-[#0F766E] dark:text-[#2DD4BF] mt-1">
            (M.Com., M.Phil., B.Ed., BLIS., PGDBA., PGDCA.)
          </p>
          <p class="text-sm sm:text-base font-bold text-[#3B2A1A] dark:text-[#F3EBDD] mt-1">
            {isTa
              ? 'கல்வி ஊடகத் தொழில்நுட்ப ஆலோசகர், ரோசரி இ-சொல்யூஷன்ஸ், திருச்சி'
              : 'Consultant – Educational Media Technologies, Rosary e-Solutions, Trichy'}
          </p>
        </div>

        <!-- Key Credentials & Milestone Badges -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 text-xs">
          <div class="p-3 rounded-2xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] flex items-center gap-3 shadow-2xs">
