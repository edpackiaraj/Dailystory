---
interface Props {
  currentLang: string;
}

const { currentLang } = Astro.props;
const isTa = currentLang === 'ta';
---

<div class="max-w-5xl mx-auto space-y-12">
  
  <!-- HERO BANNER -->
  <header class="text-center space-y-5 max-w-4xl mx-auto">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#0F766E]/10 border border-[#0F766E]/30 text-[#0F766E] dark:text-[#2DD4BF] text-xs font-black tracking-wide uppercase">
      <span>🎓</span>
      <span>{isTa ? 'ஆய்வு சஞ்சிகைக் கட்டுரை & பள்ளிக் கல்விக் கையேடு' : 'Research Monograph & Pedagogical Framework'}</span>
    </div>

    <h1 class="text-3xl sm:text-5xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD] tracking-tight leading-tight">
      {isTa ? 'கதைவழிக் கற்றலும் கல்வி உளவியல் பரிமாணங்களும்' : 'Digital Narrative Pedagogy & Educational Psychology'}
    </h1>

    <p class="text-base sm:text-lg font-bold text-[#D97706]">
      {isTa 
        ? 'பள்ளிகள், ஆசிரியர்கள், மாணவர்கள் மற்றும் பெற்றோர்களுக்கான முழுமையான வழிகாட்டி'
        : 'A Comprehensive Framework for Schools, Educators, Students, and Parents'}
    </p>

    <p class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed max-w-3xl mx-auto">
      {isTa
        ? 'ஜீன் பியாஜே, லெவ் வைகோட்ஸ்கி, லாரன்ஸ் கோல்பெர்க், ஆலன் பாய்வியோ மற்றும் ஹோவர்ட் கார்ட்னர் ஆகியோரின் கல்வி உளவியல் கோட்பாடுகளின் அடிப்படையில், மாணவர்களின் சிந்தனைத் திறன், மொழி ஆளுமை மற்றும் மனிதநேய விழுமியங்களை வளர்க்கும் நவீன எண்ணிமக் கற்பித்தல் வரைவு.'
        : 'Grounded in cognitive psychology (Piaget, Vygotsky, Kohlberg, Paivio, Gardner), this monograph articulates how digital folklore nurtures critical thinking, language acquisition, emotional intelligence, and egalitarian ethics.'}
    </p>

    <!-- ACTION BUTTONS: DOWNLOAD WORD DOC & PRINT -->
    <div class="flex flex-wrap items-center justify-center gap-3 pt-3">
      <a
        href="/docs/DailyStory_Educational_Psychology_Guide.docx"
        download
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-2xl bg-[#1E3A8A] hover:bg-[#1E40AF] text-white text-xs sm:text-sm font-bold shadow-md hover:scale-102 transition-all"
      >
        <span>📥</span>
        <span>{isTa ? 'Word (.docx) பதிவிறக்குக' : 'Download Word Doc (.docx)'}</span>
      </a>
      <a
        href="/docs/DailyStory_Educational_Psychology_Guide.doc"
        download
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-2xl bg-[#0F766E] hover:bg-[#115E59] text-white text-xs sm:text-sm font-bold shadow-md hover:scale-102 transition-all"
      >
        <span>📄</span>
        <span>{isTa ? 'Doc வடிவில் (.doc)' : 'Download Doc (.doc)'}</span>
      </a>
      <button
        type="button"
        onclick="window.print()"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-white dark:bg-[#1E1D36] border border-[#EEDFC8] dark:border-[#383659] text-[#3B2A1A] dark:text-[#F3EBDD] hover:bg-[#FFF4E0] dark:hover:bg-[#25243E] text-xs sm:text-sm font-bold transition-all shadow-xs"
      >
        <span>🖨️</span>
        <span>{isTa ? 'அச்சிடுக / PDF' : 'Print / Save as PDF'}</span>
      </button>
    </div>
  </header>

  <!-- QUICK NAVIGATION TABS (ANCHOR LINKS) -->
  <nav class="flex flex-wrap items-center justify-center gap-2 p-2 rounded-2xl bg-white dark:bg-[#1E1D36] border border-[#EEDFC8] dark:border-[#383659] shadow-xs text-xs font-bold text-[#6B5644] dark:text-[#C8BFAF]">
    <a href="#psychology" class="px-3 py-1.5 rounded-xl hover:bg-[#FFF4E0] dark:hover:bg-[#25243E] hover:text-[#D97706]">🧠 {isTa ? 'கல்வி உளவியல்' : 'Psychology'}</a>
    <a href="#schools" class="px-3 py-1.5 rounded-xl hover:bg-[#FFF4E0] dark:hover:bg-[#25243E] hover:text-[#D97706]">🏫 {isTa ? 'பள்ளிகளில் பயன்பாடு' : 'School Model'}</a>
    <a href="#teachers" class="px-3 py-1.5 rounded-xl hover:bg-[#FFF4E0] dark:hover:bg-[#25243E] hover:text-[#D97706]">👩‍🏫 {isTa ? 'ஆசிரியர்களுக்கு (5E)' : 'Teachers (5E)'}</a>
    <a href="#students" class="px-3 py-1.5 rounded-xl hover:bg-[#FFF4E0] dark:hover:bg-[#25243E] hover:text-[#D97706]">🎒 {isTa ? 'மாணவர்களுக்கு' : 'Students'}</a>
    <a href="#parents" class="px-3 py-1.5 rounded-xl hover:bg-[#FFF4E0] dark:hover:bg-[#25243E] hover:text-[#D97706]">👨‍👩‍👧 {isTa ? 'பெற்றோர்களுக்கு' : 'Parents'}</a>
    <a href="#collections" class="px-3 py-1.5 rounded-xl hover:bg-[#FFF4E0] dark:hover:bg-[#25243E] hover:text-[#D97706]">📚 {isTa ? '13 கதைத் தொகுப்புகள்' : '13 Traditions'}</a>
    <a href="#ethics" class="px-3 py-1.5 rounded-xl hover:bg-[#FFF4E0] dark:hover:bg-[#25243E] hover:text-[#D97706]">⚖️ {isTa ? 'சமத்துவ விழுமியம்' : 'Egalitarian Ethics'}</a>
  </nav>

  <!-- SECTION 1: EDUCATIONAL PSYCHOLOGY FOUNDATIONS -->
  <section id="psychology" class="space-y-6 pt-4 scroll-mt-20">
    <div class="flex items-center gap-3 border-b border-[#EEDFC8] dark:border-[#383659] pb-3">
      <div class="w-10 h-10 rounded-2xl bg-[#D97706]/15 flex items-center justify-center text-xl text-[#D97706]">
        🧠
      </div>
      <div>
        <h2 class="text-xl sm:text-2xl font-black text-[#3B2A1A] dark:text-[#F3EBDD]">
          {isTa ? '1. கல்வி உளவியல் அடிப்படைக் கோட்பாடுகள்' : '1. Theoretical Frameworks in Educational Psychology'}
        </h2>
        <p class="text-xs text-[#6B5644] dark:text-[#C8BFAF]">
          {isTa ? 'பியாஜே, வைகோட்ஸ்கி, கோல்பெர்க், பாய்வியோ மற்றும் கார்ட்னரின் அறிவியல் சட்டகம்' : 'Rooted in cognitive, sociocultural, moral, and multimodal learning paradigms'}
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <!-- Card 1: Piaget -->
      <div class="p-6 rounded-3xl bg-white dark:bg-[#1E1D36] border border-[#EEDFC8] dark:border-[#383659] shadow-xs space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-black px-2.5 py-1 rounded-lg bg-blue-500/10 text-blue-600 dark:text-blue-400">Jean Piaget</span>
          <span class="text-lg">🌱</span>
        </div>
        <h3 class="text-base font-bold text-[#3B2A1A] dark:text-[#F3EBDD]">
          {isTa ? 'அறிவாற்றல் வளர்ச்சி நிலைகள் (Cognitive Stages)' : 'Cognitive Developmental Stages'}
        </h3>
        <p class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
          {isTa 
            ? 'குழந்தைகளின் உயிருடைமைக் கொள்கைக்கு (Animism) ஏற்ப ஈசாப், பஞ்சதந்திரக் கதைகள் குறியீட்டுச் சிந்தனையை (Symbolic Thought) உருவாக்குகின்றன. அக்பர்-பீர்பால் பருப்பொருள் நிலைக்கும் (Concrete Operational), விக்கிரமாதித்தன் தர்க்கங்கள் முறையான செயல்பாட்டு நிலைக்கும் (Formal Operational) வழிவகுக்கின்றன.'
            : 'Fables tap into childhood animism for symbolic thought (2-7 yrs), courtly wit cultivates concrete operations (7-11 yrs), and Vikram-Vetal riddles stimulate formal operational abstract deduction (11+ yrs).'}
        </p>
      </div>

      <!-- Card 2: Vygotsky -->
      <div class="p-6 rounded-3xl bg-white dark:bg-[#1E1D36] border border-[#EEDFC8] dark:border-[#383659] shadow-xs space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-black px-2.5 py-1 rounded-lg bg-teal-500/10 text-teal-600 dark:text-teal-400">Lev Vygotsky</span>
          <span class="text-lg">🪜</span>
        </div>
        <h3 class="text-base font-bold text-[#3B2A1A] dark:text-[#F3EBDD]">
          {isTa ? 'அருகமை வளர்ச்சி மண்டலம் (ZPD & Scaffolding)' : 'Zone of Proximal Development & Scaffolding'}
        </h3>
        <p class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
          {isTa
            ? 'மாணவர்கள் தனித்து வாசிப்பதற்கும் வழிகாட்டுதலுடன் உயர் அறிவை அடைவதற்கும் இடைப்பட்ட பகுதியே ZPD. கதையின் முடிவில் உள்ள சிந்தனை வினாக்கள் (Think & Talk), புதிய சொற்களஞ்சிய விளக்கங்கள் மாணவர்களுக்குத் தகுந்த சாரக்கட்டுக் கற்றல் (Scaffolding) ஆதரவை வழங்குகின்றன.'
            : 'End-of-story reflective prompts, moral cores, and contextual word tooltips provide dynamic instructional scaffolding, bridging actual ability to potential cognitive maturity.'}
        </p>
      </div>

      <!-- Card 3: Kohlberg -->
      <div class="p-6 rounded-3xl bg-white dark:bg-[#1E1D36] border border-[#EEDFC8] dark:border-[#383659] shadow-xs space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-black px-2.5 py-1 rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400">Lawrence Kohlberg</span>
          <span class="text-lg">⚖️</span>
        </div>
        <h3 class="text-base font-bold text-[#3B2A1A] dark:text-[#F3EBDD]">
          {isTa ? 'ஒழுக்கநெறி வளர்ச்சிப் படிநிலைகள் (Moral Reasoning)' : 'Moral Dilemma & Ethics Evolution'}
        </h3>
        <p class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
          {isTa
            ? 'தண்டனைக்கு அஞ்சுதல் என்ற ஆரம்ப நிலையிலிருந்து, சமுதாய ஒப்பந்தம் மற்றும் உலகளாவிய மனிதநேய விழுமியங்கள் (Universal Ethical Principles) நோக்கி மாணவர்களின் மனசாட்சியை உயர்த்த விக்கிரமாதித்தன் மற்றும் ஜாதகக் கதைகள் உதவுகின்றன.'
            : 'Transitions young minds from reward/punishment compliance into conventional empathy and post-conventional universal human rights through multi-faceted moral quandaries.'}
        </p>
      </div>

      <!-- Card 4: Paivio & Gardner -->
      <div class="p-6 rounded-3xl bg-white dark:bg-[#1E1D36] border border-[#EEDFC8] dark:border-[#383659] shadow-xs space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-black px-2.5 py-1 rounded-lg bg-purple-500/10 text-purple-600 dark:text-purple-400">Paivio &amp; Gardner</span>
          <span class="text-lg">🎨</span>
        </div>
        <h3 class="text-base font-bold text-[#3B2A1A] dark:text-[#F3EBDD]">
          {isTa ? 'இரட்டைக் குறியீடு & பன்முக நுண்ணறிவு' : 'Dual Coding & Multiple Intelligences'}
        </h3>
        <p class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
          {isTa
            ? 'பாய்வியோவின் இரட்டைக் குறியீட்டுக் கோட்பாட்டின்படி, எழுத்து (Text) மற்றும் குரல் (Audio) காட்சிக் கலை வண்ணங்களுடன் இணையும் போது நீண்டகால நினைவில் பதிவாகிறது. கார்ட்னரின் மொழி, தனிநபர், பிறர்சார் மற்றும் இயற்கை நுண்ணறிவுகளைத் தூண்டுகிறது.'
            : 'Audio narration plus written text paired with distinct visual emblems optimizes working memory (Dual Coding) while nurturing linguistic, intrapersonal, interpersonal, and naturalist intelligences.'}
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 2: SCHOOL IMPLEMENTATION FRAMEWORK -->
  <section id="schools" class="space-y-6 pt-4 scroll-mt-20">
    <div class="flex items-center gap-3 border-b border-[#EEDFC8] dark:border-[#383659] pb-3">
      <div class="w-10 h-10 rounded-2xl bg-[#0F766E]/15 flex items-center justify-center text-xl text-[#0F766E]">
        🏫
      </div>
      <div>
        <h2 class="text-xl sm:text-2xl font-black text-[#3B2A1A] dark:text-[#F3EBDD]">
          {isTa ? '2. பள்ளிகளில் செயல்படுத்தும் செயல்முறை வரைவு' : '2. School Implementation & Schedule Model'}
        </h2>
        <p class="text-xs text-[#6B5644] dark:text-[#C8BFAF]">
          {isTa ? 'காலை வழிபாடு, மொழி ஆய்வகம், நூலக நேரம் மற்றும் வகுப்பறையில் ஒருங்கிணைக்கும் விதம்' : 'Integrating digital storytelling into daily routines and scholastic periods'}
        </p>
      </div>
    </div>

    <div class="overflow-x-auto rounded-3xl border border-[#EEDFC8] dark:border-[#383659] shadow-xs">
      <table class="w-full text-left border-collapse text-xs sm:text-sm">
        <thead>
          <tr class="bg-[#F8F4EE] dark:bg-[#1E1D36] text-[#3B2A1A] dark:text-[#F3EBDD] border-b border-[#EEDFC8] dark:border-[#383659]">
            <th class="p-3.5 sm:p-4 font-black">{isTa ? 'பள்ளிக் களம்' : 'Setting'}</th>
            <th class="p-3.5 sm:p-4 font-black">{isTa ? 'செயல்படுத்தும் உத்தி' : 'Application Strategy'}</th>
            <th class="p-3.5 sm:p-4 font-black">{isTa ? 'கற்றல் வெளிப்பாடு' : 'Expected Learning Outcome'}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#EEDFC8] dark:divide-[#383659] bg-white dark:bg-[#151426] text-[#6B5644] dark:text-[#C8BFAF]">
          <tr>
            <td class="p-3.5 sm:p-4 font-bold text-[#3B2A1A] dark:text-[#F3EBDD]">{isTa ? 'காலை வழிபாடு (Assembly)' : 'Morning Assembly'}</td>
            <td class="p-3.5 sm:p-4">{isTa ? '\'தினமொரு கதை\' (Story of the Day) ஒளிபரப்பப்பட்டு, ஒரு மாணவர் அதன் நீதியை விளக்குதல்.' : 'Project "Story of the Day"; student shares the moral takeaway with assembly.'}</td>
            <td class="p-3.5 sm:p-4 font-semibold text-[#0F766E] dark:text-[#2DD4BF]">{isTa ? 'மேடைப் பேச்சு, தன்னம்பிக்கை, கூட்டு விழுமியம்' : 'Public speaking poise, moral focus, assembly cohesion'}</td>
          </tr>
          <tr>
            <td class="p-3.5 sm:p-4 font-bold text-[#3B2A1A] dark:text-[#F3EBDD]">{isTa ? 'மொழி ஆய்வகம் (Language Lab)' : 'Language Lab'}</td>
            <td class="p-3.5 sm:p-4">{isTa ? 'கணினி/ஹெட்போன் வழியே தத்தமது வேகத்திற்கு ஏற்ப ஆடியோ கேட்டு வாசித்தல் (Self-paced).' : 'Students listen to synchronized audio narration while reading transcript.'}</td>
            <td class="p-3.5 sm:p-4 font-semibold text-[#0F766E] dark:text-[#2DD4BF]">{isTa ? 'கேட்டல் திறன் (Listening Comprehension), திருத்தமான உச்சரிப்பு' : 'Flawless pronunciation, phonological awareness'}</td>
          </tr>
          <tr>
            <td class="p-3.5 sm:p-4 font-bold text-[#3B2A1A] dark:text-[#F3EBDD]">{isTa ? 'நூலக நேரம் (Library Period)' : 'Library Period'}</td>
            <td class="p-3.5 sm:p-4">{isTa ? 'இரு குழுக்களாகப் பிரிந்து, விக்ரமாதித்தன் அல்லது பீர்பால் கதைகளின் முடிவில் உள்ள சிக்கல்களுக்கு வாதாடுதல்.' : 'Split into circles; debate Vikram-Vetal moral riddles or Birbal problem-solving.'}</td>
            <td class="p-3.5 sm:p-4 font-semibold text-[#0F766E] dark:text-[#2DD4BF]">{isTa ? 'விமர்சனச் சிந்தனை, தர்க்கரீதியான வாதத்திறன்' : 'Critical thinking, respectful rebuttal, dialectic logic'}</td>
          </tr>
          <tr>
            <td class="p-3.5 sm:p-4 font-bold text-[#3B2A1A] dark:text-[#F3EBDD]">{isTa ? 'மதிப்பீட்டு நேரம் (Formative Assessment)' : 'Formative Assessment'}</td>
            <td class="p-3.5 sm:p-4">{isTa ? 'கதையின் முடிவில் உள்ள வினாடி-வினா (Quiz) மூலம் உடனடித் தன்மதிப்பீடு செய்தல்.' : 'Automated story comprehension quiz with immediate rubric feedback.'}</td>
            <td class="p-3.5 sm:p-4 font-semibold text-[#0F766E] dark:text-[#2DD4BF]">{isTa ? 'கருத்துப் புரிதல் உறுதிப்பாடு, அடைவுத் திறன் பதிவு' : 'Objective retention tracking, reading comprehension metrics'}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- SECTION 3: TEACHER 5E PEDAGOGY -->
  <section id="teachers" class="space-y-6 pt-4 scroll-mt-20">
    <div class="flex items-center gap-3 border-b border-[#EEDFC8] dark:border-[#383659] pb-3">
