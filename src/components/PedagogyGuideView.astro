---
interface Props {
  currentLang: string;
}

const { currentLang } = Astro.props;
const isTa = currentLang === 'ta';
---

<div class="max-w-5xl mx-auto space-y-12">
  
  <!-- HERO BANNER -->
  <header class="text-center space-y-5 max-w-4xl mx-auto">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#D97706]/10 border border-[#D97706]/30 text-[#D97706] text-xs font-black tracking-wide uppercase">
      <span>📖</span>
      <span>{isTa ? 'Daily Tale பயனர் & கல்விக் கையேடு' : 'Daily Tale User & Educational Guide'}</span>
    </div>

    <h1 class="text-3xl sm:text-5xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD] tracking-tight leading-tight">
      {isTa ? 'தளத்தை முழுமையாகப் பயன்படுத்தும் வழிகாட்டி' : 'Complete Guide to Daily Tale Features'}
    </h1>

    <p class="text-base sm:text-lg font-bold text-[#D97706]">
      {isTa 
        ? 'இரவு உறக்கம், பயணம், வகுப்பறைக் கற்பித்தல் மற்றும் குடும்பக் கதைநேரத்திற்கான வழிகாட்டுதல்'
        : 'Continuous Bedtime Audio, Travel Narration, Classroom Learning, & Co-Reading'}
    </p>

    <p class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed max-w-3xl mx-auto">
      {isTa
        ? 'Daily Tale தளத்தின் தொடர் கதை வாசிப்பு (Bedtime Player), இரட்டைப் பயன்முறை (General vs Classroom Mode), வாசிப்பு வசதிகள் மற்றும் மாணவர்களின் மொழி-ஒழுக்க ஆளுமையை வளர்க்கும் வழிகளை எளிமையாக விளக்கும் நடைமுறைக் கையேடு.'
        : 'A practical, step-by-step handbook on utilizing our continuous audio narrator, customizable sleep timer, classroom pedagogy mode, and accessible reading tools for educators, parents, and commuters.'}
    </p>

    <!-- QUICK CALL TO ACTION: OPEN BEDTIME PLAYER -->
    <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
      <button
        type="button"
        onclick="window.DailyStoryBedtimePlayer && window.DailyStoryBedtimePlayer.open()"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-[#D97706] hover:bg-[#B45309] text-white text-xs sm:text-sm font-bold shadow-md hover:scale-102 transition-all cursor-pointer"
      >
        <span>🌙</span>
        <span>{isTa ? 'தூக்கம் & பயண ஆடியோவை இயக்கவும்' : 'Launch Bedtime & Travel Player'}</span>
      </button>

      <a
        href={`/${currentLang}/classroom/`}
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-white dark:bg-[#1E1D36] border border-[#EEDFC8] dark:border-[#383659] text-[#3B2A1A] dark:text-[#F3EBDD] hover:bg-[#FFF4E0] dark:hover:bg-[#25243E] text-xs sm:text-sm font-bold transition-all shadow-xs"
      >
        <span>🏫</span>
        <span>{isTa ? 'வகுப்பறை பயன்முறைக்கு மாறுக' : 'Explore Classroom Mode'}</span>
      </a>

      <button
        type="button"
        onclick="window.print()"
        class="inline-flex items-center gap-2 px-4 py-3 rounded-2xl bg-white dark:bg-[#1E1D36] border border-[#EEDFC8] dark:border-[#383659] text-[#3B2A1A] dark:text-[#F3EBDD] hover:bg-[#FFF4E0] dark:hover:bg-[#25243E] text-xs sm:text-sm font-bold transition-all shadow-xs"
      >
        <span>🖨️</span>
        <span>{isTa ? 'அச்சிடுக / PDF' : 'Print / Save as PDF'}</span>
      </button>
    </div>
  </header>

  <!-- QUICK NAVIGATION ANCHOR TABS -->
  <nav class="flex flex-wrap items-center justify-center gap-2 p-2 rounded-2xl bg-white dark:bg-[#1E1D36] border border-[#EEDFC8] dark:border-[#383659] shadow-xs text-xs font-bold text-[#6B5644] dark:text-[#C8BFAF]">
    <a href="#bedtime-travel" class="px-3 py-1.5 rounded-xl hover:bg-[#FFF4E0] dark:hover:bg-[#25243E] hover:text-[#D97706]">🌙 {isTa ? 'தூக்கம் & பயண வாசிப்பு' : 'Bedtime & Travel'}</a>
    <a href="#dual-mode" class="px-3 py-1.5 rounded-xl hover:bg-[#FFF4E0] dark:hover:bg-[#25243E] hover:text-[#D97706]">🔄 {isTa ? 'இரட்டைப் பயன்முறை' : 'Dual Mode'}</a>
    <a href="#parents" class="px-3 py-1.5 rounded-xl hover:bg-[#FFF4E0] dark:hover:bg-[#25243E] hover:text-[#D97706]">👨‍👩‍👧 {isTa ? 'பெற்றோர்களுக்கு' : 'For Parents'}</a>
    <a href="#teachers" class="px-3 py-1.5 rounded-xl hover:bg-[#FFF4E0] dark:hover:bg-[#25243E] hover:text-[#D97706]">👩‍🏫 {isTa ? 'ஆசிரியர்களுக்கு' : 'For Teachers'}</a>
    <a href="#students" class="px-3 py-1.5 rounded-xl hover:bg-[#FFF4E0] dark:hover:bg-[#25243E] hover:text-[#D97706]">🎒 {isTa ? 'மாணவர்களுக்கு' : 'For Students'}</a>
    <a href="#accessibility" class="px-3 py-1.5 rounded-xl hover:bg-[#FFF4E0] dark:hover:bg-[#25243E] hover:text-[#D97706]">♿ {isTa ? 'வாசிப்பு வசதிகள் (Aa)' : 'Accessibility (Aa)'}</a>
  </nav>

  <!-- SECTION 1: BEDTIME & TRAVEL CONTINUOUS AUDIO PLAYER -->
  <section id="bedtime-travel" class="space-y-6 pt-4 scroll-mt-20">
    <div class="flex items-center gap-3 border-b border-[#EEDFC8] dark:border-[#383659] pb-3">
      <div class="w-10 h-10 rounded-2xl bg-[#D97706]/15 flex items-center justify-center text-xl text-[#D97706]">
        🌙
      </div>
      <div>
        <h2 class="text-xl sm:text-2xl font-black text-[#3B2A1A] dark:text-[#F3EBDD]">
          {isTa ? '1. இரவு உறக்கம் & பயணத் தொடர் ஆடியோ வாசிப்பு' : '1. Continuous Bedtime & Travel Audio Narrator'}
        </h2>
        <p class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF]">
          {isTa ? 'குழந்தைகளைத் தூங்க வைக்கவும், பயணங்களின் போது திரையைப் பார்க்காமல் கேட்கவும் வடிவமைக்கப்பட்ட சிறப்பு வசதி' : 'Automated multi-story playback with sleep timer, ambient sounds, and selective narration'}
        </p>
      </div>
    </div>

    <!-- FEATURE GRID -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 text-xs sm:text-sm">
      
      <!-- Feature Card 1: Collection Selection -->
      <div class="p-5 rounded-2xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] space-y-3 shadow-xs">
        <div class="flex items-center gap-2 font-black text-sm text-[#D97706]">
          <span>📚</span>
          <span>{isTa ? 'கதைத் தொகுதியைத் தேர்ந்தெடுத்தல்' : 'Choose Your Story Collection'}</span>
        </div>
        <p class="text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
          {isTa
            ? 'பஞ்சதந்திரக் கதைகள், விக்கிரமாதித்தன் கதைகள், தெனாலிராமன், பீர்பால், முல்லா கதைகள், ஜாதகக் கதைகள், ஈசாப் கதைகள் உள்ளிட்ட 13 பாரம்பரியத் தொகுப்புகளில் ஏதேனும் ஒன்றையோ அல்லது "அனைத்துக் கதைகள் கலவை" என்பதையோ தெரிவு செய்யலாம்.'
            : 'Select from 13 classic world folklore traditions—Panchatantra, Vikram–Vetal, Tenali Rama, Akbar–Birbal, Mullah Nasruddin, Jataka, Aesop, Arabian Nights, or "All Collections Mixed" for endless variety.'}
        </p>
      </div>

      <!-- Feature Card 2: Duration & Sleep Timer -->
      <div class="p-5 rounded-2xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] space-y-3 shadow-xs">
        <div class="flex items-center gap-2 font-black text-sm text-[#D97706]">
          <span>⏱️</span>
          <span>{isTa ? 'நேர வரம்பு & ஸ்லீப் டைமர் (Duration Timer)' : 'Custom Duration & Auto Sleep Timer'}</span>
        </div>
        <p class="text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
          {isTa
            ? '10 நிமிடம், 15 நிமிடம், 20 நிமிடம், 30 நிமிடம், 45 நிமிடம், 1 மணிநேரம் அல்லது "தொடர்ந்து ஓடட்டும்" (Continuous) என உங்கள் விருப்பப்படி நேரத்தை அமைக்கலாம். நேரம் முடிந்ததும் ஆடியோ மென்மையான மங்கலுடன் (Soft Fade-out) தானாக நின்றுவிடும்; தூங்கும் குழந்தை விழித்துக் கொள்ளாது.'
            : 'Set playback to 10m, 15m, 20m, 30m, 45m, 60m, or continuous. When the timer expires, the audio gently fades out so sleeping children are not startled awake.'}
        </p>
      </div>

      <!-- Feature Card 3: Content Customization -->
      <div class="p-5 rounded-2xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] space-y-3 shadow-xs">
        <div class="flex items-center gap-2 font-black text-sm text-[#D97706]">
          <span>🎙️</span>
          <span>{isTa ? 'எதை வாசிக்க வேண்டும் என்பதைத் தேர்ந்தெடுத்தல்' : 'Customizable Narration Content'}</span>
        </div>
        <p class="text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
          {isTa
            ? 'இரவில் தூங்கும் போது "கதையை மட்டும்" வாசிக்கச் செய்யலாம். பகல் நேரத்திலோ அல்லது கல்விப் பயணங்களிலோ கதை முடிந்தவுடன் "நீதி/நெறி", "புதிய சொற்கள்", மற்றும் "சிந்தனை வினாக்கள்" ஆகியவற்றையும் சேர்த்து வாசிக்க விருப்பப்பெட்டிகளைத் தேர்வு செய்யலாம்.'
            : 'Toggle checkboxes for Story Text only (ideal for sleep), or append Moral / Ethical takeaway, Words to Learn (vocabulary pronunciation), and Think & Talk reflection questions.'}
        </p>
      </div>

      <!-- Feature Card 4: Soothing Background Ambience -->
      <div class="p-5 rounded-2xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] space-y-3 shadow-xs">
        <div class="flex items-center gap-2 font-black text-sm text-[#D97706]">
          <span>🌧️</span>
          <span>{isTa ? 'இயற்கை பின்னணி ஓசைகள் (Ambient Sounds)' : 'Procedural Calming Ambient Sounds'}</span>
        </div>
        <p class="text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
          {isTa
            ? 'கதையுடன் சேர்த்து கேட்க மெல்லிய மழைத் தூறல் ஒலி (Gentle Rain), இரவுப் புல்வெளியின் ரீங்கார ஒலி (Night Crickets), அமைதியான மணி ஓசை (Starlight Chimes) ஆகியவை Web Audio தொழில்நுட்பம் மூலம் ஆஃப்லைனிலும் இயங்குகின்றன.'
            : 'Built-in synthetic soundscapes (Gentle Rain, Night Crickets, Starlight Chimes) synthesized directly in-browser using Web Audio API—requires zero internet bandwidth and plays even offline.'}
        </p>
      </div>

    </div>

    <!-- HOW TO USE BEDTIME PLAYER STEP-BY-STEP -->
    <div class="p-6 rounded-2xl bg-[#FFF8EC] dark:bg-[#1E1D36] border border-[#EEDFC8] dark:border-[#383659] space-y-4">
      <h3 class="font-black text-base text-[#3B2A1A] dark:text-[#F3EBDD] flex items-center gap-2">
        <span>💡</span>
        <span>{isTa ? 'இரவு உறக்கப் பிளேயரை எவ்வாறு தொடங்குவது? (3 எளிய படிகள்)' : 'How to Launch the Bedtime Player in 3 Simple Steps'}</span>
      </h3>
      <ol class="list-decimal list-inside space-y-2 text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed pl-1">
        <li>
          <strong class="text-[#3B2A1A] dark:text-[#F3EBDD]">{isTa ? 'பிளேயரைத் திறக்கவும்:' : 'Open the Player:'}</strong> {isTa ? 'மேல் பட்டை (Header) அல்லது பக்கத்தின் வலது கீழ் மூலையில் உள்ள "🌙 தூக்கம் & பயணம்" என்ற மிதக்கும் பொத்தானைக் கிளிக் செய்யவும்.' : 'Click the "🌙 Bedtime Player" button in the top navigation bar or the floating moon button at the bottom-right.'}
        </li>
        <li>
          <strong class="text-[#3B2A1A] dark:text-[#F3EBDD]">{isTa ? 'விருப்பங்களைத் தேர்வு செய்யவும்:' : 'Configure Playback:'}</strong> {isTa ? 'உங்களுக்குப் பிடித்த கதைத் தொகுதி (எ.கா. பஞ்சதந்திரம்), கேட்க விரும்பும் நேரம் (எ.கா. 20 நிமிடம்), வாசிக்க வேண்டிய பகுதிகள் (கதை மட்டும் / நீதியுடன்) ஆகியவற்றைத் தேர்ந்தெடுக்கவும்.' : 'Select your desired story collection, duration (e.g. 20m), narration parts, and optional soothing rain ambience.'}
        </li>
        <li>
          <strong class="text-[#3B2A1A] dark:text-[#F3EBDD]">{isTa ? '"வாசிக்கத் தொடங்கு" அழுத்தவும்:' : 'Tap "Start Playing":'}</strong> {isTa ? 'தொலைபேசியை ஓரமாக வைத்துவிட்டால், ஒரு கதை முடிந்தவுடன் அடுத்த கதை தானாகவே தொடரும். அமைக்கப்பட்ட நேரம் முடிந்ததும் தானாகவே நின்றுவிடும்.' : 'Place your phone on the bedside table. One story will smoothly follow the next until your timer expires.'}
        </li>
      </ol>
    </div>
  </section>

  <!-- SECTION 2: DUAL MODE (GENERAL VS CLASSROOM) -->
  <section id="dual-mode" class="space-y-6 pt-4 scroll-mt-20">
    <div class="flex items-center gap-3 border-b border-[#EEDFC8] dark:border-[#383659] pb-3">
      <div class="w-10 h-10 rounded-2xl bg-[#0F766E]/15 flex items-center justify-center text-xl text-[#0F766E]">
        🔄
      </div>
      <div>
        <h2 class="text-xl sm:text-2xl font-black text-[#3B2A1A] dark:text-[#F3EBDD]">
          {isTa ? '2. இரட்டைப் பயன்முறை: பொதுப் பயன்முறை vs வகுப்பறைப் பயன்முறை' : '2. Dual-Mode Architecture: General vs Classroom'}
        </h2>
        <p class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF]">
          {isTa ? 'தூய வாசிப்பு இன்பத்திற்கும் ஆழமான கல்வி கற்றலுக்கும் இடையே எளிதான மாறுதல்' : 'Pure distraction-free story immersion versus deep structured pedagogical assessment'}
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 text-xs sm:text-sm">
      <!-- General Mode Box -->
      <div class="p-5 rounded-2xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] space-y-3">
        <div class="flex items-center gap-2 font-black text-sm text-[#D97706]">
          <span>📖</span>
          <span>{isTa ? 'பொதுப் பயன்முறை (General Mode)' : 'General Mode (Leisure Reading)'}</span>
        </div>
        <p class="text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
          {isTa
            ? 'இப்பயன்முறையில் கதைகள் மிக எளிய, சுத்தமான வடிவத்தில் தோன்றும். வினாடி-வினாக்கள், தேர்வுப் பெட்டிகள் போன்ற கல்விச் சுமைகள் மறைக்கப்பட்டு, குழந்தைகள் மற்றும் வாசகர்கள் கதையின் ரசனையையும் உணர்வையும் முழுமையாக அனுபவிக்க வழிவகுக்கிறது.'
            : 'Clean, distraction-free story immersion. Interactive quizzes, worksheets, and heavy educational assessment widgets are tucked away, leaving only pure narrative joy.'}
        </p>
        <div class="text-xs font-bold text-[#D97706] pt-1">
          {isTa ? '✓ தூக்க நேரம், பயணம், மாலை நேர ஓய்வு வாசிப்புக்கு உகந்தது.' : '✓ Ideal for bedtime rituals, car rides, and leisure reading.'}
        </div>
      </div>

      <!-- Classroom Mode Box -->
      <div class="p-5 rounded-2xl bg-white dark:bg-[#25243E] border border-[#0F766E]/40 dark:border-[#2DD4BF]/40 space-y-3">
        <div class="flex items-center gap-2 font-black text-sm text-[#0F766E] dark:text-[#2DD4BF]">
          <span>🏫</span>
          <span>{isTa ? 'வகுப்பறைப் பயன்முறை (Classroom Mode)' : 'Classroom Mode (Pedagogical Suite)'}</span>
        </div>
        <p class="text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
          {isTa
