---
import brandConfig from '../../config/brand.json';
import { getT } from '../lib/i18n';

interface Props {
  tip?: string;
  lang?: string;
}

const { tip, lang = 'en' } = Astro.props;
const t = getT(lang);
---

<div class="p-5 sm:p-6 rounded-3xl bg-amber-100/70 dark:bg-slate-900 border border-amber-300 dark:border-slate-800 shadow-sm flex items-center gap-4">
  <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-amber-500 flex items-center justify-center shrink-0 shadow-md">
    <span class="text-3xl sm:text-4xl">🦉</span>
  </div>
  <div>
    <div class="flex items-center gap-2 mb-1">
      <span class="font-black text-amber-950 dark:text-amber-200 text-sm sm:text-base">
        {lang === 'ta' ? 'கதா – கதை ஆந்தை' : (lang === 'hi' ? 'कथा – कहानी उल्लू' : `${brandConfig.mascot.name} ${brandConfig.mascot.title}`)}
      </span>
      <span class="px-2 py-0.5 rounded-full bg-amber-200 dark:bg-amber-950 text-amber-900 dark:text-amber-300 text-[10px] font-bold">
        {t.friendlyGuide || "Friendly Guide"}
      </span>
    </div>
    <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed italic">
      "{tip || t.mascotWelcome || 'Welcome to our reading sanctuary! Read slowly, ask curious questions, and let your imagination soar.'}"
    </p>
  </div>
</div>
