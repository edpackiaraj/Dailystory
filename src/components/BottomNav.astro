---
import { getT } from '../lib/i18n';

interface Props {
  currentLang: string;
  activeTab?: 'home' | 'stories' | 'search' | 'favourites';
}

const { currentLang, activeTab = 'home' } = Astro.props;
const t = getT(currentLang);
---

<!-- Fixed Mobile Bottom Navigation Bar (Phone: 360px - 600px) -->
<nav
  id="mobile-bottom-nav"
  aria-label="Mobile Navigation"
  class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 dark:bg-[#1B1A2E]/95 backdrop-blur-md border-t border-[#EEDFC8] dark:border-[#383659] px-2 py-1.5 shadow-lg transition-colors duration-200"
>
  <div class="max-w-md mx-auto grid grid-cols-4 items-center gap-1">
    
    <!-- Home Tab -->
    <a
      href={`/${currentLang}/`}
      class={`flex flex-col items-center justify-center min-h-[48px] py-1 rounded-xl transition-all ${
        activeTab === 'home'
          ? 'text-[#D97706] font-bold dark:text-[#F59E0B]'
          : 'text-[#6B5644] dark:text-[#C8BFAF] hover:text-[#D97706]'
      }`}
      aria-current={activeTab === 'home' ? 'page' : undefined}
    >
      <span class="text-xl leading-none">🏠</span>
      <span class="text-[11px] font-medium tracking-tight mt-1">{t.home}</span>
    </a>

    <!-- Stories / Collections Tab -->
    <a
      href={`/${currentLang}/collections/`}
      class={`flex flex-col items-center justify-center min-h-[48px] py-1 rounded-xl transition-all ${
        activeTab === 'stories'
          ? 'text-[#D97706] font-bold dark:text-[#F59E0B]'
          : 'text-[#6B5644] dark:text-[#C8BFAF] hover:text-[#D97706]'
      }`}
      aria-current={activeTab === 'stories' ? 'page' : undefined}
    >
      <span class="text-xl leading-none">📚</span>
      <span class="text-[11px] font-medium tracking-tight mt-1">{t.stories}</span>
    </a>

    <!-- Search Tab -->
    <a
      href={`/${currentLang}/search/`}
      class={`flex flex-col items-center justify-center min-h-[48px] py-1 rounded-xl transition-all ${
        activeTab === 'search'
          ? 'text-[#D97706] font-bold dark:text-[#F59E0B]'
          : 'text-[#6B5644] dark:text-[#C8BFAF] hover:text-[#D97706]'
      }`}
      aria-current={activeTab === 'search' ? 'page' : undefined}
    >
      <span class="text-xl leading-none">🔍</span>
      <span class="text-[11px] font-medium tracking-tight mt-1">{t.search}</span>
    </a>

    <!-- Favourites Tab -->
    <a
      href={`/${currentLang}/favourites/`}
      class={`flex flex-col items-center justify-center min-h-[48px] py-1 rounded-xl transition-all ${
        activeTab === 'favourites'
          ? 'text-[#D97706] font-bold dark:text-[#F59E0B]'
          : 'text-[#6B5644] dark:text-[#C8BFAF] hover:text-[#D97706]'
      }`}
      aria-current={activeTab === 'favourites' ? 'page' : undefined}
    >
      <span class="text-xl leading-none">⭐</span>
      <span class="text-[11px] font-medium tracking-tight mt-1">{t.favourites}</span>
    </a>

  </div>
</nav>

<!-- Padding helper to prevent page content from being hidden behind fixed bottom bar on phone -->
<div class="md:hidden h-16 w-full" aria-hidden="true"></div>
