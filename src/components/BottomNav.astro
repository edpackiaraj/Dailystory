---
interface Props {
  currentLang: string;
  activeTab?: 'home' | 'stories' | 'classroom' | 'favourites';
}

const { currentLang, activeTab = 'home' } = Astro.props;
---

<!-- Fixed Mobile Bottom Navigation Bar (Phone: 360px - 600px) -->
<nav
  id="mobile-bottom-nav"
  aria-label="Mobile Navigation"
  class="lg:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 dark:bg-[#151426]/95 backdrop-blur-md border-t border-[#EEDFC8]/80 dark:border-[#383659]/80 px-2 py-1.5 shadow-lg transition-colors duration-200"
>
  <div class="max-w-md mx-auto grid grid-cols-4 items-center gap-1 text-center">
    
    <!-- Today Tab -->
    <a
      href={`/${currentLang}/`}
      class={`flex flex-col items-center justify-center min-h-[48px] py-1 rounded-xl transition-all ${
        activeTab === 'home'
          ? 'text-[#D97706] font-bold dark:text-[#F59E0B]'
          : 'text-[#6B5644] dark:text-[#C8BFAF] hover:text-[#D97706]'
      }`}
      aria-current={activeTab === 'home' ? 'page' : undefined}
    >
      <span class="text-lg leading-none">📖</span>
      <span class="text-[11px] font-semibold tracking-tight mt-1">Today</span>
    </a>

    <!-- Stories Tab (replaces Search) -->
    <a
      href={`/${currentLang}/collections/`}
      class={`flex flex-col items-center justify-center min-h-[48px] py-1 rounded-xl transition-all ${
        activeTab === 'stories'
          ? 'text-[#D97706] font-bold dark:text-[#F59E0B]'
          : 'text-[#6B5644] dark:text-[#C8BFAF] hover:text-[#D97706]'
      }`}
      aria-current={activeTab === 'stories' ? 'page' : undefined}
    >
      <span class="text-lg leading-none">📚</span>
      <span class="text-[11px] font-semibold tracking-tight mt-1">Stories</span>
    </a>

    <!-- Classroom Tab -->
    <a
      href={`/${currentLang}/classroom/`}
      class={`flex flex-col items-center justify-center min-h-[48px] py-1 rounded-xl transition-all ${
        activeTab === 'classroom'
          ? 'text-[#D97706] font-bold dark:text-[#F59E0B]'
          : 'text-[#6B5644] dark:text-[#C8BFAF] hover:text-[#D97706]'
      }`}
      aria-current={activeTab === 'classroom' ? 'page' : undefined}
    >
      <span class="text-lg leading-none">🎓</span>
      <span class="text-[11px] font-semibold tracking-tight mt-1">Classroom</span>
    </a>

    <!-- Favorites Tab -->
    <a
      href={`/${currentLang}/favourites/`}
      class={`flex flex-col items-center justify-center min-h-[48px] py-1 rounded-xl transition-all ${
        activeTab === 'favourites'
          ? 'text-[#D97706] font-bold dark:text-[#F59E0B]'
          : 'text-[#6B5644] dark:text-[#C8BFAF] hover:text-[#D97706]'
      }`}
      aria-current={activeTab === 'favourites' ? 'page' : undefined}
    >
      <span class="text-lg leading-none">⭐</span>
      <span class="text-[11px] font-semibold tracking-tight mt-1">Favorites</span>
    </a>

  </div>
</nav>

<!-- Padding helper to prevent page content from being hidden behind fixed bottom bar on phone -->
<div class="lg:hidden h-16 w-full" aria-hidden="true"></div>
