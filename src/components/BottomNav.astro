---
import { getT } from '../lib/i18n';

interface Props {
  currentLang: string;
  activeTab?: 'home' | 'stories' | 'classroom' | 'favourites';
}

const { currentLang, activeTab = 'home' } = Astro.props;
const t = getT(currentLang);

const navLabels: Record<string, { today: string; stories: string; classroom: string; favorites: string }> = {
  ta: { today: 'இன்று', stories: 'கதைகள்', classroom: 'வகுப்பறை', favorites: 'விருப்பங்கள்' },
  hi: { today: 'आज', stories: 'कहानियाँ', classroom: 'कक्षा', favorites: 'पसंदीदा' },
  te: { today: 'ఈరోజు', stories: 'కథలు', classroom: 'తరగతి గది', favorites: 'ఇష్టమైనవి' },
  kn: { today: 'ಇಂದು', stories: 'ಕಥೆಗಳು', classroom: 'ತರಗತಿ ಕೊಠಡಿ', favorites: 'ಮೆಚ್ಚಿನವುಗಳು' },
  ml: { today: 'ഇന്ന്', stories: 'കഥകൾ', classroom: 'ക്ലാസ് റൂം', favorites: 'പ്രിയപ്പെട്ടവ' },
  mr: { today: 'आज', stories: 'गोष्टी', classroom: 'वर्गखोली', favorites: 'आवडीचे' },
  zh: { today: '今日', stories: '故事集', classroom: '课堂', favorites: '收藏' },
  ur: { today: 'آج', stories: 'کہانیاں', classroom: 'کلاس روم', favorites: 'پسندیدہ' },
  en: { today: 'Today', stories: 'Stories', classroom: 'Classroom', favorites: 'Favorites' }
};

const labels = navLabels[currentLang] || navLabels.en;
---

<!-- Fixed Mobile Bottom Navigation Bar (Phone: 360px - 600px) -->
<nav
  id="mobile-bottom-nav"
  aria-label="Mobile Navigation"
  class="lg:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 dark:bg-[#151426]/95 backdrop-blur-md border-t border-[#EEDFC8]/80 dark:border-[#383659]/80 px-2 py-1.5 shadow-lg transition-colors duration-200"
>
  <div class="max-w-md mx-auto grid grid-cols-4 items-center gap-1 text-center">
    
    <!-- Today Tab -->
    <a
      href={`/${currentLang}/`}
      class={`flex flex-col items-center justify-center min-h-[48px] py-1 rounded-xl transition-all ${
        activeTab === 'home'
          ? 'text-[#D97706] font-bold dark:text-[#F59E0B]'
          : 'text-[#6B5644] dark:text-[#C8BFAF] hover:text-[#D97706]'
      }`}
      aria-current={activeTab === 'home' ? 'page' : undefined}
    >
      <span class="text-lg leading-none">📖</span>
      <span class="text-[11px] font-semibold tracking-tight mt-1">{labels.today}</span>
    </a>

    <!-- Stories Tab (replaces Search) -->
    <a
      href={`/${currentLang}/collections/`}
      class={`flex flex-col items-center justify-center min-h-[48px] py-1 rounded-xl transition-all ${
        activeTab === 'stories'
          ? 'text-[#D97706] font-bold dark:text-[#F59E0B]'
          : 'text-[#6B5644] dark:text-[#C8BFAF] hover:text-[#D97706]'
      }`}
      aria-current={activeTab === 'stories' ? 'page' : undefined}
    >
      <span class="text-lg leading-none">📚</span>
      <span class="text-[11px] font-semibold tracking-tight mt-1">{labels.stories}</span>
    </a>

    <!-- Classroom Tab -->
    <a
      href={`/${currentLang}/classroom/`}
      class={`flex flex-col items-center justify-center min-h-[48px] py-1 rounded-xl transition-all ${
        activeTab === 'classroom'
          ? 'text-[#D97706] font-bold dark:text-[#F59E0B]'
          : 'text-[#6B5644] dark:text-[#C8BFAF] hover:text-[#D97706]'
      }`}
      aria-current={activeTab === 'classroom' ? 'page' : undefined}
    >
      <span class="text-lg leading-none">🎓</span>
      <span class="text-[11px] font-semibold tracking-tight mt-1">{labels.classroom}</span>
    </a>

    <!-- Favorites Tab -->
    <a
      href={`/${currentLang}/favorites/`}
      class={`flex flex-col items-center justify-center min-h-[48px] py-1 rounded-xl transition-all ${
        activeTab === 'favourites'
          ? 'text-[#D97706] font-bold dark:text-[#F59E0B]'
          : 'text-[#6B5644] dark:text-[#C8BFAF] hover:text-[#D97706]'
      }`}
      aria-current={activeTab === 'favourites' ? 'page' : undefined}
    >
      <span class="text-lg leading-none">⭐</span>
      <span class="text-[11px] font-semibold tracking-tight mt-1">{labels.favorites}</span>
    </a>

  </div>
</nav>

<!-- Padding helper to prevent page content from being hidden behind fixed bottom bar on phone -->
<div class="lg:hidden h-16 w-full" aria-hidden="true"></div>
