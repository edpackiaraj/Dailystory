---
interface Props {
  currentLang: string;
}

const { currentLang } = Astro.props;
const isTa = currentLang === 'ta';
---

<div class="max-w-5xl mx-auto space-y-12">
  <!-- Hero Header -->
  <header class="text-center space-y-4 max-w-3xl mx-auto">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#D97706]/10 text-[#D97706] text-xs font-black tracking-wide uppercase">
      <span>📬</span> {isTa ? 'நேரடித் தொடர்பு & கல்வி ஒத்துழைப்பு' : 'Direct Communication & Collaboration'}
    </div>
    <h1 class="text-3xl sm:text-5xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD] tracking-tight leading-tight">
      {isTa ? 'எஸ். எட்வர்ட் பாக்கியராஜ் & Daily Tale ஆசிரியர் குழுவைத் தொடர்பு கொள்ள' : 'Get in Touch with Dr. S. Edward Packiaraj & Daily Tale'}
    </h1>
    <p class="text-sm sm:text-base text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
      {isTa
        ? 'வகுப்பறைப் பாட வளங்களைத் தேடும் ஆசிரியர்கள், பண்பாட்டு வழக்காறுகளைப் பகிர்ந்துகொள்ளும் பெற்றோர்கள், ஆய்வாளர்கள் அல்லது கல்வி ஊடகத் திட்டங்களில் இணைந்திருக்க விரும்புவோர் என அனைவரது கருத்துகளையும் மனதார வரவேற்கிறோம்.'
        : 'Whether you are an educator seeking classroom materials, a parent sharing feedback, an academic researcher, or exploring partnerships with our educational media initiatives — we welcome your message with open arms.'}
    </p>
  </header>

  <!-- SECTION: About the Founder Spotlight Card -->
  <section id="about-the-founder" class="relative overflow-hidden rounded-3xl bg-linear-to-br from-[#FFF8EC] via-white to-[#FDF4E7] dark:from-[#25243E] dark:via-[#1E1D36] dark:to-[#17162B] border-2 border-[#EEDFC8] dark:border-[#383659] p-6 sm:p-10 shadow-lg space-y-6">
    <div class="flex flex-col md:flex-row items-center md:items-start gap-6 sm:gap-8">
      <!-- Avatar / Icon badge -->
      <div class="shrink-0 flex flex-col items-center text-center space-y-3">
        <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-3xl bg-linear-to-br from-[#D97706] to-[#B45309] text-white flex items-center justify-center text-4xl sm:text-5xl shadow-md border-4 border-white dark:border-[#25243E]">
          🎓
        </div>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 font-bold text-xs">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Active Responder
        </span>
      </div>

      <!-- Founder Bio & Direction -->
      <div class="space-y-4 text-center md:text-left flex-1">
        <div>
          <div class="text-xs font-bold text-[#D97706] tracking-wider uppercase">
            {isTa ? 'நிறுவனர் & கல்விக் கட்டமைப்பாளர்' : 'Founder & Educational Architect'}
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-[#3B2A1A] dark:text-[#F3EBDD] mt-0.5">
            {isTa ? 'நிறுவனர் பற்றி — ' : 'About the Founder — '}
            <a href="https://edwardpackiaraj.blogspot.com/" target="_blank" rel="noopener noreferrer" class="hover:text-[#D97706] underline decoration-[#D97706]/50">
              {isTa ? 'எஸ். எட்வர்ட் பாக்கியராஜ்' : 'Edward Packiaraj'}
            </a>
          </h2>
          <p class="text-xs sm:text-sm font-semibold text-[#0F766E] dark:text-[#2DD4BF] mt-1">
            (M.Com., M.Phil., B.Ed., BLIS., PGDBA., PGDCA.)
          </p>
          <p class="text-xs sm:text-sm font-bold text-[#3B2A1A] dark:text-[#F3EBDD] mt-0.5">
            {isTa
              ? 'கல்வி ஊடகத் தொழில்நுட்ப ஆலோசகர், ரோசரி இ-சொல்யூஷன்ஸ், திருச்சி'
              : 'Consultant – Educational Media Technologies, Rosary e-Solutions, Trichy'}
          </p>
        </div>

        {isTa ? (
          <div class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed space-y-3">
            <p>
              கல்வித் தொழில்நுட்பம், திரைக்கதை எழுதுதல், கற்பித்தல் ஆடியோ உருவாக்கம் மற்றும் எண்ணிமப் பாடத்திட்ட வடிவமைப்பில் இருபது ஆண்டுகளுக்கும் மேலான அனுபவத்துடன், பல்வேறு பின்னணிகளைக் கொண்ட கற்போருக்கும் உயர்தரக் கல்வி வளங்களையும் எண்ணிமக் கருவிகளையும் கொண்டு சேர்ப்பதில் <strong>எட்வர்ட் பாக்கியராஜ்</strong> அர்ப்பணிப்புடன் செயல்பட்டு வருகிறார்.
            </p>
            <p>
              அவரது தொழில்முறைப் பயணத்தில் <strong>அகில இந்திய வானொலி (AIR)</strong>, <strong>இந்திரா காந்தி தேசிய திறந்தநிலை பல்கலைக்கழகத்தின் ஞானவாணி எஃப்எம் (IGNOU GyanVani FM)</strong>, மற்றும் <strong>பாரதிதாசன் பல்கலைக்கழகத்தின் கல்வித் தொழில்நுட்பத் துறை</strong> ஆகியவற்றின் வாயிலாக ஆற்றிய வானொலி ஒலிபரப்பு மற்றும் கல்வி ஊடகப் பங்களிப்புகள் அடங்கும். இத்தகைய பன்முக அனுபவத்தின் அடிப்படையில், தகவல் தொடர்பு, கற்பித்தல் வடிவமைப்பு மற்றும் வளர்ந்து வரும் தொழில்நுட்பங்களை இணைத்து ஆழமான மற்றும் ஈர்க்கக்கூடிய கற்றல் அனுபவங்களை உருவாக்குகிறார்.
            </p>
            <p>
              ஒரு சுயாதீனப் படைப்பாளராகவும் மென்பொருள் உருவாக்குநராகவும், மக்கள் எளிதாகக் கற்கவும், படைக்கவும், பணியாற்றவும் உதவும் <strong>இலவச எண்ணிமக் கருவிகளையும் வலைத்தளப் பயன்பாடுகளையும்</strong> அவர் வடிவமைத்து வழங்கி வருகிறார். தொழில்நுட்பத் தடைகளைக் குறைத்து, அனைவருக்கும் பயனுள்ள எண்ணிம வளங்கள் இலவசமாகக் கிடைப்பதை உறுதி செய்வதே இவரது முக்கிய நோக்கமாகும்.
            </p>
            <p>
              <strong>திறந்த கல்வி வளங்களின் (OER - Open Educational Resources)</strong> தீவிர ஆதரவாளரான எட்வர்ட், கல்வியை மறுசீரமைக்கவும் அறிவுக்கான வாய்ப்புகளை விரிவாக்கவும் <strong>செயற்கை நுண்ணறிவு (AI), மின்-கற்றல் (e-learning) மற்றும் எண்ணிம உள்ளடக்க உருவாக்கம்</strong> ஆகியவற்றைப் பயன்படுத்துவதில் மிகுந்த ஆர்வம் கொண்டவர்.
            </p>
            <p>
              கட்டணச் சுவர்கள், சந்தாக் கட்டணங்கள் அல்லது பயனர்களின் தரவைக் கண்காணிக்கும் நிரல்கள் ஏதுமின்றி, அனைவரையும் உள்ளடக்கிய, மாணவர் மைய எண்ணிம கற்றல் சூழல்களையும் இலவசக் கருவிகளையும் உருவாக்குவதே இவரது தொலைநோக்குப் பார்வையாகும்.
            </p>
            <p>
              தமது அரிய பணிகளின் வாயிலாக, தரமான கல்வியும் பயனுள்ள தொழில்நுட்பமும் திறந்ததாகவும், எளிதில் அணுகக்கூடியதாகவும், சுவாரஸ்யமானதாகவும், அனைவருக்கும் கிடைக்கக்கூடியதாகவும் இருக்க வேண்டும் என்ற உயரிய இலட்சியத்தை அவர் தொடர்ந்து முன்னெடுத்து வருகிறார்.
            </p>
          </div>
        ) : (
          <div class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed space-y-3">
            <p>
              With over two decades of experience in educational technology, scriptwriting, instructional audio production, and digital curriculum development, <strong>Edward Packiaraj</strong> is dedicated to making quality educational resources and digital tools accessible to learners from diverse backgrounds.
            </p>
            <p>
              His professional journey includes broadcasting and educational media contributions with <strong>All India Radio (AIR)</strong>, <strong>IGNOU GyanVani FM</strong>, and the <strong>Department of Educational Technology at Bharathidasan University</strong>. Drawing on this multidisciplinary experience, he combines communication, instructional design, and emerging technologies to create meaningful and engaging learning experiences.
            </p>
            <p>
              As an independent creator and developer, he also designs and develops <strong>free digital tools and web-based utilities</strong> that help people learn, create, and work more effectively. His focus is on building practical, accessible solutions that reduce barriers to technology and make useful digital resources available to everyone.
            </p>
            <p>
              A strong advocate of <strong>Open Educational Resources (OER)</strong>, Edward is passionate about harnessing <strong>Artificial Intelligence, e-learning, and digital content development</strong> to transform education and expand access to knowledge.
            </p>
            <p>
              His vision is to build inclusive, learner-centred digital learning environments and freely accessible tools—without paywalls, subscription fees, or intrusive data tracking.
            </p>
            <p>
              Through his work, he continues to champion the idea that quality education and useful technology should be open, accessible, engaging, and available to all.
            </p>
          </div>
        )}

        <!-- Founder Quick Badges & Profile Link -->
        <div class="flex flex-wrap items-center justify-center md:justify-start gap-2 pt-2 text-xs">
          <span class="px-3 py-1 rounded-xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] text-[#3B2A1A] dark:text-[#F3EBDD] font-medium">
            📍 Tamil Nadu, India
          </span>
          <span class="px-3 py-1 rounded-xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] text-[#3B2A1A] dark:text-[#F3EBDD] font-medium">
            📻 22+ Yrs Educational Media
          </span>
          <span class="px-3 py-1 rounded-xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] text-[#3B2A1A] dark:text-[#F3EBDD] font-medium">
            🌐 10-Language OER Ecosystem
          </span>
          <a
            href="https://edwardpackiaraj.blogspot.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3.5 py-1 rounded-xl bg-[#D97706] hover:bg-[#B45309] text-white font-bold transition-all inline-flex items-center gap-1"
          >
            <span>{isTa ? 'முழு விவரக்குறிப்பு & வலைப்பதிவு' : 'Full Blog & Portfolio'}</span>
            <span>↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Contact Action Cards (3-column grid) -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    <!-- Direct Email Card -->
    <div class="p-6 rounded-3xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] shadow-sm flex flex-col justify-between hover:border-[#D97706] hover:shadow-md transition-all">
      <div class="space-y-3">
        <div class="w-12 h-12 rounded-2xl bg-[#D97706]/15 flex items-center justify-center text-2xl text-[#D97706]">
          ✉️
        </div>
        <h3 class="font-black text-lg text-[#3B2A1A] dark:text-[#F3EBDD]">
          {isTa ? 'மின்னஞ்சல்' : 'Direct Email'}
        </h3>
        <p class="text-xs text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
          {isTa
            ? 'ஆராய்ச்சி விசாரணைகள், பள்ளி வகுப்பறைத் திட்டங்கள், உள்ளடக்கப் பரிந்துரைகள் அல்லது நேர்காணல்களுக்கு.'
            : 'For research inquiries, school collaborations, content suggestions, or media interviews.'}
        </p>
        <div class="font-mono text-sm font-bold text-[#D97706] break-all">
          edpackiaraj@gmail.com
        </div>
      </div>
      <div class="pt-5 mt-4 border-t border-[#EEDFC8]/60 dark:border-[#383659]/60">
        <a
          href="mailto:edpackiaraj@gmail.com?subject=Inquiry%20from%20Daily%20Tale%20Reader"
          class="inline-flex items-center justify-center w-full py-2.5 px-4 rounded-xl bg-[#D97706] text-white font-bold text-xs shadow hover:bg-[#B45309] transition-all"
        >
          {isTa ? 'மின்னஞ்சல் அனுப்புக →' : 'Send Direct Email →'}
        </a>
      </div>
    </div>

    <!-- WhatsApp & Phone Card -->
    <div class="p-6 rounded-3xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] shadow-sm flex flex-col justify-between hover:border-emerald-500 hover:shadow-md transition-all">
      <div class="space-y-3">
        <div class="w-12 h-12 rounded-2xl bg-emerald-500/15 flex items-center justify-center text-2xl text-emerald-600">
          💬
        </div>
        <h3 class="font-black text-lg text-[#3B2A1A] dark:text-[#F3EBDD]">
          {isTa ? 'வாட்ஸ்அப் & தொலைபேசி' : 'WhatsApp & Phone'}
        </h3>
        <p class="text-xs text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
          {isTa
            ? 'ஆசிரியர்கள் மற்றும் கல்வியாளர்களுக்கான உடனடி செய்தித் தொடர்பு. திங்கள்–சனி (IST).'
            : 'Instant messaging for teachers, educators, and rapid academic queries. Mon–Sat (IST).'}
        </p>
        <div class="font-mono text-sm font-bold text-emerald-700 dark:text-emerald-400">
          +91 9786424927
        </div>
      </div>
      <div class="pt-5 mt-4 border-t border-[#EEDFC8]/60 dark:border-[#383659]/60 flex gap-2">
        <a
          href="https://wa.me/919786424927?text=Hello%20Dr.%20Edward%2C%20I%20am%20reaching%20out%20via%20Daily%20Tale"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center flex-1 py-2.5 px-3 rounded-xl bg-emerald-600 text-white font-bold text-xs shadow hover:bg-emerald-700 transition-all"
        >
          WhatsApp ↗
        </a>
        <a
          href="tel:+919786424927"
          class="inline-flex items-center justify-center px-4 py-2.5 rounded-xl border border-emerald-600 text-emerald-700 dark:text-emerald-400 font-bold text-xs hover:bg-emerald-50 dark:hover:bg-[#1E1D36] transition-all"
        >
          {isTa ? 'அழைப்பு' : 'Call'}
        </a>
      </div>
    </div>

    <!-- Turnaround & Grievance Card -->
    <div class="p-6 rounded-3xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] shadow-sm flex flex-col justify-between hover:border-[#0F766E] hover:shadow-md transition-all">
      <div class="space-y-3">
        <div class="w-12 h-12 rounded-2xl bg-[#0F766E]/15 flex items-center justify-center text-2xl text-[#0F766E]">
          🛡️
        </div>
        <h3 class="font-black text-lg text-[#3B2A1A] dark:text-[#F3EBDD]">
          {isTa ? 'சட்டரீதியான குறைதீர்ப்பு' : 'Statutory Grievance'}
        </h3>
        <p class="text-xs text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
          {isTa
            ? 'குழந்தைகள் பாதுகாப்பு, பதிப்புரிமைக் கேள்விகள் மற்றும் தரவுப் பாதுகாப்புக்கான சிறப்புப் பிரிவு.'
            : 'Dedicated desk for child safety, copyright remarks, content verification, and data queries.'}
        </p>
        <div class="text-xs text-[#0F766E] dark:text-[#2DD4BF] font-semibold space-y-1">
          <div>⚡ {isTa ? 'பதில் காலம்: 24 முதல் 48 மணி நேரம்' : 'Turnaround: 24 to 48 hours'}</div>
          <div>👤 {isTa ? 'அதிகாரி: முனைவர் எஸ். எட்வர்ட் பாக்கியராஜ்' : 'Officer: Dr. S. Edward Packiaraj'}</div>
        </div>
      </div>
      <div class="pt-5 mt-4 border-t border-[#EEDFC8]/60 dark:border-[#383659]/60">
        <a
          href="mailto:edpackiaraj@gmail.com?subject=Statutory%20Grievance%20Notice%20-%20Daily%20Tale"
          class="inline-flex items-center justify-center w-full py-2.5 px-4 rounded-xl border border-[#0F766E] text-[#0F766E] dark:text-[#2DD4BF] font-bold text-xs hover:bg-[#0F766E]/10 transition-all"
        >
          {isTa ? 'புகார் மனு அனுப்புக →' : 'File Grievance Notice →'}
        </a>
      </div>
    </div>
  </div>

  <!-- Educational Ecosystem / Sister Projects Showcase -->
  <div class="space-y-6 pt-4">
    <div class="text-center space-y-2">
      <span class="text-xs font-black uppercase tracking-wider text-[#D97706]">
        {isTa ? 'எமது திறந்த கல்விச் சூழலியல்' : 'Our Open Educational Ecosystem'}
