      </div>
      <div class="text-[11px] text-[#8C7662] dark:text-[#A89F91] font-medium">
        {texts.lifetimeSub}
      </div>
    </div>

  </div>

</div>

<!-- Client-side Live Counter Controller -->
<script is:inline>
(function setupLiveHitCounter() {
  const STORAGE_KEY = 'dth_hit_metrics_v5';
  const SESSION_KEY = 'dth_session_id';

  // Purge any legacy inflated test data from previous builds
  try {
    localStorage.removeItem('dth_hit_metrics_v3');
    localStorage.removeItem('dth_hit_metrics_v2');
    localStorage.removeItem('dailytale_hits');
  } catch (e) {}

  // Session ID for anonymous edge active ping
  let sessionId = '';
  try {
    sessionId = sessionStorage.getItem(SESSION_KEY) || '';
    if (!sessionId) {
      sessionId = 'dt_' + Math.random().toString(36).slice(2, 9) + Date.now().toString(36);
      sessionStorage.setItem(SESSION_KEY, sessionId);
    }
  } catch (e) {
    sessionId = 'dt_local_' + Math.random().toString(36).slice(2, 9);
  }

  // DOM Elements
  const elLive = document.getElementById('hit-count-live');
  const elToday = document.getElementById('hit-count-today');
  const elWeek = document.getElementById('hit-count-week');
  const elMonth = document.getElementById('hit-count-month');
  const elYear = document.getElementById('hit-count-year');
  const elLifetime = document.getElementById('hit-count-lifetime');

  // Secondary badges in footer or header if present
  const secondaryCounters = document.querySelectorAll('[data-sync-hit]');

  function updateDom(metrics, animate) {
    if (!metrics) return;

    function applyValue(el, val) {
      if (!el) return;
      const formatted = Number(val || 1).toLocaleString();
      if (el.textContent !== formatted) {
        el.textContent = formatted;
        if (animate) {
          el.classList.add('scale-105', 'text-amber-500');
          setTimeout(function() {
            el.classList.remove('scale-105', 'text-amber-500');
          }, 350);
        }
      }
    }

    applyValue(elLive, metrics.live);
    applyValue(elToday, metrics.today);
    applyValue(elWeek, metrics.week);
    applyValue(elMonth, metrics.month);
    applyValue(elYear, metrics.year);
    applyValue(elLifetime, metrics.lifetime);

    // Sync any secondary badges on the page (like bottom footer bar)
    secondaryCounters.forEach(function(badge) {
      const type = badge.getAttribute('data-sync-hit');
      if (type === 'live') {
        badge.textContent = Number(metrics.live || 1).toLocaleString();
      } else if (type === 'lifetime') {
        badge.textContent = Number(metrics.lifetime || 1).toLocaleString();
      } else if (type === 'today') {
        badge.textContent = Number(metrics.today || 1).toLocaleString();
      }
    });

    // Also update legacy site-hit-counter if present
    const legacyEl = document.getElementById('site-hit-counter');
    if (legacyEl) {
      legacyEl.textContent = Number(metrics.lifetime || 1).toLocaleString();
    }
  }

  // Load existing cache immediately for instant zero-flicker display
  function getCachedMetrics() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) return JSON.parse(raw);
    } catch(e) {}
    return null;
  }

  function saveCachedMetrics(data) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    } catch(e) {}
  }

  // Genuine count progression for recently launched site
  function calculateLocalFallback() {
    const now = new Date();
    const todayStr = now.toISOString().slice(0, 10);
    let cached = getCachedMetrics() || {};

    if (cached.todayStr !== todayStr) {
      cached.todayStr = todayStr;
      cached.today = 1;
    } else {
      cached.today = (cached.today || 0) + 1;
    }

    const lifetime = (cached.lifetime || 0) + 1;
    const today = cached.today;
    const week = (cached.week || 0) + 1;
    const month = (cached.month || 0) + 1;
    const year = (cached.year || 0) + 1;
    const live = 1;

    const metrics = { live, today, week, month, year, lifetime, todayStr };
    saveCachedMetrics(metrics);
    return metrics;
  }

  // Step 1: Render cached metrics or clean starting count immediately
  const initialCache = getCachedMetrics();
  if (initialCache) {
    updateDom(initialCache, false);
  } else {
    updateDom(calculateLocalFallback(), false);
  }

  // Step 2: Record page hit with Edge API
  const pageKey = window.location.pathname.replace(/\/+$/, '') || 'home';

  function fetchStats(action) {
    const apiUrl = '/api/hits?action=' + encodeURIComponent(action) +
      '&page=' + encodeURIComponent(pageKey) +
      '&clientId=' + encodeURIComponent(sessionId);

    return fetch(apiUrl, {
      method: 'GET',
      headers: { 'Accept': 'application/json' },
      cache: 'no-store'
    })
    .then(function(res) {
      if (!res.ok) throw new Error('HTTP ' + res.status);
      return res.json();
    })
    .then(function(data) {
      if (data && data.success) {
        const metrics = {
          live: Math.max(1, data.live || 1),
          today: Math.max(1, data.today || 1),
          week: Math.max(1, data.week || data.today || 1),
          month: Math.max(1, data.month || data.today || 1),
          year: Math.max(1, data.year || data.today || 1),
          lifetime: Math.max(1, data.lifetime || data.count || data.today || 1),
          todayStr: new Date().toISOString().slice(0, 10)
        };
        saveCachedMetrics(metrics);
        updateDom(metrics, true);
        return metrics;
      } else {
        throw new Error('Invalid response');
      }
    })
    .catch(function(err) {
      // Offline or dev mode fallback
      const local = calculateLocalFallback();
      updateDom(local, true);
      return local;
    });
  }

  // Initial hit recording
  fetchStats('hit');

  // Step 3: Periodic Live Heartbeat Ping (keeps "Live" count real-time and active)
  let pingInterval = setInterval(function() {
    if (document.hidden) return;
    fetchStats('ping').catch(function() {});
  }, 18000);

  // When user returns to tab, refresh stats immediately
  document.addEventListener('visibilitychange', function() {
    if (!document.hidden) {
      fetchStats('ping');
    }
  });

})();
</script>