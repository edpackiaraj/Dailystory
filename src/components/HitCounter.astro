        </div>
      </div>
      <div class="text-[11px] text-[#8C7662] dark:text-[#A89F91] font-medium">
        {texts.liveSub}
      </div>
    </div>

    <!-- 2. TODAY -->
    <div class="group flex flex-col justify-between p-4 rounded-2xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] hover:border-[#D97706] dark:hover:border-[#F59E0B] shadow-2xs hover:shadow-md transition-all duration-200">
