        {texts.subtitle}
      </p>
    </div>

    <!-- Privacy & Verification Badge -->
    <div class="shrink-0 flex items-center gap-2 text-[11px] text-[#8C7662] dark:text-[#A89F91]">
      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-xl bg-white/80 dark:bg-[#2A2946]/80 border border-[#EEDFC8] dark:border-[#383659] font-medium">
        <span>🛡️</span> Zero Cookies
      </span>
      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-xl bg-white/80 dark:bg-[#2A2946]/80 border border-[#EEDFC8] dark:border-[#383659] font-medium">
        <span>⚡</span> Edge Synced
      </span>
    </div>
  </div>

  <!-- 6 Metrics Responsive Grid: Live, Today, This Week, This Month, This Year, Lifetime -->
