      </div>
    </div>

    <!-- 5. THIS YEAR -->
    <div class="group flex flex-col justify-between p-4 rounded-2xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] hover:border-teal-400 dark:hover:border-teal-500 shadow-2xs hover:shadow-md transition-all duration-200">
