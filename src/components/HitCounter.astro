        <span class="text-xs font-bold text-emerald-700 dark:text-emerald-400 uppercase tracking-wider">
          {texts.live}
        </span>
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
      </div>
      <div class="my-2">
        <div id="hit-count-live" class="text-2xl sm:text-3xl font-black font-mono tracking-tight text-emerald-600 dark:text-emerald-400 transition-all duration-300">
