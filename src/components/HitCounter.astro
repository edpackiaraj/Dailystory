<div id="global-hit-counter-section" class="my-8 rounded-3xl bg-linear-to-b from-[#FFFDF9] to-[#FFF5E5] dark:from-[#201F35] dark:to-[#171628] border-2 border-[#EEDFC8] dark:border-[#383659] p-5 sm:p-7 shadow-sm transition-all duration-300">
  
