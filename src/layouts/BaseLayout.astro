---
import brandConfig from '../../config/brand.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import AaPanel from '../components/AaPanel.astro';
import LanguageModal from '../components/LanguageModal.astro';
import { getLanguageMeta } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  keywords?: string | string[];
  lang?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  articleMeta?: {
    publishDate?: string;
    author?: string;
    tags?: string[];
    genre?: string;
    ageGroup?: string;
    readingTime?: string;
  };
  storyId?: string;
  jsonLd?: Record<string, any>[];
  noindex?: boolean;
  activeNavTab?: 'home' | 'stories' | 'search' | 'favourites';
}

const {
  title,
  description,
  keywords,
  lang = 'en',
  canonicalUrl,
  ogImage = '/images/og-default.svg',
  ogType = 'website',
  articleMeta,
  storyId,
  jsonLd = [],
  noindex = false,
  activeNavTab = 'home'
} = Astro.props;

const siteUrl = brandConfig.siteUrl.replace(/\/$/, '');
const currentPath = Astro.url.pathname;
const fullCanonicalUrl = canonicalUrl || `${siteUrl}${currentPath}`;
const finalTitle = title ? `${title} — ${brandConfig.name}` : brandConfig.homeTitle;
const finalDescription = description || brandConfig.homeMetaDescription;
const fullOgImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

const supportedLanguages = brandConfig.supportedLanguages;
const currentLangObj = getLanguageMeta(lang);

// Compute alternate hreflang links
const cleanSubPath = currentPath.replace(/^\/[a-z]{2}(\/|$)/, '/');
const hreflangLinks = supportedLanguages.map(l => ({
  code: l.code,
  href: `${siteUrl}/${l.code}${cleanSubPath.startsWith('/') ? cleanSubPath : '/' + cleanSubPath}`
}));
const xDefaultHref = `${siteUrl}/en${cleanSubPath.startsWith('/') ? cleanSubPath : '/' + cleanSubPath}`;

// JSON-LD Structured Data
const defaultJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": brandConfig.name,
    "alternateName": "Daily Tale Story Library",
    "url": siteUrl,
    "description": brandConfig.description,
    "inLanguage": supportedLanguages.map(l => l.code),
    "potentialAction": {
      "@type": "SearchAction",
      "target": `${siteUrl}/${lang}/search/?q={search_term_string}`,
      "query-input": "required name=search_term_string"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": brandConfig.name,
    "url": siteUrl,
    "logo": `${siteUrl}/favicon.svg`
  },
  ...jsonLd
];
---

<!DOCTYPE html>
<html lang={lang} dir={currentLangObj.direction || 'ltr'} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{finalTitle}</title>
    <meta name="description" content={finalDescription} />
    {keywords && <meta name="keywords" content={Array.isArray(keywords) ? keywords.join(', ') : keywords} />}
    <meta name="author" content={articleMeta?.author || brandConfig.name} />

    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <!-- Canonical URL -->
    <link rel="canonical" href={fullCanonicalUrl} />

    <!-- Multilingual hreflang alternate tags -->
    {hreflangLinks.map(l => (
      <link rel="alternate" hreflang={l.code} href={l.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <!-- Open Graph / Social Meta -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={brandConfig.name} />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:url" content={fullCanonicalUrl} />
    <meta property="og:image" content={fullOgImageUrl} />
    <meta property="og:locale" content={lang} />
    {ogType === 'article' && articleMeta?.publishDate && (
      <meta property="article:published_time" content={articleMeta.publishDate} />
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={fullOgImageUrl} />

    <!-- PWA & Mobile Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#D97706" />

    <!-- Google Fonts with font-display: swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,400..800;1,9..144,400..800&family=Noto+Sans+Devanagari:wght@400;600;700&family=Noto+Sans+Kannada:wght@400;600;700&family=Noto+Sans+Malayalam:wght@400;600;700&family=Noto+Sans+SC:wght@400;600;700&family=Noto+Sans+Tamil:wght@400;600;700&family=Noto+Sans+Telugu:wght@400;600;700&family=Noto+Sans:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data -->
    {defaultJsonLd.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Inline Script: Immediate Theme, Font & Language Auto-Detection -->
    <script is:inline>
      (function() {
        // 1. Immediate Theme Detection (Prevents white flash)
        const savedTheme = localStorage.getItem('dailytale_theme');
        if (savedTheme === 'night') {
          document.documentElement.classList.add('dark');
        } else if (savedTheme === 'sepia') {
          document.documentElement.classList.add('theme-sepia');
        } else if (savedTheme === 'light') {
          document.documentElement.classList.remove('dark', 'theme-sepia');
        } else {
          // Auto system mode
          if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
          }
        }

        // 2. Immediate Reader Typography Preferences
        try {
          const settings = JSON.parse(localStorage.getItem('dailytale_reader_settings') || '{}');
          if (settings.fontSize) {
            document.documentElement.style.setProperty('--story-font-size', settings.fontSize + 'px');
          }
          if (settings.lineSpacing) {
            document.documentElement.style.setProperty('--story-line-height', settings.lineSpacing);
          }
        } catch(e) {}
      })();
    </script>
  </head>

  <body class="bg-[#FFF8EC] text-[#3B2A1A] dark:bg-[#1B1A2E] dark:text-[#F3EBDD] min-h-screen flex flex-col font-sans transition-colors duration-200">
    <Header currentLang={lang} storyId={storyId} />

    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <Footer currentLang={lang} />
    <BottomNav currentLang={lang} activeTab={activeNavTab} />
    <AaPanel currentLang={lang} />
    <LanguageModal currentLang={lang} />

    <!-- Offline Reading Service Worker Registration -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
