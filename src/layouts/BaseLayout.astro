---
import brandConfig from '../../config/brand.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BedtimeBar from '../components/BedtimeBar.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  articleMeta?: {
    publishDate?: string;
    author?: string;
    tags?: string[];
    genre?: string;
    ageGroup?: string;
    readingTime?: string;
  };
  storyId?: string;
  jsonLd?: Record<string, any>[];
  noindex?: boolean;
}

const {
  title,
  description,
  lang = 'en',
  canonicalUrl,
  ogImage = '/images/og-default.svg',
  ogType = 'website',
  articleMeta,
  storyId,
  jsonLd = [],
  noindex = false
} = Astro.props;

const siteUrl = brandConfig.siteUrl.replace(/\/$/, '');
const currentPath = Astro.url.pathname;
const fullCanonicalUrl = canonicalUrl || `${siteUrl}${currentPath}`;
const finalTitle = title || brandConfig.homeTitle;
const finalDescription = description || brandConfig.homeMetaDescription;
const fullOgImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

// Supported Languages for hreflang
const supportedLanguages = brandConfig.supportedLanguages;
const currentLangObj = supportedLanguages.find(l => l.code === lang) || supportedLanguages[0];

// Default JSON-LD schemas
const defaultJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": brandConfig.name,
    "alternateName": brandConfig.nativeName,
    "url": siteUrl,
    "description": brandConfig.description,
    "inLanguage": supportedLanguages.map(l => l.code),
    "potentialAction": {
      "@type": "SearchAction",
      "target": `${siteUrl}/${lang}/search/?q={search_term_string}`,
      "query-input": "required name=search_term_string"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": brandConfig.name,
    "url": siteUrl,
    "logo": `${siteUrl}/favicon.svg`,
    "sameAs": [
      "https://twitter.com/dhinamorukathai"
    ],
    "contactPoint": {
      "@type": "ContactPoint",
      "email": brandConfig.contact.email,
      "contactType": "customer service"
    }
  },
  ...jsonLd
];
---

<!DOCTYPE html>
<html lang={lang} dir={currentLangObj.direction || 'ltr'} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{finalTitle}</title>
    <meta name="description" content={finalDescription} />
    
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <!-- Canonical URL -->
    <link rel="canonical" href={fullCanonicalUrl} />

    <!-- Multilingual hreflang alternate tags -->
    {supportedLanguages.map(l => (
      <link rel="alternate" hreflang={l.code} href={`${siteUrl}/${l.code}${currentPath.replace(/^\/[a-z]{2}\//, '/')}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/en${currentPath.replace(/^\/[a-z]{2}\//, '/')}`} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={brandConfig.name} />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:url" content={fullCanonicalUrl} />
    <meta property="og:image" content={fullOgImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={fullOgImageUrl} />

    <!-- PWA & Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#d97706" />

    <!-- Preconnect to Google Fonts for Noto typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;600;800;900&family=Noto+Sans+Devanagari:wght@400;600;800&family=Noto+Sans+Tamil:wght@400;600;800&display=swap" rel="stylesheet" />

    <!-- JSON-LD Structured Data Schemas -->
    {defaultJsonLd.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Inline script to restore bedtime/dark mode preference immediately (prevents flash) -->
    <script is:inline>
      const savedTheme = localStorage.getItem('story_bedtime_theme');
      if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>

  <body class="bg-brand-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100 min-h-screen flex flex-col font-sans transition-colors duration-300">
    <Header currentLang={lang} storyId={storyId} />

    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <Footer currentLang={lang} />
    <BedtimeBar currentLang={lang} />

    <!-- PWA Service Worker Registration -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
