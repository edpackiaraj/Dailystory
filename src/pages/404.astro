---
import brandConfig from '../../config/brand.json';
import { getTodaysStory, getStoryUrl } from '../lib/stories';
import BaseLayout from '../layouts/BaseLayout.astro';

const suggestedStory = getTodaysStory('en');
---

<BaseLayout
  title={`404 - Story Not Found | ${brandConfig.name}`}
  description="The page you were looking for has wandered into another enchanted forest, but a wonderful story awaits you right here."
  lang="en"
>
  <div class="max-w-2xl mx-auto px-4 py-16 sm:py-24 text-center">
    <div class="text-7xl mb-4">🧭 🦉</div>
    <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white mb-3">
      Page Wandered Away...
    </h1>
    <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 mb-8 leading-relaxed">
      Don't worry! Like all great explorers, sometimes we take a surprising turn in the forest. Here is today's featured story to brighten your path:
    </p>

    {suggestedStory && (
      <div class="p-6 bg-white dark:bg-slate-900 rounded-3xl border-2 border-amber-300 dark:border-slate-800 shadow-md text-left mb-8 flex flex-col sm:flex-row items-center gap-6">
        <div class="w-full sm:w-40 aspect-4/3 rounded-2xl overflow-hidden shrink-0">
          <img src={suggestedStory.image} alt={suggestedStory.image_alt} class="w-full h-full object-cover" />
        </div>
        <div class="flex-1">
          <span class="text-[10px] uppercase font-bold text-amber-600 block mb-1">{suggestedStory.collection}</span>
          <h2 class="text-lg font-bold text-slate-900 dark:text-white mb-2">{suggestedStory.title}</h2>
          <p class="text-xs text-slate-600 dark:text-slate-400 line-clamp-2 mb-3">{suggestedStory.summary}</p>
          <a href={getStoryUrl(suggestedStory, 'en')} class="inline-block px-4 py-2 rounded-full bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs shadow-xs transition-colors">
            Read This Story Instead →
          </a>
        </div>
      </div>
    )}

    <a href="/en/" class="inline-block text-xs font-bold text-amber-600 dark:text-amber-400 hover:underline">
      ← Return to Main Story Library
    </a>
  </div>
</BaseLayout>
