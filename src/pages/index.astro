---
import brandConfig from '../../config/brand.json';
import { getT, getLanguageMeta } from '../lib/i18n';
import {
  getAllReviewedStories,
  getTodaysStory,
  getCollectionSlug,
  getAudienceCategory,
  getLengthCategory,
  getStoryUrl,
  type Story
} from '../lib/stories';
import BaseLayout from '../layouts/BaseLayout.astro';

const currentLang = 'en';
const t = getT(currentLang);
const currentLangObj = getLanguageMeta(currentLang);

const allStories = getAllReviewedStories(currentLang);
const todaysStory = getTodaysStory(currentLang);

// Short stories under 3 min (word count <= 350)
const shortStories = allStories.filter(s => (s.word_count || 400) <= 350).slice(0, 8);

// Core cultural collections
const collectionsMap: Record<string, { name: string; count: number; image: string }> = {};
for (const s of allStories) {
  if (!collectionsMap[s.collection]) {
    collectionsMap[s.collection] = {
      name: s.collection,
      count: 0,
      image: s.image || '/images/og-default.png'
    };
  }
  collectionsMap[s.collection].count++;
}
const collectionList = Object.values(collectionsMap);

// Recent stories for grid
const recentStories = allStories.slice(0, 16);
---

<BaseLayout
  title={brandConfig.homeTitle}
  description={brandConfig.homeMetaDescription}
  lang={currentLang}
  canonicalUrl={`${brandConfig.siteUrl}/`}
  ogImage={todaysStory?.image || '/images/og-default.png'}
  activeNavTab="home"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 space-y-12 sm:space-y-16">
    
    <!-- Multilingual Quick Switcher Banner -->
    <div class="p-3 sm:p-4 rounded-2xl bg-white dark:bg-[#1E1D36] border border-[#EEDFC8] dark:border-[#383659] shadow-xs flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
      <div class="flex items-center gap-2 font-bold text-[#3B2A1A] dark:text-[#F3EBDD]">
        <span class="text-base">🌐</span>
        <span>Select your language / மொழியைத் தேர்ந்தெடுக்கவும்:</span>
      </div>
      <div class="flex items-center gap-1.5 flex-wrap justify-center font-bold">
        {brandConfig.supportedLanguages.map(l => (
          <a
            href={`/${l.code}/`}
            class={`px-3 py-1.5 rounded-xl border transition-all text-xs ${
              l.code === currentLang
                ? 'bg-[#D97706] text-white border-[#D97706] shadow-2xs'
                : 'bg-[#FFF8EC] dark:bg-[#151426] border-[#EEDFC8] dark:border-[#383659] text-[#3B2A1A] dark:text-[#F3EBDD] hover:border-[#D97706]'
            }`}
          >
            {l.native}
          </a>
        ))}
      </div>
    </div>

    <!-- Hero: "Story of the Day" -->
    {todaysStory && (
      <section class="relative overflow-hidden rounded-3xl bg-linear-to-br from-amber-500/10 via-amber-500/5 to-transparent border border-[#EEDFC8] dark:border-[#383659] p-6 sm:p-10 shadow-sm">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <div class="lg:col-span-7 space-y-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#D97706]/15 text-[#D97706] dark:text-[#F59E0B] text-xs font-bold uppercase tracking-wider">
              <span>☀️</span>
              <span>{t.storyOfTheDay}</span>
            </div>

            <h1 class={currentLang === 'ta'
              ? "text-xl sm:text-2xl md:text-3xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD] tracking-normal leading-snug"
              : "text-2xl sm:text-4xl lg:text-5xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD] tracking-tight leading-tight"
            }>
              {todaysStory.title}
            </h1>

            <p class="text-sm sm:text-base text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed line-clamp-3">
              {todaysStory.summary}
            </p>

            <div class="flex flex-wrap items-center gap-4 pt-2 text-xs text-[#6B5644] dark:text-[#C8BFAF]">
              <span class="inline-flex items-center gap-1 font-semibold">
                <span>⏱</span> {todaysStory.reading_time || '3 min'} read
              </span>
              <span>•</span>
              <span class="inline-flex items-center gap-1 font-semibold">
                <span>📚</span> {todaysStory.collection}
              </span>
              <span>•</span>
              <span class="inline-flex items-center gap-1 font-semibold">
                <span>🌱</span> {getAudienceCategory(todaysStory.age_group).toUpperCase()}
              </span>
            </div>

            <div class="flex flex-wrap items-center gap-3 pt-4">
              <a
                href={getStoryUrl(todaysStory, currentLang)}
                class="px-6 py-3.5 rounded-full bg-[#D97706] text-white font-bold text-sm shadow-md hover:bg-[#B45309] hover:shadow-lg transition-all min-h-[48px] flex items-center gap-2"
              >
                <span>📖</span>
                <span>{t.startReading}</span>
              </a>

              <button
                type="button"
                data-play-story={todaysStory.slug}
                data-title={todaysStory.title}
                data-text={todaysStory.full_text.slice(0, 300)}
                data-lang={currentLang}
                class="px-5 py-3.5 rounded-full bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] font-bold text-sm text-[#3B2A1A] dark:text-[#F3EBDD] hover:border-[#D97706] hover:text-[#D97706] transition-all min-h-[48px] flex items-center gap-2"
                aria-label="Listen to audio narration"
              >
                <span>▶</span>
                <span>{t.listen}</span>
              </button>
            </div>
          </div>

          <div class="lg:col-span-5 flex justify-center">
            <div class="relative w-full max-w-sm aspect-4/3 rounded-2xl overflow-hidden shadow-lg border-2 border-white dark:border-[#25243E]">
              <img
                src={todaysStory.image}
                alt={todaysStory.title}
                width="600"
                height="450"
                loading="eager"
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              />
            </div>
          </div>

        </div>
      </section>
    )}

    <!-- Dynamic "Continue Reading / Listening" Section (Populated via client-side localStorage) -->
    <section id="continue-reading-section" class="hidden p-5 sm:p-6 rounded-3xl bg-linear-to-r from-amber-50 via-orange-50/50 to-amber-50 dark:from-[#25243E] dark:via-[#1F1E38] dark:to-[#25243E] border-2 border-amber-300 dark:border-amber-600/50 shadow-md transition-all">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-start sm:items-center gap-3.5">
          <div id="continue-icon-box" class="w-12 h-12 rounded-2xl bg-[#D97706] text-white flex items-center justify-center text-2xl shadow-sm shrink-0">
            📖
          </div>
          <div class="space-y-1">
            <div class="flex items-center gap-2 flex-wrap">
              <span id="continue-type-badge" class="px-2.5 py-0.5 rounded-full bg-[#D97706]/15 text-[#D97706] dark:text-[#F59E0B] text-[11px] font-black uppercase tracking-wider">
                Continue Reading
              </span>
              <span id="continue-progress-badge" class="px-2 py-0.5 rounded-full bg-white dark:bg-[#151426] border border-[#EEDFC8] dark:border-[#383659] text-[11px] font-mono font-bold text-[#6B5644] dark:text-[#C8BFAF]">
                0%
              </span>
            </div>
            <p id="continue-reading-title" class="text-base sm:text-lg font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD] line-clamp-1"></p>
            <p id="continue-reading-collection" class="text-xs text-[#6B5644] dark:text-[#C8BFAF] font-medium"></p>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center gap-2 self-end sm:self-center shrink-0">
          <a
            id="continue-read-link"
            href="#"
            class="px-4 py-2.5 rounded-xl bg-[#D97706] hover:bg-[#B45309] text-white text-xs font-black shadow-xs transition-all flex items-center gap-1.5 min-h-[40px]"
          >
            <span>📖</span>
            <span>Read</span>
          </a>
          <a
            id="continue-listen-link"
            href="#"
            class="px-4 py-2.5 rounded-xl bg-[#0F766E] hover:bg-[#0D655E] text-white text-xs font-black shadow-xs transition-all flex items-center gap-1.5 min-h-[40px]"
          >
            <span>🎧</span>
            <span>Listen</span>
          </a>
          <button
            id="continue-dismiss-btn"
            type="button"
            aria-label="Dismiss Continue Reading"
            class="p-2.5 rounded-xl bg-white dark:bg-[#1E1D36] border border-[#EEDFC8] dark:border-[#383659] hover:bg-red-50 dark:hover:bg-red-950/30 text-slate-400 hover:text-red-500 transition-colors"
            title="Dismiss"
          >
            ✕
          </button>
        </div>
      </div>
    </section>

    <!-- Welcome & How to Effectively Use Section -->
    <section class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-[#1E1D36] border border-[#EEDFC8] dark:border-[#383659] shadow-sm space-y-6">
      
      <!-- Welcome Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-[#EEDFC8]/60 dark:border-[#383659]/60">
        <div class="space-y-1.5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#D97706]/15 text-[#D97706] dark:text-[#F59E0B] text-xs font-black uppercase tracking-wider">
            <span>🦉</span>
            <span>Welcome to Daily Tale</span>
          </div>
          <h2 class="text-xl sm:text-2xl lg:text-3xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD] tracking-tight">
            Universal Wisdom &amp; Bedtime Stories for Every Generation
          </h2>
          <p class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF] max-w-2xl leading-relaxed">
            An ad-free, child-safe sanctuary offering timeless moral fables, cultural folktales, and bilingual bedtime stories across 8+ world languages.
          </p>
        </div>

        <a
          href="/en/guide/"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-[#FFF8EC] dark:bg-[#151426] border border-[#EEDFC8] dark:border-[#383659] text-xs font-bold text-[#D97706] hover:border-[#D97706] transition-all self-start md:self-auto shrink-0 shadow-2xs"
        >
          <span>📘</span>
          <span>Reading Guide →</span>
        </a>
      </div>

      <!-- How to Effectively Use (4 Educational Pillars) -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-[#6B5644] dark:text-[#C8BFAF]">
          💡 How to Get the Most Out of Every Story (Pedagogical Guide)
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          
          <!-- Card 1: Audio Read-Along -->
          <div class="p-4 rounded-2xl bg-[#FFF8EC] dark:bg-[#151426] border border-[#EEDFC8]/80 dark:border-[#383659] space-y-2">
            <div class="w-9 h-9 rounded-xl bg-teal-500/15 text-teal-600 dark:text-teal-400 flex items-center justify-center text-lg font-bold">
              🎧
            </div>
            <h4 class="text-sm font-bold text-[#3B2A1A] dark:text-[#F3EBDD]">
              1. Listen &amp; Read-Along
            </h4>
            <p class="text-xs text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
              Click Play to hear speech narration while words highlight in sync — boosting fluency, pronunciation, and listening comprehension.
            </p>
          </div>

          <!-- Card 2: Bilingual Mode -->
          <div class="p-4 rounded-2xl bg-[#FFF8EC] dark:bg-[#151426] border border-[#EEDFC8]/80 dark:border-[#383659] space-y-2">
            <div class="w-9 h-9 rounded-xl bg-amber-500/15 text-amber-600 dark:text-amber-400 flex items-center justify-center text-lg font-bold">
              🌐
            </div>
            <h4 class="text-sm font-bold text-[#3B2A1A] dark:text-[#F3EBDD]">
              2. Bilingual Mode
            </h4>
            <p class="text-xs text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
              Compare regional stories side-by-side with English or other editions to build vocabulary and language proficiency in context.
            </p>
          </div>

          <!-- Card 3: Think & Talk Quizzes -->
          <div class="p-4 rounded-2xl bg-[#FFF8EC] dark:bg-[#151426] border border-[#EEDFC8]/80 dark:border-[#383659] space-y-2">
            <div class="w-9 h-9 rounded-xl bg-orange-500/15 text-orange-600 dark:text-orange-400 flex items-center justify-center text-lg font-bold">
              💡
            </div>
            <h4 class="text-sm font-bold text-[#3B2A1A] dark:text-[#F3EBDD]">
              3. Think &amp; Talk Quizzes
            </h4>
            <p class="text-xs text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
              Check understanding with 3 interactive quiz questions and thoughtful conversation prompts after every single story.
            </p>
          </div>

          <!-- Card 4: Calming Bedtime & Focus -->
          <div class="p-4 rounded-2xl bg-[#FFF8EC] dark:bg-[#151426] border border-[#EEDFC8]/80 dark:border-[#383659] space-y-2">
            <div class="w-9 h-9 rounded-xl bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-lg font-bold">
              🌙
            </div>
            <h4 class="text-sm font-bold text-[#3B2A1A] dark:text-[#F3EBDD]">
              4. Bedtime &amp; Focus Mode
            </h4>
            <p class="text-xs text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
              Toggle dyslexia-friendly fonts, adjust text sizes (Aa), or switch to calming night tones for restful bedtime reading.
            </p>
          </div>

        </div>
      </div>

    </section>

    <!-- Audience Filter Chips: Everyone, Kids, Teens -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-xl sm:text-2xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD]">
            Explore by Reader / {t.audience}
          </h2>
          <p class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF]">
            Thoughtfully curated fables, folktales and wisdom for every stage of life
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        {brandConfig.audiences.map(aud => (
          <a
            href={`/${currentLang}/search/?audience=${aud.id}`}
            class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] hover:border-[#D97706] hover:scale-[1.02] transition-all group flex items-center gap-3 shadow-xs"
          >
            <span class="text-3xl">{aud.icon}</span>
            <div>
              <span class="block text-sm sm:text-base font-extrabold text-[#3B2A1A] dark:text-[#F3EBDD] group-hover:text-[#D97706] transition-colors">
                {aud.label}
              </span>
              <span class="text-xs text-[#6B5644] dark:text-[#C8BFAF]">
                {aud.id === 'kids' ? 'Wholesome fables & bedtime tales' : aud.id === 'teens' ? 'Philosophical & character-building' : 'Universal folklore for all ages'}
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Short Stories Under 3 Min -->
    {shortStories.length > 0 && (
      <section class="space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-xl sm:text-2xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD]">
              {t.shortStoriesUnder3Min}
            </h2>
            <p class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF]">
              Quick, meaningful moral fables perfect for a quick pause or bedtime
            </p>
          </div>
          <a href={`/${currentLang}/search/?length=short`} class="text-xs sm:text-sm font-bold text-[#D97706] hover:underline">
            View All →
          </a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
          {shortStories.map(story => (
            <a
              href={getStoryUrl(story, currentLang)}
              class="group p-3.5 rounded-2xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] hover:border-[#D97706] hover:shadow-md transition-all flex flex-col justify-between"
            >
              <div class="space-y-2">
                <div class="aspect-16/10 rounded-xl overflow-hidden bg-[#EEDFC8]/30">
                  <img
                    src={story.image}
                    alt={story.title}
                    width="300"
                    height="190"
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
                <div class="flex items-center justify-between text-[11px] text-[#6B5644] dark:text-[#C8BFAF]">
                  <span class="font-bold text-[#D97706]">{story.collection}</span>
                  <span>⏱ {story.reading_time || '2m'}</span>
                </div>
                <h3 class="text-xs sm:text-sm font-bold text-[#3B2A1A] dark:text-[#F3EBDD] line-clamp-2 leading-snug group-hover:text-[#D97706] transition-colors">
                  {story.title}
                </h3>
              </div>
              <p class="text-[11px] text-[#6B5644] dark:text-[#C8BFAF] line-clamp-2 mt-2">
                {story.moral}
              </p>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Classic Cultural Story Collections -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-xl sm:text-2xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD]">
            {t.collections}
          </h2>
          <p class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF]">
            Treasures of world folklore translated with cultural reverence
          </p>
        </div>
        <a href={`/${currentLang}/collections/`} class="text-xs sm:text-sm font-bold text-[#D97706] hover:underline">
          All Collections →
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4">
        {collectionList.map(col => {
          const colSlug = getCollectionSlug(col.name);
          return (
            <a
              href={`/${currentLang}/collections/${colSlug}/`}
              class="group p-4 rounded-2xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] hover:border-[#D97706] hover:shadow-md transition-all flex flex-col justify-between"
            >
              <div class="space-y-2">
                <div class="aspect-4/3 rounded-xl overflow-hidden bg-[#EEDFC8]/30">
                  <img
                    src={col.image}
                    alt={col.name}
                    width="300"
                    height="225"
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
                <h3 class="text-sm font-bold text-[#3B2A1A] dark:text-[#F3EBDD] group-hover:text-[#D97706] transition-colors">
                  {col.name}
                </h3>
              </div>
              <div class="flex items-center justify-between text-xs text-[#6B5644] dark:text-[#C8BFAF] mt-3 pt-2 border-t border-[#EEDFC8]/50 dark:border-[#383659]/50">
                <span>{col.count} {t.stories}</span>
                <span class="text-[#D97706] font-bold group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Latest Stories Grid -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-xl sm:text-2xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD]">
            {t.exploreStories}
          </h2>
          <p class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF]">
            Freshly indexed tales with Bloom's taxonomy discussion prompts
          </p>
        </div>
        <a href={`/${currentLang}/search/`} class="text-xs sm:text-sm font-bold text-[#D97706] hover:underline">
          Search All →
        </a>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3.5 sm:gap-4">
        {recentStories.map(story => (
          <a
            href={getStoryUrl(story, currentLang)}
            class="group p-4 rounded-2xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] hover:border-[#D97706] hover:shadow-md transition-all flex flex-col justify-between"
          >
            <div class="space-y-2.5">
              <div class="aspect-16/10 rounded-xl overflow-hidden bg-[#EEDFC8]/30">
                <img
                  src={story.image}
                  alt={story.title}
                  width="300"
                  height="190"
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </div>

              <div class="flex items-center justify-between text-[11px] text-[#6B5644] dark:text-[#C8BFAF]">
                <span class="font-bold text-[#D97706]">{story.collection}</span>
                <span>⏱ {story.reading_time || '3m'}</span>
              </div>

              <h3 class="text-sm font-bold text-[#3B2A1A] dark:text-[#F3EBDD] line-clamp-2 leading-snug group-hover:text-[#D97706] transition-colors">
                {story.title}
              </h3>

              <p class="text-xs text-[#6B5644] dark:text-[#C8BFAF] line-clamp-2">
                {story.summary}
              </p>
            </div>

            <div class="mt-3 pt-2.5 border-t border-[#EEDFC8]/50 dark:border-[#383659]/50 flex items-center justify-between text-[11px] text-[#D97706] font-bold">
              <span>{story.genre}</span>
              <span class="group-hover:translate-x-1 transition-transform">Read Story →</span>
            </div>
          </a>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>

<script is:inline>
  // Language auto-detect and saved preference routing on root visit
  (function() {
    const saved = localStorage.getItem('dailytale_lang');
    if (saved && saved !== 'en') {
      window.location.replace(`/${saved}/`);
      return;
    }
    if (!saved) {
      const browserLang = (navigator.language || navigator.userLanguage || '').slice(0, 2).toLowerCase();
      if (['ta', 'hi', 'te', 'ml', 'kn', 'mr', 'zh'].includes(browserLang)) {
        localStorage.setItem('dailytale_lang', browserLang);
        window.location.replace(`/${browserLang}/`);
        return;
      }
    }
    // Check continue reading / listening
    try {
      const raw = localStorage.getItem('dailytale_last_read') || localStorage.getItem('dailytale_recent');
      if (raw) {
        const item = JSON.parse(raw);
        const section = document.getElementById('continue-reading-section');
        const titleEl = document.getElementById('continue-reading-title');
        const collectionEl = document.getElementById('continue-reading-collection');
        const typeBadge = document.getElementById('continue-type-badge');
        const progressBadge = document.getElementById('continue-progress-badge');
        const iconBox = document.getElementById('continue-icon-box');
        const readLink = document.getElementById('continue-read-link');
        const listenLink = document.getElementById('continue-listen-link');
        const dismissBtn = document.getElementById('continue-dismiss-btn');

        if (section && titleEl && item.title && item.url) {
          titleEl.textContent = item.title;
          if (collectionEl) collectionEl.textContent = item.collection ? '📚 ' + item.collection : '';

          const isListening = item.type === 'listening';
          if (iconBox) iconBox.textContent = isListening ? '🎧' : '📖';
          if (typeBadge) typeBadge.textContent = isListening ? 'Continue Listening' : 'Continue Reading';

          const pct = isListening ? (item.listeningPercent || 0) : (item.scrollPercent || 0);
          if (progressBadge) {
            progressBadge.textContent = pct > 0 ? pct + '% ' + (isListening ? 'listened' : 'read') : 'In Progress';
          }

          if (readLink) readLink.href = item.url + '#resume';
          if (listenLink) listenLink.href = item.url + '#listen';

          if (dismissBtn) {
            dismissBtn.addEventListener('click', function() {
              localStorage.removeItem('dailytale_last_read');
              localStorage.removeItem('dailytale_recent');
              section.classList.add('hidden');
            });
          }

          section.classList.remove('hidden');
        }
      }
    } catch (e) {}
  })();
</script>
