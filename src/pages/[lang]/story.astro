  // 7. Track Story Reading & Listening Progress for "Continue Reading/Listening"
  (function trackStoryProgress() {
    try {
      const suite = document.getElementById('story-audio-suite');
      const storyId = suite?.getAttribute('data-story-id') || window.location.pathname;
      const storyTitle = suite?.getAttribute('data-story-title') || document.title.replace(' — Daily Tale', '').replace(' | Daily Tale', '');
      const storyCollection = suite?.getAttribute('data-collection') || '';
      const currentUrl = window.location.pathname;
      const currentLang = document.documentElement.lang || 'en';
      const storyImg = document.querySelector('meta[property="og:image"]')?.getAttribute('content') || '';

      function saveProgress(extra) {
        extra = extra || {};
        const docElem = document.documentElement;
        const totalHeight = docElem.scrollHeight - docElem.clientHeight;
        const scrollPct = totalHeight > 0 ? Math.min(100, Math.max(0, Math.round((window.scrollY / totalHeight) * 100))) : 0;
        
        let existing = {};
        try { existing = JSON.parse(localStorage.getItem('dailytale_last_read') || '{}'); } catch(e) {}
        
        const state = {
          id: storyId,
          title: storyTitle,
          collection: storyCollection,
          url: currentUrl,
          lang: currentLang,
          image: storyImg,
          scrollY: window.scrollY,
          scrollPercent: scrollPct,
          type: extra.type || (existing.id === storyId && existing.type ? existing.type : 'reading'),
          listeningPercent: extra.listeningPercent !== undefined ? extra.listeningPercent : (existing.listeningPercent || 0),
          sentenceIdx: extra.sentenceIdx !== undefined ? extra.sentenceIdx : (existing.sentenceIdx || 0),
          timestamp: Date.now()
        };
        localStorage.setItem('dailytale_last_read', JSON.stringify(state));
      }

      // Initial save
      saveProgress({ type: 'reading' });

      // Save on scroll (throttled)
      let scrollTimer;
      window.addEventListener('scroll', function() {
        clearTimeout(scrollTimer);
        scrollTimer = setTimeout(function() {
          saveProgress({ type: 'reading' });
        }, 500);
      }, { passive: true });

      // Listen for audio player events
      window.addEventListener('dailytale-listening-update', function(e) {
        if (e.detail && e.detail.storyId === storyId) {
          saveProgress({
            type: 'listening',
            listeningPercent: e.detail.percent,
            sentenceIdx: e.detail.sentenceIdx
          });
        }
      });

      // Resume reading scroll position or start audio if URL contains hash
      if (window.location.hash === '#resume') {
        try {
          const saved = JSON.parse(localStorage.getItem('dailytale_last_read') || '{}');
          if (saved.id === storyId && saved.scrollY) {
            setTimeout(function() {
              window.scrollTo({ top: saved.scrollY, behavior: 'smooth' });
            }, 300);
          }
        } catch(e) {}
      } else if (window.location.hash.indexOf('listen') !== -1) {
        setTimeout(function() {
          const playBtn = document.getElementById('audio-play-pause-btn') || document.getElementById('desktop-audio-play-btn');
          if (playBtn) playBtn.click();
        }, 500);
      }
    } catch(err) {
      console.warn('Progress tracking error:', err);
    }
  })();

  // 8. Real-Time On-The-Fly Translation Engine (for untranslated editions other than Tamil)
  (function initRealtimeTranslation() {
    try {
      const trBtn = document.getElementById('btn-realtime-translate');
      const origBtn = document.getElementById('btn-show-original');
      const trLabel = document.getElementById('tr-label');
      const progressBarContainer = document.getElementById('tr-progress-bar-container');
      const progressBar = document.getElementById('tr-progress-bar');
      const contentElem = document.getElementById('story-body-content');

      if (!trBtn || !contentElem) return;

      const targetLang = document.documentElement.lang || 'en';
      const trLabelElem = document.getElementById('tr-label');
      const nativeLangName = trLabelElem?.textContent?.replace('Translate to ', '') || targetLang;
      const suite = document.getElementById('story-audio-suite');
      const storyId = suite?.getAttribute('data-story-id') || window.location.pathname;
      const cacheKey = 'dailytale_rt_' + storyId + '_' + targetLang;

      const paragraphs = Array.from(contentElem.querySelectorAll('p'));
      const originalTexts = paragraphs.map(function(p) { return p.textContent.trim(); });

      function applyTranslations(translatedArray) {
        paragraphs.forEach(function(p, i) {
          if (translatedArray[i]) {
            p.textContent = translatedArray[i];
          }
        });
        if (trLabel) trLabel.textContent = '✓ ' + nativeLangName;
        trBtn.classList.remove('bg-[#D97706]', 'hover:bg-[#B45309]');
        trBtn.classList.add('bg-emerald-600', 'hover:bg-emerald-700');
        if (origBtn) origBtn.classList.remove('hidden');
        if (progressBarContainer) progressBarContainer.classList.add('hidden');
      }

      function showOriginal() {
        paragraphs.forEach(function(p, i) {
          p.textContent = originalTexts[i];
        });
        if (trLabel) trLabel.textContent = '⚡ Translate to ' + nativeLangName;
        trBtn.classList.remove('bg-emerald-600', 'hover:bg-emerald-700');
        trBtn.classList.add('bg-[#D97706]', 'hover:bg-[#B45309]');
        if (origBtn) origBtn.classList.add('hidden');
      }

      if (origBtn) {
        origBtn.addEventListener('click', showOriginal);
      }

      // Check if translation was previously cached
      try {
        const cached = JSON.parse(localStorage.getItem(cacheKey) || 'null');
        if (Array.isArray(cached) && cached.length === paragraphs.length) {
          applyTranslations(cached);
        }
      } catch(e) {}

      trBtn.addEventListener('click', async function() {
        // If already cached, apply immediately
        try {
          const cached = JSON.parse(localStorage.getItem(cacheKey) || 'null');
          if (Array.isArray(cached) && cached.length === paragraphs.length) {
            applyTranslations(cached);
            return;
          }
        } catch(e) {}

        trBtn.disabled = true;
        if (trLabel) trLabel.textContent = 'Translating...';
        if (progressBarContainer) progressBarContainer.classList.remove('hidden');

        const translated = [];
        for (let i = 0; i < paragraphs.length; i++) {
          const text = originalTexts[i];
          if (!text) {
            translated.push('');
            continue;
          }

          try {
            const res = await fetch('/api/translate', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ text: text, targetLang: targetLang, sourceLang: 'en' })
            });
            const data = await res.json();
            if (data && data.translatedText) {
              translated.push(data.translatedText);
              paragraphs[i].textContent = data.translatedText;
            } else {
              translated.push(text);
            }
          } catch(err) {
            translated.push(text);
          }

          if (progressBar) {
            const pct = Math.round(((i + 1) / paragraphs.length) * 100);
            progressBar.style.width = pct + '%';
          }
        }

        try {
          localStorage.setItem(cacheKey, JSON.stringify(translated));
        } catch(e) {}

        trBtn.disabled = false;
        applyTranslations(translated);
      });
    } catch(err) {
      console.warn('Realtime translation initialization error:', err);
    }
  })();
</script>
