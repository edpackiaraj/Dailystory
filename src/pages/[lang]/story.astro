---
import brandConfig from '../../../config/brand.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryIllustration from '../../components/StoryIllustration.astro';
import { getT, getLanguageMeta } from '../../lib/i18n';
import {
  getAllReviewedStories,
  getStoriesByCollection,
  getCollectionSlug,
  getAudienceCategory,
  getLengthCategory,
  getStoryUrl,
  isStoryTranslated,
  getLocalizedCollectionName,
  getStoryOgImage,
  sanitizeQuizAndDiscussion,
  cleanStorySummary,
  type Story
} from '../../lib/stories';

export function getStaticPaths() {
  return brandConfig.supportedLanguages.map(l => ({
    params: { lang: l.code }
  }));
}

const { lang } = Astro.params;
const currentLang = lang || 'en';
const t = getT(currentLang);
const currentLangObj = getLanguageMeta(currentLang);

const allStories = getAllReviewedStories(currentLang);
const rawStory = allStories[0] || ({} as Story);
const prevStory = null;
const nextStory = allStories[1] || null;

// Sanitize mismatched quiz options and generic boilerplate
const story = sanitizeQuizAndDiscussion(rawStory);

function sanitizeTag(str?: string) {
  if (!str) return '';
  return str
    .replace(/\s*\[[A-Za-z]{2}\]/g, '')
    .replace(/\s*\([A-Za-z\s\u0B80-\u0BFF\u0900-\u097F]+\)$/, '')
    .trim();
}

const cleanTitle = sanitizeTag(story.title);
const cleanSummary = cleanStorySummary(story.summary);
const cleanMoral = sanitizeTag(story.moral);

const isTranslated = isStoryTranslated(story, currentLang);
const colSlug = getCollectionSlug(story.collection);
const localizedColName = getLocalizedCollectionName(story.collection, currentLang);
const audienceKey = getAudienceCategory(story.age_group);
const audienceLabel = audienceKey === 'kids' ? t.kids : (audienceKey === 'teens' ? t.teens : t.everyone);
const canonicalUrl = `${brandConfig.siteUrl}/${lang}/${colSlug}/${story.slug}/`;

// Context-Rich, Keyword-Targeted Page Title Tag
const seoStoryTitle = currentLang === 'ta'
  ? `${cleanTitle}: ${localizedColName} நீதிக்கதை | ${brandConfig.name}`
  : (currentLang === 'hi'
      ? `${cleanTitle}: ${localizedColName} | ${brandConfig.name}`
      : `${cleanTitle}: ${story.collection} Story with Moral | ${brandConfig.name}`);

// Guaranteed Collection-Specific OG Visual
const storyOgImage = getStoryOgImage(story);

// 4 Related Stories from the Same Collection for Deep Crawlable Internal Linking
const allColStories = getStoriesByCollection(currentLang, story.collection);
const relatedStories = allColStories
  .filter(s => s.id !== story.id && s.reviewed !== false)
  .slice(0, 4);

const cultureRegionsMap: Record<string, string> = {
  "India": "பாரதப் பாரம்பரியம்",
  "Ancient India": "பண்டைய பாரதம்",
  "Greece": "பண்டைய கிரேக்கம்",
  "Ancient Greece": "பண்டைய கிரேக்கம்",
  "Middle East": "மத்திய கிழக்கு",
  "Germany": "ஜெர்மன் நாட்டார் மரபு",
  "Denmark": "டென்மார்க் இலக்கியம்",
  "France": "பிரெஞ்சுப் பாரம்பரியம்",
  "Arabia": "அரேபியப் பாரம்பரியம்",
  "Global": "உலக நாட்டார் கதைகள்"
};
const localizedCulture = (currentLang === 'ta' && story.culture_region) ? (cultureRegionsMap[story.culture_region] || story.culture_region) : story.culture_region;
const localizedReadingTime = (currentLang === 'ta' && story.reading_time)
  ? String(story.reading_time).replace('min', 'நிமிடம்').replace('m', ' நிமிடம்')
  : (story.reading_time || (currentLang === 'ta' ? '4 நிமிடம்' : '4 min'));

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": t.home || "Home",
        "item": `${brandConfig.siteUrl}/${lang}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": localizedColName,
        "item": `${brandConfig.siteUrl}/${lang}/collections/${colSlug}/`
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": cleanTitle,
        "item": canonicalUrl
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": cleanTitle,
    "description": cleanSummary,
    "image": storyOgImage.startsWith('http') ? storyOgImage : `${brandConfig.siteUrl}${storyOgImage}`,
    "inLanguage": lang,
    "genre": story.genre,
    "articleSection": story.collection,
    "wordCount": story.word_count || 450,
    "datePublished": story.publishDate || "2026-01-01T00:00:00Z",
    "dateModified": new Date().toISOString().split('T')[0] + "T00:00:00Z",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": canonicalUrl
    },
    "author": {
      "@type": "Person",
      "name": "Dr. Edward Packiaraj",
      "jobTitle": "Chief Editor & Educational Researcher",
      "url": `${brandConfig.siteUrl}/${lang}/about/`
    },
    "publisher": {
      "@type": "Organization",
      "name": brandConfig.name,
      "logo": {
        "@type": "ImageObject",
        "url": `${brandConfig.siteUrl}/favicon.svg`
      }
    },
    "teaches": cleanMoral,
    "educationalLevel": ["Beginner", "Intermediate"],
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": ["#story-body-content", "h1"]
    }
  }
];
---

<BaseLayout
  title={seoStoryTitle}
  description={cleanSummary}
  lang={lang}
  canonicalUrl={canonicalUrl}
  ogImage={storyOgImage}
  ogType="article"
  noindex={false}
  articleMeta={{
    publishDate: story.publishDate || '2026-03-25',
    author: story.author || brandConfig.name,
    genre: story.genre,
    tags: story.tags,
    readingTime: story.reading_time
  }}
  storyId={story.id}
  jsonLd={jsonLd}
>
  <!-- Reading Progress Bar -->
  <div
    id="reading-progress-bar"
    class="fixed top-0 inset-x-0 h-1 bg-[#D97706] z-50 origin-left scale-x-0 transition-transform duration-75"
    aria-hidden="true"
  ></div>

  <div id="story-app-container" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
    
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-[#6B5644] dark:text-[#C8BFAF] mb-6 overflow-x-auto whitespace-nowrap">
      <a href={`/${lang}/`} class="hover:text-[#D97706] transition-colors">{t.home}</a>
      <span>/</span>
      <a href={`/${lang}/collections/`} class="hover:text-[#D97706] transition-colors">{t.collections}</a>
      <span>/</span>
      <a id="story-crumb-col-link" href={`/${lang}/collections/${colSlug}/`} class="hover:text-[#D97706] transition-colors">
        <span id="story-crumb-col-name">{story.collection}</span>
      </a>
      <span>/</span>
      <span id="story-crumb-title" class="text-[#3B2A1A] dark:text-[#F3EBDD] font-semibold truncate max-w-xs">{cleanTitle}</span>
    </nav>

    <!-- Main Reader Layout: 2 Columns on Desktop (Centered Reading Column + Right Companion Panel) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- Left / Center Reading Column (lg:col-span-8) -->
      <article class="lg:col-span-8 w-full space-y-8">
        
        <!-- Story Header -->
        <header class="space-y-4">
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span id="story-badge-col" class="px-3 py-1 rounded-full bg-[#D97706]/15 text-[#D97706] dark:text-[#F59E0B] font-bold">
              {story.collection}
            </span>
            <span class="px-3 py-1 rounded-full bg-[#0F766E]/15 text-[#0F766E] dark:text-[#2DD4BF] font-semibold">
              {audienceLabel}
            </span>
            <span class="text-[#6B5644] dark:text-[#C8BFAF]">
              ⏱ {localizedReadingTime}
            </span>
            {localizedCulture && (
              <span class="text-[#6B5644] dark:text-[#C8BFAF]">
                • {localizedCulture}
              </span>
            )}
          </div>

          <h1 id="story-main-title" class={lang === 'ta'
            ? "text-lg sm:text-xl md:text-2xl font-bold font-display text-[#3B2A1A] dark:text-[#F3EBDD] tracking-normal leading-snug"
            : "text-xl sm:text-2xl lg:text-3xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD] tracking-tight leading-tight"
          }>
            {cleanTitle}
          </h1>

          <p id="story-summary-text" class="text-sm sm:text-base text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed italic">
            {cleanSummary}
          </p>
        </header>

        <!-- Story-Specific Thematic Illustration -->
        <div class="relative rounded-3xl overflow-hidden shadow-lg border border-[#EEDFC8] dark:border-[#383659]">
          <StoryIllustration story={story} size="hero" lang={currentLang} />
        </div>

        <!-- Real-Time Translation Banner (For untranslated editions other than Tamil) -->
        {(!isTranslated && lang !== 'ta' && lang !== 'en') && (
          <div id="realtime-translate-card" class="p-4 sm:p-5 rounded-2xl bg-linear-to-r from-amber-500/15 via-orange-500/10 to-teal-500/10 border-2 border-amber-500/40 shadow-sm space-y-3">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div class="flex items-start sm:items-center gap-3">
                <span class="text-2xl shrink-0">🌐</span>
                <div class="space-y-0.5">
                  <h3 class="text-xs sm:text-sm font-black text-[#3B2A1A] dark:text-[#F3EBDD] flex items-center gap-2">
                    <span>{currentLangObj.native} Real-Time Translation</span>
                    <span class="px-2 py-0.5 rounded-full bg-amber-500 text-white text-[10px] uppercase font-bold tracking-wider">1-Click</span>
                  </h3>
                  <p class="text-xs text-[#6B5644] dark:text-[#C8BFAF]">
                    Original text is in English. Click below to translate this story instantly into {currentLangObj.native}.
                  </p>
                </div>
              </div>

              <div class="flex items-center gap-2 shrink-0">
                <button
                  type="button"
                  id="btn-realtime-translate"
                  class="px-4 py-2.5 rounded-xl bg-[#D97706] hover:bg-[#B45309] text-white text-xs font-black shadow-sm transition-all flex items-center gap-1.5 min-h-[40px]"
                >
                  <span id="tr-icon">⚡</span>
                  <span id="tr-label">Translate to {currentLangObj.native}</span>
                </button>
                <button
                  type="button"
                  id="btn-show-original"
                  class="hidden px-3.5 py-2.5 rounded-xl border border-[#EEDFC8] dark:border-[#383659] text-xs font-bold text-[#6B5644] dark:text-[#C8BFAF] hover:border-[#D97706] transition-all min-h-[40px]"
                >
                  Original English
                </button>
              </div>
            </div>

            <!-- Translation Progress Indicator -->
            <div id="tr-progress-bar-container" class="hidden w-full bg-amber-200 dark:bg-slate-700 h-1.5 rounded-full overflow-hidden">
              <div id="tr-progress-bar" class="bg-[#D97706] h-full w-0 transition-all duration-300"></div>
            </div>
          </div>
        )}

        <!-- Full Story Reading Experience -->
        <div class="space-y-8">
            <!-- Embedded Collection Playlist for Seamless Auto-Advance Narration -->
            <script type="application/json" id="story-collection-playlist" set:html={JSON.stringify(
              allColStories.slice(0, 30).map(s => ({
                id: s.id,
                title: s.title,
                slug: s.slug,
                collection: s.collection,
                reading_time: s.reading_time || '3m',
                url: getStoryUrl(s, currentLang),
                full_text: s.full_text || '',
                moral: s.moral || '',
                vocabulary: s.vocabulary || [],
                discussion_questions: s.discussion_questions || []
              }))
            )}></script>

            <!-- Dedicated Audio & Bedtime Suite Card (Prominent on all devices above story text) -->
            <section
              id="story-audio-suite"
              class="p-5 sm:p-6 rounded-3xl bg-linear-to-br from-white via-[#FFF8EC] to-amber-50/70 dark:from-[#25243E] dark:via-[#1B1A2E] dark:to-[#25243E] border-2 border-[#EEDFC8] dark:border-[#383659] shadow-md space-y-4"
              data-story-id={story.id}
              data-story-title={cleanTitle}
              data-collection={story.collection}
            >
              <!-- Top Row: Main Play Button, Status & Countdown Badge -->
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <button
                    type="button"
                    id="story-main-play-btn"
                    class="px-6 py-3.5 rounded-full bg-[#0F766E] hover:bg-[#0D655E] active:scale-95 text-white font-bold text-sm sm:text-base flex items-center gap-2.5 shadow-md transition-all cursor-pointer min-h-[48px]"
                  >
                    <span id="story-play-icon" class="text-lg">▶</span>
                    <span id="story-play-text">{lang === 'ta' ? 'கதையைக் கேட்க' : 'Listen to Story'}</span>
                  </button>

                  <div class="space-y-0.5">
                    <div class="flex items-center gap-2">
                      <span id="story-audio-status" class="text-xs font-bold text-[#0F766E] dark:text-[#2DD4BF]">
                        {lang === 'ta' ? 'தயாராக உள்ளது' : 'Ready'}
                      </span>
                      <span id="story-countdown-badge" class="hidden px-2.5 py-0.5 rounded-full bg-indigo-500/15 text-indigo-700 dark:text-indigo-300 font-mono text-xs font-bold border border-indigo-400/30 animate-pulse">
                        00:00
                      </span>
                    </div>
                    <p id="story-now-narrating" class="text-[11px] text-[#6B5644] dark:text-[#C8BFAF] line-clamp-1">
                      {lang === 'ta' ? 'ஆடியோவை இயக்கத் தொடங்க பொத்தானைத் தட்டவும்' : 'Tap to start clear voice narration'}
                    </p>
                  </div>
                </div>

                <!-- Speed Buttons (0.8x, 1x, 1.2x) -->
                <div class="flex items-center gap-1.5 self-end sm:self-center text-xs">
                  <span class="text-[#6B5644] dark:text-[#C8BFAF] font-semibold">{t.speed}:</span>
                  <button type="button" class="audio-speed-btn px-2.5 py-1.5 rounded-xl border border-[#EEDFC8] dark:border-[#383659] text-xs hover:border-[#0F766E] cursor-pointer" data-speed="0.8">0.8x</button>
                  <button type="button" class="audio-speed-btn px-2.5 py-1.5 rounded-xl border border-[#0F766E] bg-[#0F766E]/15 text-[#0F766E] font-bold text-xs cursor-pointer" data-speed="1.0">1.0x</button>
                  <button type="button" class="audio-speed-btn px-2.5 py-1.5 rounded-xl border border-[#EEDFC8] dark:border-[#383659] text-xs hover:border-[#0F766E] cursor-pointer" data-speed="1.2">1.2x</button>
                </div>
              </div>

              <!-- Bedtime & Travel Options Section (User-Requested Sleep Controls) -->
              <div class="p-4 rounded-2xl bg-white/80 dark:bg-[#1B1A2E]/80 border border-[#EEDFC8] dark:border-[#383659] space-y-3.5">
                
                <div class="flex items-center justify-between border-b border-[#EEDFC8]/60 dark:border-[#383659]/60 pb-2">
                  <span class="text-xs font-extrabold text-[#D97706] dark:text-[#F59E0B] flex items-center gap-1.5 uppercase tracking-wide">
                    <span>🌙</span> {lang === 'ta' ? 'இரவு தூக்கம் & பயணத் தொடர் அமைப்புகள்' : 'Bedtime & Travel Auto-Play Settings'}
                  </span>
                  <span class="text-[11px] text-[#6B5644] dark:text-[#C8BFAF]">
                    {lang === 'ta' ? 'நேரம் முடிந்ததும் மென்மையாக நின்றுவிடும்' : 'Soft fade-out on timer expiry'}
                  </span>
                </div>

                <!-- 1. Duration / Timer Selector -->
                <div class="space-y-1.5">
                  <label class="block text-xs font-bold text-[#3B2A1A] dark:text-[#F3EBDD]">
                    ⏱️ {lang === 'ta' ? 'வாசிக்கும் கால அளவு (ஸ்லீப் டைமர்):' : 'Playback Duration (Sleep Timer):'}
                  </label>
                  <div class="grid grid-cols-3 sm:grid-cols-6 gap-2 text-xs" id="bedtime-timer-group">
                    <button type="button" class="bedtime-timer-pill py-2 px-2.5 rounded-xl border border-[#0F766E] bg-[#0F766E] text-white font-bold text-center transition-all cursor-pointer" data-mins="0">
                      {lang === 'ta' ? '1 கதை மட்டும்' : 'Single Story'}
                    </button>
                    <button type="button" class="bedtime-timer-pill py-2 px-2.5 rounded-xl border border-[#EEDFC8] dark:border-[#383659] hover:border-[#0F766E] font-medium text-center transition-all cursor-pointer" data-mins="15">
                      {lang === 'ta' ? '15 நிமிடம்' : '15 min'}
                    </button>
                    <button type="button" class="bedtime-timer-pill py-2 px-2.5 rounded-xl border border-[#EEDFC8] dark:border-[#383659] hover:border-[#0F766E] font-medium text-center transition-all cursor-pointer" data-mins="30">
                      {lang === 'ta' ? '30 நிமிடம்' : '30 min'}
                    </button>
                    <button type="button" class="bedtime-timer-pill py-2 px-2.5 rounded-xl border border-[#EEDFC8] dark:border-[#383659] hover:border-[#0F766E] font-medium text-center transition-all cursor-pointer" data-mins="45">
                      {lang === 'ta' ? '45 நிமிடம்' : '45 min'}
                    </button>
                    <button type="button" class="bedtime-timer-pill py-2 px-2.5 rounded-xl border border-[#EEDFC8] dark:border-[#383659] hover:border-[#0F766E] font-medium text-center transition-all cursor-pointer" data-mins="60">
                      {lang === 'ta' ? '60 நிமிடம்' : '60 min'}
                    </button>
                    <button type="button" class="bedtime-timer-pill py-2 px-2.5 rounded-xl border border-[#EEDFC8] dark:border-[#383659] hover:border-[#0F766E] font-medium text-center transition-all cursor-pointer" data-mins="-1">
                      {lang === 'ta' ? 'தொடர்ந்து' : 'Infinite'}
                    </button>
                  </div>
                </div>

                <!-- 2. What to Read Checklist -->
                <div class="space-y-1.5 pt-1">
                  <label class="block text-xs font-bold text-[#3B2A1A] dark:text-[#F3EBDD]">
                    🎙️ {lang === 'ta' ? 'எதை எதை வாசிக்க வேண்டும்? (தேர்வு செய்க):' : 'What to Narrate (Checklist):'}
                  </label>
                  <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
                    <label class="flex items-center gap-2 p-2 rounded-xl bg-[#FFF8EC] dark:bg-[#1B1A2E] border border-[#EEDFC8] dark:border-[#383659] cursor-pointer">
                      <input type="checkbox" id="narrate-story-chk" checked disabled class="rounded text-[#0F766E] focus:ring-0" />
                      <span class="font-bold text-[#3B2A1A] dark:text-[#F3EBDD]">{lang === 'ta' ? '📖 கதை உரை' : '📖 Story Text'}</span>
                    </label>

                    <label class="flex items-center gap-2 p-2 rounded-xl bg-[#FFF8EC] dark:bg-[#1B1A2E] border border-[#EEDFC8] dark:border-[#383659] cursor-pointer hover:border-[#D97706]">
                      <input type="checkbox" id="narrate-moral-chk" class="rounded text-[#0F766E] focus:ring-0 cursor-pointer" />
                      <span class="font-medium text-[#3B2A1A] dark:text-[#F3EBDD]">{lang === 'ta' ? '💡 கதையின் நீதி' : '💡 Moral'}</span>
                    </label>

                    <label class="flex items-center gap-2 p-2 rounded-xl bg-[#FFF8EC] dark:bg-[#1B1A2E] border border-[#EEDFC8] dark:border-[#383659] cursor-pointer hover:border-[#D97706]">
                      <input type="checkbox" id="narrate-vocab-chk" class="rounded text-[#0F766E] focus:ring-0 cursor-pointer" />
                      <span class="font-medium text-[#3B2A1A] dark:text-[#F3EBDD]">{lang === 'ta' ? '📚 புதிய சொற்கள்' : '📚 Vocabulary'}</span>
                    </label>

                    <label class="flex items-center gap-2 p-2 rounded-xl bg-[#FFF8EC] dark:bg-[#1B1A2E] border border-[#EEDFC8] dark:border-[#383659] cursor-pointer hover:border-[#D97706]">
                      <input type="checkbox" id="narrate-questions-chk" class="rounded text-[#0F766E] focus:ring-0 cursor-pointer" />
                      <span class="font-medium text-[#3B2A1A] dark:text-[#F3EBDD]">{lang === 'ta' ? '❓ சிந்தனை வினாக்கள்' : '❓ Questions'}</span>
                    </label>
                  </div>
                </div>

                <!-- 3. Ambient Rain Sound & Natural Voice -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-2 border-t border-[#EEDFC8]/60 dark:border-[#383659]/60 text-xs">
                  <!-- Rain Ambience Button -->
                  <button
                    type="button"
                    id="toggle-rain-ambience-btn"
                    class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl border border-indigo-400/40 bg-indigo-50 dark:bg-indigo-950/40 text-indigo-900 dark:text-indigo-200 font-bold hover:bg-indigo-100 transition-all cursor-pointer"
                  >
                    <span>🌧️</span>
                    <span id="rain-ambience-label">{lang === 'ta' ? 'தாலாட்டு மழை ஒலி: ஆஃப்' : 'Sleep Rain Ambience: Off'}</span>
                  </button>

                  <!-- Voice Selector -->
                  <div class="flex items-center gap-2">
                    <span class="font-bold text-[#6B5644] dark:text-[#C8BFAF] shrink-0">🎙️ {lang === 'ta' ? 'குரல்:' : 'Voice:'}</span>
                    <select
                      id="story-voice-select"
                      class="px-2.5 py-1.5 rounded-xl bg-[#FFF8EC] dark:bg-[#1B1A2E] border border-[#EEDFC8] dark:border-[#383659] text-xs font-medium text-[#3B2A1A] dark:text-[#F3EBDD] focus:outline-none focus:ring-1 focus:ring-[#0F766E]"
                      aria-label="Narration Voice"
                    >
                      <option value="">{lang === 'ta' ? 'இயற்கையான குரல் (தானியங்கி)' : 'Auto-Detect Natural Voice'}</option>
                    </select>
                  </div>
                </div>

              </div>
            </section>

            <!-- Story Body Text (Ergonomic Typography 65-75ch, 19px base, 1.75 line-height) -->
            <div
              id="story-body-content"
              class="story-reading-content max-w-prose mx-auto lg:mx-0 text-[#3B2A1A] dark:text-[#F3EBDD] space-y-6 text-lg leading-relaxed pt-2"
              style="font-size: var(--story-font-size, 19px); line-height: var(--story-line-height, 1.75);"
            >
              {story.full_text.split('\n\n').map((paragraph: string) => (
                <p class="leading-[1.75] tracking-normal">{paragraph}</p>
              ))}
            </div>

            <!-- Highlighted Moral Card (Prominent & Always Visible for all Readers) -->
            <div id="story-moral-card" class={`p-6 rounded-3xl bg-[#D97706]/10 dark:bg-[#D97706]/20 border-2 border-[#D97706]/40 shadow-xs space-y-2 ${cleanMoral ? '' : 'hidden'}`}>
              <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#D97706] dark:text-[#F59E0B]">
                <span>💡</span>
                <span>{t.moral}</span>
              </div>
              <p id="story-moral-text" class="text-base sm:text-lg font-bold text-[#3B2A1A] dark:text-[#F3EBDD] leading-snug">
                {cleanMoral}
              </p>
            </div>

            <!-- Pedagogy & Learning Suite (School / Classroom Mode Only - Strictly hidden in General Mode) -->
            <div class="pedagogy-learning-suite space-y-6 pt-4">
              
              <!-- School Mode Classroom Hub Banner & Sharing -->
              <div class="p-4 sm:p-5 rounded-2xl bg-teal-50/80 dark:bg-teal-950/40 border border-teal-500/30 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs">
                <div class="space-y-1">
                  <div class="flex items-center gap-2 text-teal-800 dark:text-teal-300 font-bold">
                    <span class="text-base">🎓</span>
                    <span>{t.schoolLearningSuite || "School & Classroom Learning Suite"}</span>
                  </div>
                  <p class="text-teal-700/80 dark:text-teal-400/80 text-[11px]">
                    {t.pedagogyActive || "Pedagogical activities, moral reflection, vocabulary mastery, and quiz scoring active."}
                  </p>
                </div>
                <div class="flex items-center gap-2 w-full sm:w-auto shrink-0">
                  <button
                    type="button"
                    id="share-classroom-btn"
                    class="flex-1 sm:flex-none px-3.5 py-2 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold transition-all flex items-center justify-center gap-1.5 shadow-xs min-h-[36px]"
                    data-title={story.title}
                    data-url={canonicalUrl}
                  >
                    <span id="share-classroom-icon">📋</span>
                    <span id="share-classroom-text">{t.copyClassLink || "Copy Class Link"}</span>
                  </button>
                  <a
                    href={`https://api.whatsapp.com/send?text=${encodeURIComponent(
                      lang === 'ta'
                        ? `📚 வகுப்பறைக் கதை: ${story.title}\nகதையை வாசித்து வினாடி வினாவிற்கு விடையளிக்கவும்:\n${canonicalUrl}`
                        : `📚 Classroom Story: ${story.title}\nRead the story and answer the quiz here:\n${canonicalUrl}`
                    )}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold transition-all flex items-center justify-center gap-1.5 shadow-xs min-h-[36px]"
                  >
                    <span>💬</span>
                    <span>WhatsApp</span>
                  </a>
                  <a
                    href={`/${currentLang}/classroom/`}
                    class="px-3.5 py-2 rounded-xl border border-teal-600 text-teal-700 dark:text-teal-300 hover:bg-teal-600/10 font-bold transition-all flex items-center justify-center gap-1 min-h-[36px]"
                  >
                    <span>{lang === 'ta' ? 'மேசை' : 'Desk'}</span>
                    <span>→</span>
                  </a>
                </div>
              </div>

              <!-- Interactive Collapsible Sections: Discuss, Vocabulary, Quiz (Hidden in General Mode) -->
              <div id="story-pedagogy-sections" class="space-y-4">
                
                <!-- Section 1: Think & Talk (Bloom's Taxonomy) -->
                <div id="story-discuss-container">
                  {story.discussion_questions && story.discussion_questions.length > 0 && (
                    <details class="group rounded-2xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] p-5 transition-all">
                      <summary class="flex items-center justify-between cursor-pointer font-bold text-base text-[#3B2A1A] dark:text-[#F3EBDD] select-none">
                        <span class="flex items-center gap-2.5">
                          <span>💬</span> {t.discuss}
                        </span>
                        <span class="text-xs transition-transform group-open:rotate-180">▼</span>
                      </summary>
                      <div class="pt-4 space-y-3 text-sm text-[#6B5644] dark:text-[#C8BFAF]">
                        {story.discussion_questions.map(q => (
                          <div class="p-3 rounded-xl bg-[#FFF8EC] dark:bg-[#1B1A2E] border border-[#EEDFC8]/60 dark:border-[#383659]/60">
                            <span class="text-xs font-bold text-[#D97706] uppercase">{q.tier || q.type}:</span>
                            <p class="mt-0.5 text-[#3B2A1A] dark:text-[#F3EBDD] font-medium">{q.prompt || q.question}</p>
                          </div>
                        ))}
                      </div>
                    </details>
                  )}
                </div>

                <!-- Section 2: Words to Learn (Vocabulary) -->
                <div id="story-vocab-container">
                  {story.vocabulary && story.vocabulary.length > 0 && (
                    <details class="group rounded-2xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] p-5 transition-all">
                      <summary class="flex items-center justify-between cursor-pointer font-bold text-base text-[#3B2A1A] dark:text-[#F3EBDD] select-none">
                        <span class="flex items-center gap-2.5">
                          <span>📚</span> {t.vocabulary}
                        </span>
                        <span class="text-xs transition-transform group-open:rotate-180">▼</span>
                      </summary>
                      <div class="pt-4 grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-sm">
                        {story.vocabulary.map(v => (
                          <div class="p-3 rounded-xl bg-[#FFF8EC] dark:bg-[#1B1A2E] border border-[#EEDFC8]/60 dark:border-[#383659]/60">
                            <strong class="text-[#0F766E] dark:text-[#2DD4BF]">{v.word}</strong>
                            <p class="text-xs text-[#6B5644] dark:text-[#C8BFAF] mt-0.5">{v.meaning}</p>
                          </div>
                        ))}
                      </div>
                    </details>
                  )}
                </div>

                <!-- Section 3: Quick Quiz Challenge -->
                <div id="story-quiz-container-wrapper">
                  {story.quiz && story.quiz.length > 0 && (
                    <details open class="group rounded-2xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] p-5 transition-all">
                      <summary class="flex items-center justify-between cursor-pointer font-bold text-base text-[#3B2A1A] dark:text-[#F3EBDD] select-none">
                        <span class="flex items-center gap-2.5">
                          <span>🎯</span> {t.quiz}
                        </span>
                        <span class="text-xs transition-transform group-open:rotate-180">▼</span>
                      </summary>
                      <div class="pt-4 space-y-4" id="story-quiz-container" data-total-questions={story.quiz.length} data-story-title={story.title}>
                        <!-- Real-Time Quiz Score Banner (Injected on Completion) -->
                        <div id="quiz-completion-banner" class="hidden p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-500/40 text-emerald-800 dark:text-emerald-200 text-xs font-bold flex items-center justify-between">
                          <div class="flex items-center gap-2">
                            <span class="text-lg">🎉</span>
                            <span id="quiz-completion-text">{t.quizComplete || "Quiz Complete!"}</span>
                          </div>
                          <a href={`/${currentLang}/classroom/`} class="underline text-emerald-700 dark:text-emerald-300">
                            {currentLang === 'ta' ? 'வகுப்பறைப் பலகையைக் காண்க →' : (currentLang === 'hi' ? 'कक्षा बोर्ड देखें →' : 'View Classroom Board →')}
                          </a>
                        </div>

                        {story.quiz.map((q, qIdx) => (
                          <div class="quiz-question-card p-4 rounded-xl bg-[#FFF8EC] dark:bg-[#1B1A2E] border border-[#EEDFC8]/60 dark:border-[#383659]/60 space-y-3" data-qindex={qIdx}>
                            <p class="text-sm font-bold text-[#3B2A1A] dark:text-[#F3EBDD]">
                              {qIdx + 1}. {q.question}
                            </p>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                              {q.options.map((opt: string, optIdx: number) => (
                                <button
                                  type="button"
                                  class="quiz-option-btn p-3 rounded-xl border border-[#EEDFC8] dark:border-[#383659] bg-white dark:bg-[#25243E] hover:border-[#D97706] text-xs font-semibold text-start text-[#3B2A1A] dark:text-[#F3EBDD] transition-all flex items-center justify-between min-h-[44px]"
                                  data-question-idx={qIdx}
                                  data-option-idx={optIdx}
                                  data-is-correct={optIdx === q.answerIndex ? 'true' : 'false'}
                                  data-correct={optIdx === q.answerIndex ? 'true' : 'false'}
                                  data-hint={q.hint}
                                >
                                  <span>{opt}</span>
                                  <span class="quiz-feedback-icon hidden"></span>
                                </button>
                              ))}
                            </div>
                          </div>
                        ))}
                      </div>
                    </details>
                  )}
                </div>

              </div>
            </div>
          </div>

        <!-- Social Share & Favourite Action Bar -->
        <div class="pt-6 border-t border-[#EEDFC8] dark:border-[#383659] flex flex-wrap items-center justify-between gap-4">
          <!-- Favourite Button -->
          <button
            type="button"
            id="favourite-story-btn"
            data-story-id={story.id}
            data-story-title={story.title}
            data-story-url={canonicalUrl}
            class="px-5 py-2.5 rounded-full border border-[#D97706] bg-[#D97706]/10 text-[#D97706] dark:text-[#F59E0B] font-bold text-xs sm:text-sm flex items-center gap-2 hover:bg-[#D97706]/20 transition-all min-h-[48px]"
          >
            <span id="fav-icon">⭐</span>
            <span id="fav-label">{t.favourite}</span>
          </button>

          <!-- Share Links -->
          <div class="flex items-center gap-2 text-xs font-bold">
            <span class="text-[#6B5644] dark:text-[#C8BFAF]">{t.share}:</span>
            <a
              id="share-whatsapp-link"
              href={`https://api.whatsapp.com/send?text=${encodeURIComponent(
                lang === 'ta'
                  ? `${cleanTitle} – தினம் ஒரு கதையில் வாசியுங்கள்: ${canonicalUrl}`
                  : `${cleanTitle} - Read on Daily Tale: ${canonicalUrl}`
              )}`}
              target="_blank"
              rel="noopener noreferrer"
              class="p-2.5 rounded-xl border border-[#EEDFC8] dark:border-[#383659] hover:border-green-600 hover:text-green-600 transition-all flex items-center justify-center min-w-[44px] min-h-[44px]"
              title="Share on WhatsApp"
            >
              💬 WhatsApp
            </a>
            <a
              id="share-twitter-link"
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(story.title)}&url=${encodeURIComponent(canonicalUrl)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="p-2.5 rounded-xl border border-[#EEDFC8] dark:border-[#383659] hover:border-blue-400 hover:text-blue-400 transition-all flex items-center justify-center min-w-[44px] min-h-[44px]"
              title="Share on X"
            >
              𝕏
            </a>
            <button
              type="button"
              id="copy-link-btn"
              data-url={canonicalUrl}
              class="p-2.5 rounded-xl border border-[#EEDFC8] dark:border-[#383659] hover:border-[#D97706] transition-all flex items-center justify-center min-w-[44px] min-h-[44px]"
              title="Copy Story Link"
            >
              🔗 Copy
            </button>
          </div>
        </div>

        <!-- Story Pagination: Previous Story & Next Story -->
        <nav aria-label="Story Navigation" class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-6">
          <a
            id="story-nav-prev-link"
            href={prevStory ? getStoryUrl(prevStory, lang || 'en') : `/${currentLang}/collections/${colSlug}/`}
            class="p-4 rounded-2xl border border-[#EEDFC8] dark:border-[#383659] hover:border-[#D97706] transition-all text-start group space-y-1"
          >
            <span class="text-xs text-[#6B5644] dark:text-[#C8BFAF] flex items-center gap-1 group-hover:text-[#D97706]">
              ← {t.previous}
            </span>
            <p id="story-nav-prev-title" class="text-xs sm:text-sm font-bold text-[#3B2A1A] dark:text-[#F3EBDD] line-clamp-1">
              {prevStory ? prevStory.title : story.collection}
            </p>
          </a>

          <a
            id="story-nav-next-link"
            href={nextStory ? getStoryUrl(nextStory, lang || 'en') : `/${currentLang}/collections/${colSlug}/`}
            class="p-4 rounded-2xl border border-[#EEDFC8] dark:border-[#383659] hover:border-[#D97706] transition-all text-end group space-y-1"
          >
            <span class="text-xs text-[#6B5644] dark:text-[#C8BFAF] flex items-center justify-end gap-1 group-hover:text-[#D97706]">
              {t.next} →
            </span>
            <p id="story-nav-next-title" class="text-xs sm:text-sm font-bold text-[#3B2A1A] dark:text-[#F3EBDD] line-clamp-1">
              {nextStory ? nextStory.title : story.collection}
            </p>
          </a>
        </nav>

        <!-- Related Stories from the Same Collection (Deep Crawlable Internal Links) -->
        {relatedStories.length > 0 && (
          <section class="pt-8 border-t border-[#EEDFC8] dark:border-[#383659] space-y-4">
            <div class="flex items-center justify-between">
              <h2 id="story-related-heading" class="text-base sm:text-lg font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD]">
                {currentLang === 'ta' ? `மேலும் ${localizedColName}:` : `More Stories from ${story.collection}:`}
              </h2>
              <a id="story-related-all-link" href={`/${currentLang}/collections/${colSlug}/`} class="text-xs font-bold text-[#D97706] hover:underline">
                {currentLang === 'ta' ? 'அனைத்து கதைகளும் →' : 'View Collection →'}
              </a>
            </div>

            <div id="story-related-stories-container" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {relatedStories.map(rel => (
                <a
                  href={getStoryUrl(rel, currentLang)}
                  class="p-4 rounded-2xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] hover:border-[#D97706] hover:shadow-md transition-all group flex items-start gap-3"
                >
                  <span class="text-xl shrink-0" aria-hidden="true">📖</span>
                  <div class="space-y-1">
                    <h3 class="text-xs sm:text-sm font-bold text-[#3B2A1A] dark:text-[#F3EBDD] group-hover:text-[#D97706] transition-colors line-clamp-1">
                      {rel.title}
                    </h3>
                    <p class="text-[11px] text-[#6B5644] dark:text-[#C8BFAF] line-clamp-1">
                      {cleanStorySummary(rel.summary)}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

      </article>

      <!-- Right Companion Panel on PC (1024px+ Sticky Column) -->
      <aside class="hidden lg:block lg:col-span-4 sticky top-24 space-y-6">
        
        <!-- Desktop Audio Player Card -->
        <div class="p-6 rounded-3xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] shadow-sm space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-[#0F766E] dark:text-[#2DD4BF] flex items-center gap-1.5">
                <span>🎧</span> {lang === 'ta' ? 'ஒலி வடிவம்' : 'Audio Narration'}
              </span>
              <span id="desktop-audio-status" class="text-xs text-[#6B5644] dark:text-[#C8BFAF]">{lang === 'ta' ? 'தயார்' : 'Ready'}</span>
            </div>

            <button
              type="button"
              id="desktop-audio-play-btn"
              class="w-full py-3 rounded-2xl bg-[#0F766E] hover:bg-[#0D655E] text-white font-bold flex items-center justify-center gap-2 shadow-md transition-all min-h-[48px]"
            >
              <span id="desktop-play-icon">▶</span>
              <span id="desktop-play-text">{t.listen}</span>
            </button>

            <!-- Natural Voice Selection -->
            <div class="space-y-1.5 pt-1">
              <div class="flex items-center justify-between text-xs">
                <span class="text-[#6B5644] dark:text-[#C8BFAF] font-semibold flex items-center gap-1">
                  <span>🎙️</span> {lang === 'ta' ? 'இயற்கையான குரல்:' : 'Natural Voice:'}
                </span>
                <span id="desktop-voice-badge" class="px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 font-bold text-[10px]">
                  ✨ {lang === 'ta' ? 'இயற்கை' : 'Natural'}
                </span>
              </div>
              <select
                id="desktop-voice-select"
                class="w-full px-3 py-2 rounded-xl bg-[#FFF8EC] dark:bg-[#1B1A2E] border border-[#EEDFC8] dark:border-[#383659] text-xs font-medium text-[#3B2A1A] dark:text-[#F3EBDD] focus:outline-none focus:ring-2 focus:ring-[#0F766E]"
                aria-label={lang === 'ta' ? 'வாசிக்கும் குரலைத் தேர்ந்தெடுக்கவும்' : 'Select Narration Voice'}
              >
                <option value="">{lang === 'ta' ? 'இயற்கையான குரல் (தானியங்கி)' : 'Auto-Detect Natural Voice'}</option>
              </select>
            </div>

            <!-- Speed Controls -->
            <div class="flex items-center justify-between text-xs pt-1 border-t border-[#EEDFC8]/60 dark:border-[#383659]/60">
              <span class="text-[#6B5644] dark:text-[#C8BFAF] font-semibold">{t.speed}:</span>
              <div class="flex items-center gap-1.5">
                <button type="button" class="audio-speed-btn px-2.5 py-1 rounded-lg border border-[#EEDFC8] dark:border-[#383659] text-xs hover:border-[#0F766E]" data-speed="0.8">0.8x</button>
                <button type="button" class="audio-speed-btn px-2.5 py-1 rounded-lg border border-[#0F766E] bg-[#0F766E]/15 text-[#0F766E] font-bold text-xs" data-speed="1.0">1.0x</button>
                <button type="button" class="audio-speed-btn px-2.5 py-1 rounded-lg border border-[#EEDFC8] dark:border-[#383659] text-xs hover:border-[#0F766E]" data-speed="1.2">1.2x</button>
              </div>
            </div>
          </div>

        <!-- Quick Reader Controls Card (Aa Settings) -->
        <div class="p-6 rounded-3xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] shadow-sm space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[#6B5644] dark:text-[#C8BFAF]">
              {lang === 'ta' ? 'வசதியான வாசிப்பு' : 'Comfort Reading'}
            </span>
            <button
              type="button"
              data-open-aa-panel
              class="text-xs font-bold text-[#D97706] hover:underline"
            >
              {lang === 'ta' ? 'அனைத்து அமைப்புகளும் (Aa) →' : 'All Settings (Aa) →'}
            </button>
          </div>

          <p class="text-xs text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
            {lang === 'ta'
              ? 'எழுத்து அளவு, வரி இடைவெளி, பின்னணி நிறம் மற்றும் தெளிவான எழுத்துருவை மாற்றியமைக்கலாம்.'
              : 'Adjust font size, spacing, contrast, and OpenDyslexic mode anytime.'}
          </p>
        </div>

        <!-- Keyboard Shortcuts Helper Card -->
        <div class="p-5 rounded-2xl bg-[#FFF8EC] dark:bg-[#1B1A2E] border border-[#EEDFC8] dark:border-[#383659] text-xs space-y-2">
          <span class="font-bold text-[#3B2A1A] dark:text-[#F3EBDD] uppercase tracking-wider block">
            ⌨️ {t.keyboardShortcuts}
          </span>
          <div class="grid grid-cols-2 gap-2 text-[#6B5644] dark:text-[#C8BFAF]">
            <div><kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] font-mono">Space</kbd> {lang === 'ta' ? 'ஒலி இயக்கு/நிறுத்து' : 'Play/Pause'}</div>
            <div><kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] font-mono">/</kbd> {lang === 'ta' ? 'தேடுக' : 'Search'}</div>
            <div><kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] font-mono">→</kbd> {lang === 'ta' ? 'அடுத்த கதை' : 'Next Story'}</div>
            <div><kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] font-mono">←</kbd> {lang === 'ta' ? 'முந்தைய கதை' : 'Prev Story'}</div>
          </div>
        </div>

        <!-- More in this Collection (Sidebar Quick Jump) -->
        {relatedStories.length > 0 && (
          <div class="p-5 rounded-3xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] shadow-xs space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-[#D97706] dark:text-[#F59E0B] flex items-center gap-1.5">
                <span>📚</span> {story.collection}
              </span>
              <a href={`/${currentLang}/collections/${colSlug}/`} class="text-[11px] font-bold text-[#D97706] hover:underline">
                {currentLang === 'ta' ? 'அனைத்தும் →' : 'All →'}
              </a>
            </div>
            <div class="space-y-2">
              {relatedStories.slice(0, 4).map(rel => (
                <a
                  href={getStoryUrl(rel, currentLang)}
                  class="p-2.5 rounded-xl bg-[#FFF8EC]/60 dark:bg-[#1B1A2E]/60 border border-[#EEDFC8]/60 dark:border-[#383659]/60 hover:border-[#D97706] transition-all flex items-center gap-2.5 group"
                >
                  <span class="text-base shrink-0">📖</span>
                  <div class="min-w-0 flex-1">
                    <p class="text-xs font-bold text-[#3B2A1A] dark:text-[#F3EBDD] group-hover:text-[#D97706] transition-colors truncate">
                      {rel.title}
                    </p>
                    <span class="text-[10px] text-[#6B5644] dark:text-[#C8BFAF]">
                      ⏱ {rel.reading_time || '2 min'}
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

      </aside>

    </div>

  </div>

  <!-- Mobile Sticky Bottom Reader Bar (Previous | Listen | Aa | Next) -->
  <aside
    class="md:hidden fixed bottom-16 inset-x-0 z-40 bg-white/95 dark:bg-[#1B1A2E]/95 backdrop-blur-md border-t border-[#EEDFC8] dark:border-[#383659] px-4 py-2 shadow-lg"
    aria-label="Story Quick Controls"
  >
    <div class="max-w-md mx-auto flex items-center justify-between gap-2">
      <a
        id="mobile-nav-prev-link"
        href={prevStory ? getStoryUrl(prevStory, lang || 'en') : `/${currentLang}/collections/${colSlug}/`}
        class="p-2 rounded-xl text-xs font-bold text-[#6B5644] dark:text-[#C8BFAF] hover:text-[#D97706] flex items-center gap-1 min-h-[44px]"
      >
        <span>←</span> <span id="mobile-nav-prev-text">{t.previous}</span>
      </a>

      {isTranslated ? (
        <button
          type="button"
          id="bottom-bar-audio-btn"
          class="px-4 py-2 rounded-full bg-[#0F766E] text-white font-bold text-xs flex items-center gap-1.5 shadow min-h-[44px]"
        >
          <span>▶</span>
          <span>{t.listen}</span>
        </button>
      ) : (
        <a
          href={`/en/${colSlug}/${story.slug.replace(new RegExp(`-${currentLang}$`), '')}/`}
          class="px-3 py-1.5 rounded-full bg-[#D97706] text-white font-bold text-[11px] flex items-center gap-1 shadow min-h-[40px]"
        >
          <span>🌐</span>
          <span>English</span>
        </a>
      )}

      <button
        type="button"
        data-open-aa-panel
        class="p-2 rounded-xl border border-[#EEDFC8] dark:border-[#383659] text-xs font-bold min-h-[44px] min-w-[44px] flex items-center justify-center font-serif"
      >
        Aa
      </button>

      <a
        id="mobile-nav-next-link"
        href={nextStory ? getStoryUrl(nextStory, lang || 'en') : `/${currentLang}/collections/${colSlug}/`}
        class="p-2 rounded-xl text-xs font-bold text-[#6B5644] dark:text-[#C8BFAF] hover:text-[#D97706] flex items-center gap-1 min-h-[44px]"
      >
        <span id="mobile-nav-next-text">{t.next}</span> <span>→</span>
      </a>
    </div>
  </aside>
</BaseLayout>

<script is:inline>
  // 0. Universal Hydration & Dynamic Story Loader
  (async function hydrateStory() {
    let payload = null;
    const payloadEl = document.getElementById('initial-story-payload');
    if (payloadEl && payloadEl.textContent) {
      try {
        payload = JSON.parse(payloadEl.textContent);
      } catch (e) {}
    }

    const pathParts = window.location.pathname.split('/').filter(Boolean);
    const urlLang = pathParts[0] || 'en';
    const urlCol = pathParts[1] || '';
    const urlSlug = pathParts[2] || '';

    // Fallback: If payload wasn't pre-injected (e.g. running under dev preview or direct static shell)
    if (!payload && urlCol && urlSlug && urlSlug !== 'story') {
      try {
        const res = await fetch(`/data/collections/${urlLang}_${urlCol}.json`);
        if (res.ok) {
          const stories = await res.json();
          payload = stories.find(s => s.slug === urlSlug);
        }
      } catch (e) {}
    }

    if (payload) {
      window.__CURRENT_STORY_DATA = payload;
      const cleanTitle = (payload.title || '').replace(/\s*\[[A-Za-z]{2}\]/g, '').trim();
      const cleanSummary = (payload.summary || '').trim();
      const cleanMoral = (payload.moral || '').trim();

      document.title = `${cleanTitle} | Daily Tale`;
      const h1 = document.getElementById('story-main-title');
      if (h1) h1.textContent = cleanTitle;

      const summaryEl = document.getElementById('story-summary-text');
      if (summaryEl) summaryEl.textContent = cleanSummary;

      const bodyEl = document.getElementById('story-body-content');
      if (bodyEl && payload.full_text) {
        bodyEl.innerHTML = payload.full_text
          .split(/\n\n+/)
          .map(p => `<p class="leading-[1.75] tracking-normal mb-6">${p}</p>`)
          .join('');
      }

      const moralCard = document.getElementById('story-moral-card');
      const moralEl = document.getElementById('story-moral-text');
      if (moralCard && moralEl) {
        if (cleanMoral) {
          moralEl.textContent = cleanMoral;
          moralCard.classList.remove('hidden');
        } else {
          moralCard.classList.add('hidden');
        }
      }

      // Populate Pedagogy: Vocabulary, Think & Talk, Quiz
      if (typeof hydratePedagogy === 'function') {
        hydratePedagogy(payload, urlLang);
      }

      // Sync Social Share, Favourite & Copy Link
      const canUrl = window.location.href;
      const favBtn = document.getElementById('favourite-story-btn');
      if (favBtn) {
        favBtn.setAttribute('data-story-id', String(payload.id || urlSlug));
        favBtn.setAttribute('data-story-title', cleanTitle);
        favBtn.setAttribute('data-story-url', canUrl);
      }
      const waLink = document.getElementById('share-whatsapp-link');
      if (waLink) {
        const waMsg = urlLang === 'ta'
          ? `${cleanTitle} – தினம் ஒரு கதையில் வாசியுங்கள்: ${canUrl}`
          : `${cleanTitle} - Read on Daily Tale: ${canUrl}`;
        waLink.setAttribute('href', `https://api.whatsapp.com/send?text=${encodeURIComponent(waMsg)}`);
      }
      const twLink = document.getElementById('share-twitter-link');
      if (twLink) {
        twLink.setAttribute('href', `https://twitter.com/intent/tweet?text=${encodeURIComponent(cleanTitle)}&url=${encodeURIComponent(canUrl)}`);
      }
      const cpBtn = document.getElementById('copy-link-btn');
      if (cpBtn) {
        cpBtn.setAttribute('data-url', canUrl);
      }
    }

    // Always fetch collection playlist for auto-advance narration and pagination
    if (urlCol && urlCol !== 'story') {
      try {
        if (!collectionPlaylist || collectionPlaylist.length === 0) {
          const res = await fetch(`/data/collections/${urlLang}_${urlCol}.json`);
          if (res.ok) {
            collectionPlaylist = await res.json();
          }
        }
        if (collectionPlaylist && collectionPlaylist.length > 0) {
          const curSlug = window.location.pathname.split('/').filter(Boolean).pop() || '';
          const sIdx = collectionPlaylist.findIndex(s => s.slug === curSlug);
          if (sIdx !== -1) {
            currentPlaylistIdx = sIdx;
            const prev = sIdx > 0 ? collectionPlaylist[sIdx - 1] : null;
            const next = sIdx < collectionPlaylist.length - 1 ? collectionPlaylist[sIdx + 1] : null;

            const prevLink = document.getElementById('story-nav-prev-link');
            const prevTitle = document.getElementById('story-nav-prev-title');
            if (prevLink && prev) {
              prevLink.setAttribute('href', `/${urlLang}/${urlCol}/${prev.slug}/`);
              if (prevTitle) prevTitle.textContent = (prev.title || '').replace(/\s*\[[A-Za-z]{2}\]/g, '').trim();
            }

            const nextLink = document.getElementById('story-nav-next-link');
            const nextTitle = document.getElementById('story-nav-next-title');
            if (nextLink && next) {
              nextLink.setAttribute('href', `/${urlLang}/${urlCol}/${next.slug}/`);
              if (nextTitle) nextTitle.textContent = (next.title || '').replace(/\s*\[[A-Za-z]{2}\]/g, '').trim();
            }

            const mPrev = document.getElementById('mobile-nav-prev-link');
            if (mPrev && prev) mPrev.setAttribute('href', `/${urlLang}/${urlCol}/${prev.slug}/`);
            const mNext = document.getElementById('mobile-nav-next-link');
            if (mNext && next) mNext.setAttribute('href', `/${urlLang}/${urlCol}/${next.slug}/`);
          }
        }
      } catch (e) {}
    }
  })();

  // 1. Reading Progress Bar
  const progressBar = document.getElementById('reading-progress-bar');
  window.addEventListener('scroll', () => {
    const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
    if (totalHeight > 0) {
      const progress = window.scrollY / totalHeight;
      progressBar.style.transform = `scaleX(${progress})`;
    }
  }, { passive: true });

  // 2. Save Last-Read Story to localStorage for "Continue Reading"
  try {
    const historyItem = {
      title: document.title.replace(' — Daily Tale', ''),
      url: window.location.pathname,
      date: new Date().toISOString()
    };
    localStorage.setItem('dailytale_last_read', JSON.stringify(historyItem));
  } catch(e) {}

  // 3. Web Speech API Audio & Continuous Bedtime Narration Engine
  let speechUtterance = null;
  let isSpeaking = false;
  let isPaused = false;
  let playbackSpeed = 1.0;
  let selectedVoiceName = '';
  let speechQueue = [];
  let currentChunkIdx = 0;

  // Bedtime Duration & Timer State
  let selectedDurationMins = 0; // 0 = Single Story, >0 = minutes, -1 = infinite
  let timerInterval = null;
  let remainingSeconds = 0;
  let currentPlaylistIdx = 0;
  let collectionPlaylist = [];

  const langCode = document.documentElement.lang || 'en';
  const lPrefix = langCode.toLowerCase().slice(0, 2);
  const isTa = lPrefix === 'ta';

  const bcp47Map = {
    ta: 'ta-IN',
    hi: 'hi-IN',
    en: 'en-US',
    zh: 'zh-CN',
    ml: 'ml-IN',
    te: 'te-IN',
    kn: 'kn-IN',
    mr: 'mr-IN',
    ur: 'ur-PK'
  };
  const targetBcp47 = bcp47Map[lPrefix] || langCode;

  // Load Inlined Collection Playlist
  try {
    const plEl = document.getElementById('story-collection-playlist');
    if (plEl && plEl.textContent) {
      collectionPlaylist = JSON.parse(plEl.textContent);
    }
  } catch(e) {
    collectionPlaylist = [];
  }

  // Find index of current story in playlist
  const currentSlug = window.location.pathname.split('/').filter(Boolean).pop() || '';
  const initialIdx = collectionPlaylist.findIndex(s => s.slug === currentSlug);
  if (initialIdx !== -1) {
    currentPlaylistIdx = initialIdx;
  }

  // Web Audio Procedural Rain Ambience Synthesizer (100% Offline, Zero Bandwidth)
  let audioCtx = null;
  let rainGain = null;
  let rainSource = null;
  let isRainPlaying = false;

  function initRainSynthesizer() {
    if (audioCtx) return;
    try {
      const AudioContext = window.AudioContext || window.webkitAudioContext;
      audioCtx = new AudioContext();

      // Generate 2 seconds of pink/brown noise buffer
      const bufferSize = audioCtx.sampleRate * 2;
      const noiseBuffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
      const output = noiseBuffer.getChannelData(0);
      let b0 = 0, b1 = 0, b2 = 0, b3 = 0, b4 = 0, b5 = 0, b6 = 0;

      for (let i = 0; i < bufferSize; i++) {
        const white = Math.random() * 2 - 1;
        b0 = 0.99886 * b0 + white * 0.0555179;
        b1 = 0.99332 * b1 + white * 0.0750759;
        b2 = 0.96900 * b2 + white * 0.1538520;
        b3 = 0.86650 * b3 + white * 0.3104856;
        b4 = 0.55000 * b4 + white * 0.5329522;
        b5 = -0.7616 * b5 - white * 0.0168980;
        output[i] = (b0 + b1 + b2 + b3 + b4 + b5 + b6 + white * 0.5362) * 0.04;
        b6 = white * 0.115926;
      }

      rainSource = audioCtx.createBufferSource();
      rainSource.buffer = noiseBuffer;
      rainSource.loop = true;

      // Lowpass filter at 450Hz for gentle calming rain
      const filter = audioCtx.createBiquadFilter();
      filter.type = 'lowpass';
      filter.frequency.setValueAtTime(450, audioCtx.currentTime);

      rainGain = audioCtx.createGain();
      rainGain.gain.setValueAtTime(0.01, audioCtx.currentTime);

      rainSource.connect(filter);
      filter.connect(rainGain);
      rainGain.connect(audioCtx.destination);
      rainSource.start(0);
    } catch(err) {
      console.warn('Web Audio rain unavailable:', err);
    }
  }

  function setRainActive(active) {
    initRainSynthesizer();
    isRainPlaying = active;
    const btn = document.getElementById('toggle-rain-ambience-btn');
    const label = document.getElementById('rain-ambience-label');

    if (rainGain && audioCtx) {
      if (audioCtx.state === 'suspended') audioCtx.resume();
      const targetGain = active ? 0.35 : 0.0001;
      rainGain.gain.setTargetAtTime(targetGain, audioCtx.currentTime, 0.4);
    }

    if (btn) {
      if (active) {
        btn.classList.add('bg-indigo-600', 'text-white', 'border-indigo-600');
        btn.classList.remove('bg-indigo-50', 'text-indigo-900', 'dark:bg-indigo-950/40', 'dark:text-indigo-200');
        if (label) label.textContent = isTa ? 'தாலாட்டு மழை ஒலி: ஆன் (இயங்குகிறது)' : 'Sleep Rain Ambience: On';
      } else {
        btn.classList.remove('bg-indigo-600', 'text-white', 'border-indigo-600');
        btn.classList.add('bg-indigo-50', 'text-indigo-900', 'dark:bg-indigo-950/40', 'dark:text-indigo-200');
        if (label) label.textContent = isTa ? 'தாலாட்டு மழை ஒலி: ஆஃப்' : 'Sleep Rain Ambience: Off';
      }
    }
  }

  document.getElementById('toggle-rain-ambience-btn')?.addEventListener('click', () => {
    setRainActive(!isRainPlaying);
  });

  // Score voice based on naturalness and language match
  function scoreVoice(voice, targetLang) {
    const vLang = (voice.lang || '').toLowerCase().replace('_', '-');
    const tLang = (targetLang || 'en').toLowerCase().replace('_', '-');
    const prefix = tLang.slice(0, 2);
    let score = 0;

    if (vLang === tLang) {
      score += 150;
    } else if (vLang.startsWith(prefix)) {
      score += 100;
    } else {
      return 10; // Allow fallback to any system voice
    }

    const name = (voice.name || '').toLowerCase();
    if (name.includes('natural')) score += 120;
    if (name.includes('online')) score += 100;
    if (name.includes('neural')) score += 90;
    if (name.includes('enhanced')) score += 80;
    if (name.includes('google')) score += 70;
    if (name.includes('siri')) score += 60;
    if (name.includes('desktop')) score -= 30;

    return score;
  }

  function getSortedVoices() {
    if (!('speechSynthesis' in window)) return [];
    const all = window.speechSynthesis.getVoices();
    return all
      .map(v => ({ voice: v, score: scoreVoice(v, targetBcp47) }))
      .sort((a, b) => b.score - a.score);
  }

  function initVoiceSelectors() {
    if (!('speechSynthesis' in window)) return;
    const candidates = getSortedVoices();
    const selectElements = [
      document.getElementById('story-voice-select'),
      document.getElementById('desktop-voice-select')
    ].filter(Boolean);

    if (!selectElements.length) return;

    const savedVoice = localStorage.getItem('dailytale_voice_' + lPrefix);
    const bestCandidate = candidates[0]?.voice;

    selectElements.forEach(sel => {
      sel.innerHTML = '';
      if (!candidates.length) {
        const opt = document.createElement('option');
        opt.value = '';
        opt.textContent = isTa ? 'சாதனக் குரல் (தானியங்கி)' : 'Default Device Voice';
        sel.appendChild(opt);
        return;
      }

      candidates.forEach(({ voice, score }) => {
        const opt = document.createElement('option');
        opt.value = voice.name;
        const isNatural = score >= 120;
        opt.textContent = (isNatural ? '✨ ' : '') + voice.name + ` (${voice.lang})`;
        sel.appendChild(opt);
      });

      if (savedVoice && candidates.some(c => c.voice.name === savedVoice)) {
        sel.value = savedVoice;
        selectedVoiceName = savedVoice;
      } else if (bestCandidate) {
        sel.value = bestCandidate.name;
        selectedVoiceName = bestCandidate.name;
      }

      sel.onchange = () => {
        selectedVoiceName = sel.value;
        localStorage.setItem('dailytale_voice_' + lPrefix, sel.value);
        selectElements.forEach(s => { if (s !== sel) s.value = sel.value; });
        if (isSpeaking) {
          restartSpeech();
        }
      };
    });
  }

  if ('speechSynthesis' in window) {
    initVoiceSelectors();
    window.speechSynthesis.onvoiceschanged = initVoiceSelectors;
  }

  // Duration Timer Setup (Pills)
  const timerGroup = document.getElementById('bedtime-timer-group');
  if (timerGroup) {
    timerGroup.querySelectorAll('.bedtime-timer-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        timerGroup.querySelectorAll('.bedtime-timer-pill').forEach(p => {
          p.classList.remove('border-[#0F766E]', 'bg-[#0F766E]', 'text-white', 'font-bold');
          p.classList.add('border-[#EEDFC8]', 'dark:border-[#383659]', 'font-medium');
        });
        pill.classList.add('border-[#0F766E]', 'bg-[#0F766E]', 'text-white', 'font-bold');
        pill.classList.remove('border-[#EEDFC8]', 'dark:border-[#383659]', 'font-medium');

        selectedDurationMins = parseInt(pill.getAttribute('data-mins') || '0', 10);
        if (isSpeaking && selectedDurationMins > 0) {
          startCountdown(selectedDurationMins * 60);
        }
      });
    });
  }

  function startCountdown(seconds) {
    clearInterval(timerInterval);
    remainingSeconds = seconds;
    const badge = document.getElementById('story-countdown-badge');
    if (badge) badge.classList.remove('hidden');

    updateCountdownDisplay();
    timerInterval = setInterval(() => {
      remainingSeconds--;
      updateCountdownDisplay();

      // Soft Fade-out when 8 seconds remaining
      if (remainingSeconds <= 8 && remainingSeconds > 0) {
        if (rainGain && audioCtx) {
          rainGain.gain.setTargetAtTime(0.0001, audioCtx.currentTime, 3.0);
        }
      }

      if (remainingSeconds <= 0) {
        clearInterval(timerInterval);
        stopSpeech();
        setRainActive(false);
        const statusEl = document.getElementById('story-audio-status');
        if (statusEl) statusEl.textContent = isTa ? 'நேரம் முடிந்தது (தூக்கம்)' : 'Timer finished (Sleep)';
      }
    }, 1000);
  }

  function updateCountdownDisplay() {
    const badge = document.getElementById('story-countdown-badge');
    if (!badge) return;
    if (selectedDurationMins <= 0) {
      badge.classList.add('hidden');
      return;
    }
    const mins = Math.floor(remainingSeconds / 60);
    const secs = remainingSeconds % 60;
    badge.textContent = `⏳ ${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
  }

  // Build Narration Queue with Sentence Chunking (Prevents Chrome 15-second freeze bug!)
  function buildStoryQueue(storyData) {
    const queue = [];
    const optMoral = document.getElementById('narrate-moral-chk');
    const optVocab = document.getElementById('narrate-vocab-chk');
    const optQuestions = document.getElementById('narrate-questions-chk');

    // 1. Story Title
    queue.push(storyData.title);

    // 2. Story Sentences (Splitting paragraphs into short sentences for bulletproof Chrome TTS)
    const text = storyData.full_text || '';
    const rawSentences = text.split(/(?<=[.!?\n\u0964\u0965])\s+/).map(s => s.trim()).filter(Boolean);

    for (const s of rawSentences) {
      if (s.length > 180) {
        // Subdivide long sentences by commas or pauses
        const parts = s.split(/(?<=[,;:\u002C\u060C])\s+/).filter(Boolean);
        queue.push(...parts);
      } else {
        queue.push(s);
      }
    }

    // 3. Optional Moral Takeaway
    if (optMoral && optMoral.checked && storyData.moral) {
      queue.push(isTa ? `கதையின் நீதி: ${storyData.moral}` : `Moral of the story: ${storyData.moral}`);
    }

    // 4. Optional Vocabulary
    if (optVocab && optVocab.checked && storyData.vocabulary && storyData.vocabulary.length) {
      const vocabText = storyData.vocabulary.map(v => `${v.word}: ${v.meaning}`).join('. ');
      queue.push(isTa ? `இக்கதையில் புதிய சொற்கள்: ${vocabText}` : `Words to learn: ${vocabText}`);
    }

    // 5. Optional Reflection Questions
    if (optQuestions && optQuestions.checked && storyData.discussion_questions && storyData.discussion_questions.length) {
      const qText = storyData.discussion_questions.map(q => q.prompt).join('. ');
      queue.push(isTa ? `சிந்திக்க சில வினாக்கள்: ${qText}` : `Discussion questions: ${qText}`);
    }

    return queue;
  }

  function speakNextChunk() {
    if (!isSpeaking || isPaused) return;

    if (currentChunkIdx >= speechQueue.length) {
      // Current story completed!
      onStoryFinished();
      return;
    }

    const chunk = speechQueue[currentChunkIdx];
    currentChunkIdx++;

    if (!('speechSynthesis' in window)) return;

    // Clear any stuck state in Chrome
    if (window.speechSynthesis.paused) {
      window.speechSynthesis.resume();
    }

    speechUtterance = new SpeechSynthesisUtterance(chunk);
    speechUtterance.rate = playbackSpeed;
    speechUtterance.pitch = 1.0;
    speechUtterance.lang = targetBcp47;

    // Apply voice
    const voices = window.speechSynthesis.getVoices();
    let voiceToUse = voices.find(v => v.name === selectedVoiceName);
    if (!voiceToUse) {
      const candidates = getSortedVoices();
      if (candidates.length) voiceToUse = candidates[0].voice;
    }
    if (voiceToUse) {
      speechUtterance.voice = voiceToUse;
    }

    const narratingLabel = document.getElementById('story-now-narrating');
    if (narratingLabel) {
      narratingLabel.textContent = chunk.slice(0, 60) + (chunk.length > 60 ? '...' : '');
    }

    window._dailytale_slug_utterance = speechUtterance;

    speechUtterance.onend = () => {
      if (isSpeaking && !isPaused) {
        speakNextChunk();
      }
    };

    speechUtterance.onerror = (err) => {
      if (err.error === 'canceled' || err.error === 'interrupted') return;
      console.warn('Speech chunk warning:', err.error);
      if (isSpeaking && !isPaused) {
        speakNextChunk();
      }
    };

    window.speechSynthesis.speak(speechUtterance);
  }

  let slugAdvanceTimeout = null;

  function onStoryFinished() {
    clearTimeout(slugAdvanceTimeout);

    // If single story mode (0 min), stop here!
    if (selectedDurationMins === 0) {
      stopSpeech();
      const statusEl = document.getElementById('story-audio-status');
      if (statusEl) statusEl.textContent = isTa ? 'கதை நிறைவுற்றது' : 'Story Completed';
      return;
    }

    // If timer expired, stop here!
    if (selectedDurationMins > 0 && remainingSeconds <= 0) {
      stopSpeech();
      return;
    }

    // Auto-advance sequentially to next story in collection!
    if (collectionPlaylist.length > 1 && currentPlaylistIdx < collectionPlaylist.length - 1) {
      currentPlaylistIdx++;
      const nextStory = collectionPlaylist[currentPlaylistIdx];

      const statusEl = document.getElementById('story-audio-status');
      if (statusEl) statusEl.textContent = isTa ? `அடுத்த கதை: ${nextStory.title.slice(0, 30)}...` : `Next: ${nextStory.title.slice(0, 30)}...`;

      // 2.2s gentle lull before next story starts
      slugAdvanceTimeout = setTimeout(() => {
        if (isSpeaking && !isPaused) {
          startStoryNarration(nextStory);
        }
      }, 2200);
    } else {
      stopSpeech();
      const statusEl = document.getElementById('story-audio-status');
      if (statusEl) statusEl.textContent = isTa ? 'தொகுப்பு நிறைவுற்றது' : 'Playlist Completed';
    }
  }

  function startStoryNarration(storyData) {
    if (!('speechSynthesis' in window)) {
      alert('Text-to-speech audio narration is not supported on this browser.');
      return;
    }

    window.speechSynthesis.cancel();
    speechQueue = buildStoryQueue(storyData);
    currentChunkIdx = 0;
    isSpeaking = true;
    isPaused = false;

    updateAllAudioUI(true);
    speakNextChunk();
  }

  function stopSpeech() {
    if ('speechSynthesis' in window) {
      window.speechSynthesis.cancel();
    }
    clearInterval(timerInterval);
    isSpeaking = false;
    isPaused = false;
    currentChunkIdx = 0;
    updateAllAudioUI(false);

    const badge = document.getElementById('story-countdown-badge');
    if (badge) badge.classList.add('hidden');
  }

  function toggleSpeech() {
    if (!('speechSynthesis' in window)) {
      alert('Audio narration is not supported on this device.');
      return;
    }

    if (isSpeaking) {
      stopSpeech();
      return;
    }

    // Determine current story data
    let currentStoryData = window.__CURRENT_STORY_DATA || collectionPlaylist[currentPlaylistIdx];
    if (!currentStoryData) {
      const payloadEl = document.getElementById('initial-story-payload');
      if (payloadEl && payloadEl.textContent) {
        try {
          currentStoryData = JSON.parse(payloadEl.textContent);
        } catch(e) {}
      }
    }
    if (!currentStoryData) {
      const titleEl = document.querySelector('h1');
      const bodyEl = document.getElementById('story-body-content');
      currentStoryData = {
        title: titleEl?.innerText.trim() || document.title,
        full_text: bodyEl?.innerText.trim() || '',
        moral: '',
        vocabulary: [],
        discussion_questions: []
      };
    }

    // Start timer if duration set
    if (selectedDurationMins > 0) {
      startCountdown(selectedDurationMins * 60);
    }

    startStoryNarration(currentStoryData);
  }

