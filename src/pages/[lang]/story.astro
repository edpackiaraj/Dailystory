  // 4. Interactive Quiz Option Checker & Classroom Score Logging
  function bindQuizEvents() {
    let quizAnsweredCount = 0;
    let quizCorrectCount = 0;
    const quizContainer = document.getElementById('story-quiz-container');
    const totalQuestions = quizContainer ? parseInt(quizContainer.getAttribute('data-total-questions') || '0', 10) : 0;
    const currentStoryTitle = quizContainer?.getAttribute('data-story-title') || document.title;

    document.querySelectorAll('.quiz-option-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const parent = btn.closest('.grid');
        const isCorrect = (btn.getAttribute('data-is-correct') || btn.getAttribute('data-correct')) === 'true';

        if (isCorrect) {
          quizCorrectCount++;
        }
        quizAnsweredCount++;

        parent.querySelectorAll('.quiz-option-btn').forEach(b => {
          b.disabled = true;
          const bCorrect = (b.getAttribute('data-is-correct') || b.getAttribute('data-correct')) === 'true';
          if (bCorrect) {
            b.classList.add('bg-emerald-100', 'border-emerald-500', 'text-emerald-900', 'dark:bg-emerald-950/70', 'dark:text-emerald-200');
          }
        });

        if (!isCorrect) {
          btn.classList.add('bg-red-100', 'border-red-500', 'text-red-900', 'dark:bg-red-950/70', 'dark:text-red-200');
        }

        // Check if all questions are answered
        if (totalQuestions > 0 && quizAnsweredCount >= totalQuestions) {
          const scorePercent = Math.round((quizCorrectCount / totalQuestions) * 100);
          const banner = document.getElementById('quiz-completion-banner');
          const text = document.getElementById('quiz-completion-text');
          if (banner && text) {
            text.textContent = `Completed! Score: ${quizCorrectCount}/${totalQuestions} (${scorePercent}%) — Logged to Classroom`;
            banner.classList.remove('hidden');
          }

          // Automatic logging to Classroom Results
          try {
            const studentProfile = JSON.parse(localStorage.getItem('dailytale_current_student') || 'null');
            const studentName = studentProfile?.name || 'Reader (Guest)';
            const urlParams = new URLSearchParams(window.location.search);
            const classCode = urlParams.get('class') || studentProfile?.classCode || 'CLASS-5A';

            const record = {
              id: Date.now().toString(),
              studentName,
              classCode,
              storyTitle: currentStoryTitle,
              score: `${quizCorrectCount}/${totalQuestions} (${scorePercent}%)`,
              scoreNum: scorePercent,
              date: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }),
              status: scorePercent >= 70 ? 'Distinction' : scorePercent >= 40 ? 'Passed' : 'Review Needed'
            };

            const existingResults = JSON.parse(localStorage.getItem('dailytale_classroom_results') || '[]');
            existingResults.unshift(record);
            localStorage.setItem('dailytale_classroom_results', JSON.stringify(existingResults.slice(0, 100)));
          } catch(e) {}
        }
      });
    });
  }
