---
import brandConfig from '../../../config/brand.json';
import { getT, getLanguageMeta } from '../../lib/i18n';
import {
  getAllReviewedStories,
  getTodaysStory,
  getCollectionSlug,
  getAudienceCategory,
  getLengthCategory,
  getStoryUrl,
  isStoryTranslated,
  type Story
} from '../../lib/stories';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryIllustration from '../../components/StoryIllustration.astro';

export function getStaticPaths() {
  return brandConfig.supportedLanguages.map(l => ({
    params: { lang: l.code }
  }));
}

const { lang } = Astro.params;
const currentLang = lang || 'en';
const t = getT(currentLang);
const currentLangObj = getLanguageMeta(currentLang);

const allStories = getAllReviewedStories(currentLang);
const todaysStory = getTodaysStory(currentLang);

// Short stories under 3 min (word count <= 350)
const shortStories = allStories.filter(s => (s.word_count || 400) <= 350).slice(0, 8);

// Core cultural collections
const collectionsMap: Record<string, { name: string; count: number; image: string }> = {};
for (const s of allStories) {
  if (!collectionsMap[s.collection]) {
    collectionsMap[s.collection] = {
      name: s.collection,
      count: 0,
      image: s.image || '/images/og-default.png'
    };
  }
  collectionsMap[s.collection].count++;
}
const collectionList = Object.values(collectionsMap);

const localizedCollectionNames: Record<string, Record<string, string>> = {
  ta: {
    "cinderella-stories": "சிண்ட்ரெல்லா உலகக் கதைகள்",
    "akbar-birbal": "அக்பர்–பீர்பால் கதைகள்",
    "panchatantra": "பஞ்சதந்திரக் கதைகள்",
    "tenali-rama": "தெனாலிராமன் கதைகள்",
    "aesop-s-fables": "ஈசாப் நீதிக்கதைகள்",
    "aesops-fables": "ஈசாப் நீதிக்கதைகள்",
    "grimm-fairy-tales": "கிரிம் சகோதரர்கள் கதைகள்",
    "hans-christian-andersen": "ஹான்ஸ் கிறிஸ்டியன் ஆண்டர்சன் கதைகள்",
    "mulla-nasruddin": "முல்லா நஸ்ருதீன் கதைகள்",
    "jataka-tales": "ஜாதகக் கதைகள் (புத்தர் நீதிக்கதைகள்)",
    "arabian-nights": "ஆயிரத்தொரு இரவுகள் (அரேபிய இரவுகள்)",
    "paramartha-guru": "பரமார்த்த குரு கதைகள் (வீரமாமுனிவர்)",
    "vikram-vetal": "விக்கிரமாதித்தன்–வேதாளம் கதைகள்",
    "charles-perrault": "சார்லஸ் பெரோ கதைகள்"
  },
  hi: {
    "cinderella-stories": "सिंड्रेला की कहानियाँ",
    "akbar-birbal": "अकबर–बीरबल की कहानियाँ",
    "panchatantra": "पंचतंत्र की कहानियाँ",
    "tenali-rama": "तेनालीराम की कहानियाँ",
    "aesops-fables": "ईसप की नीतिकथाएँ",
    "grimm-fairy-tales": "ग्रिम्स की परिकथाएँ",
    "hans-christian-andersen": "हंस एंडरसन की कहानियाँ",
    "mulla-nasruddin": "मुल्ला नसरुद्दीन के किस्से",
    "jataka-tales": "जातक कथाएँ",
    "arabian-nights": "अलिफ लैला (1001 रातें)",
    "paramartha-guru": "परमार्थ गुरु की कहानियाँ",
    "vikram-vetal": "विक्रम और बेताल",
    "charles-perrault": "चार्ल्स पेरोट की कहानियाँ"
  }
};

// Latest stories for grid: prioritize translated stories in non-English editions
const translatedFirst = currentLang === 'en'
  ? allStories
  : [...allStories].sort((a, b) => {
      const aTr = isStoryTranslated(a, currentLang) ? 1 : 0;
      const bTr = isStoryTranslated(b, currentLang) ? 1 : 0;
      return bTr - aTr;
    });

const recentStories = translatedFirst.slice(0, 16);
---

<BaseLayout
  lang={currentLang}
  canonicalUrl={`${brandConfig.siteUrl}/${currentLang}/`}
  ogImage={todaysStory?.image}
  activeNavTab="home"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 space-y-12 sm:space-y-16">
    
    <!-- Multilingual Quick Switcher Banner -->
    <div class="p-3 sm:p-4 rounded-2xl bg-white dark:bg-[#1E1D36] border border-[#EEDFC8] dark:border-[#383659] shadow-xs flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
      <div class="flex items-center gap-2 font-bold text-[#3B2A1A] dark:text-[#F3EBDD]">
        <span class="text-base">🌐</span>
        <span>{t.selectLanguage || "Language"}:</span>
      </div>
      <div class="flex items-center gap-1.5 flex-wrap justify-center font-bold">
        {brandConfig.supportedLanguages.map(l => (
          <a
            href={`/${l.code}/`}
            class={`px-3 py-1.5 rounded-xl border transition-all text-xs ${
              l.code === currentLang
                ? 'bg-[#D97706] text-white border-[#D97706] shadow-2xs'
                : 'bg-[#FFF8EC] dark:bg-[#151426] border-[#EEDFC8] dark:border-[#383659] text-[#3B2A1A] dark:text-[#F3EBDD] hover:border-[#D97706]'
            }`}
          >
            {l.native}
          </a>
        ))}
      </div>
    </div>

    <!-- Hero: "Story of the Day" -->
    {todaysStory && (
      <section class="relative rounded-3xl bg-linear-to-br from-amber-100/80 via-[#FFFDF9] to-amber-50 dark:from-[#25243E] dark:via-[#1B1A2E] dark:to-[#25243E] p-6 sm:p-10 border border-[#EEDFC8] dark:border-[#383659] shadow-md overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <!-- Story Info (lg:col-span-7) -->
          <div class="lg:col-span-7 space-y-4">
            
            <div class="flex flex-wrap items-center gap-2">
              <span class="px-3.5 py-1 rounded-full bg-[#D97706] text-white font-black text-xs uppercase tracking-wider shadow-xs">
                ⭐ {t.storyOfTheDay}
              </span>
              <span class="px-3 py-1 rounded-full bg-white dark:bg-[#1B1A2E] border border-[#EEDFC8] dark:border-[#383659] text-xs font-bold text-[#6B5644] dark:text-[#C8BFAF]">
                {todaysStory.collection}
              </span>
              <span class="px-3 py-1 rounded-full bg-[#0F766E]/15 text-[#0F766E] dark:text-[#2DD4BF] text-xs font-semibold">
                {getAudienceCategory(todaysStory.age_group) === 'kids' ? t.kids : (getAudienceCategory(todaysStory.age_group) === 'teens' ? t.teens : t.everyone)}
              </span>
              <span class="text-xs text-[#6B5644] dark:text-[#C8BFAF]">
                ⏱ {todaysStory.reading_time || '4 min'}
              </span>
            </div>

            <h1 class={currentLang === 'ta'
              ? "text-xl sm:text-2xl md:text-3xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD] tracking-normal leading-snug"
              : "text-2xl sm:text-4xl lg:text-5xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD] tracking-tight leading-tight"
            }>
              {todaysStory.title}
            </h1>

            <p class="text-sm sm:text-base text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed line-clamp-3">
              {todaysStory.summary}
            </p>

            <!-- Actions -->
            <div class="pt-2 flex flex-wrap items-center gap-3">
              <a
                href={getStoryUrl(todaysStory, currentLang)}
                class="px-6 py-3.5 rounded-full bg-[#D97706] hover:bg-[#B45309] text-white font-black text-sm shadow-md hover:scale-105 transition-all flex items-center gap-2 min-h-[48px]"
              >
                <span>📖</span>
                <span>{t.stories} →</span>
              </a>

              <a
                href={`${getStoryUrl(todaysStory, currentLang)}#listen`}
                class="px-6 py-3.5 rounded-full bg-white dark:bg-[#2E2D4D] border border-[#EEDFC8] dark:border-[#383659] text-[#0F766E] dark:text-[#2DD4BF] hover:border-[#0F766E] font-bold text-sm shadow-xs transition-all flex items-center gap-2 min-h-[48px]"
              >
                <span>▶</span>
                <span>{t.listen}</span>
              </a>
            </div>

          </div>

          <!-- Story Visual (lg:col-span-5) -->
          <div class="lg:col-span-5">
            <StoryIllustration story={todaysStory} size="hero" lang={currentLang} />
          </div>

        </div>
      </section>
    )}

    <!-- Dynamic "Continue Reading" Section (Populated via client-side localStorage) -->
    <section id="continue-reading-section" class="hidden p-5 sm:p-6 rounded-3xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] shadow-sm">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="text-2xl">🔖</span>
          <div>
            <h2 class="text-xs font-bold uppercase tracking-wider text-[#D97706] dark:text-[#F59E0B]">
              {t.continueReading}
            </h2>
            <p id="continue-reading-title" class="text-sm sm:text-base font-bold text-[#3B2A1A] dark:text-[#F3EBDD]"></p>
          </div>
        </div>
        <a
          id="continue-reading-link"
          href="#"
          class="px-4 py-2 rounded-full bg-[#D97706] text-white text-xs font-bold hover:bg-[#B45309] transition-all min-h-[40px] flex items-center"
        >
          {currentLang === 'ta' ? 'தொடர்க →' : (currentLang === 'hi' ? 'जारी रखें →' : 'Resume →')}
        </a>
      </div>
    </section>

    <!-- Audience Filter Chips: Everyone, Kids, Teens -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-xl sm:text-2xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD]">
            {currentLang === 'ta' ? 'பார்வையாளர்கள் வாரியாக' : (currentLang === 'hi' ? 'पाठक वर्ग अनुसार' : 'Explore by Reader')}
          </h2>
          <p class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF]">
            {currentLang === 'ta' ? 'அனைத்து வயதினருக்குமான நீதிக்கதைகள் மற்றும் பண்பாட்டு பொக்கிஷங்கள்' : 'Thoughtfully curated fables, folktales and wisdom for every stage of life'}
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        {brandConfig.audiences.map(aud => (
          <a
            href={`/${currentLang}/search/?audience=${aud.id}`}
            class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] hover:border-[#D97706] hover:scale-[1.02] transition-all group flex items-center gap-3 shadow-xs"
          >
            <span class="text-3xl group-hover:scale-110 transition-transform">{aud.icon}</span>
            <div>
              <h3 class="text-base font-black text-[#3B2A1A] dark:text-[#F3EBDD] group-hover:text-[#D97706] transition-colors">
                {aud.label === 'Everyone' ? t.everyone : (aud.label === 'Kids' ? t.kids : t.teens)}
              </h3>
              <p class="text-xs text-[#6B5644] dark:text-[#C8BFAF]">
                {aud.id === 'everyone' ? (currentLang === 'ta' ? 'அனைவருக்குமான வாழ்வியல் ஞானம்' : 'Universal wisdom & folktales') : (aud.id === 'kids' ? (currentLang === 'ta' ? 'விலங்குக் கதைகள் மற்றும் சிறுவர் பாலர் கதைகள்' : 'Gentle fables & fun animals') : (currentLang === 'ta' ? 'விவேகமும் சமயோசித புத்தியும்' : 'Moral dilemmas & sharp wit'))}
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Short Stories Under 3 Min (Quick Bedtime / Commute Reads) -->
    {shortStories.length > 0 && (
      <section class="space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-xl sm:text-2xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD]">
              {t.shortStoriesUnder3Min}
            </h2>
            <p class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF]">
              {currentLang === 'ta' ? '2-3 நிமிடங்களில் படித்து மகிழக்கூடிய சுவையான சிறுகதைகள்' : 'Bite-sized life lessons perfect for a 2-minute tea break or bedtime pause'}
            </p>
          </div>
          <a href={`/${currentLang}/search/?length=short`} class="text-xs sm:text-sm font-bold text-[#D97706] hover:underline">
            {currentLang === 'ta' ? 'அனைத்தும் →' : (currentLang === 'hi' ? 'सभी देखें →' : 'View all →')}
          </a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
          {shortStories.map(story => (
            <a
              href={getStoryUrl(story, currentLang)}
              class="group p-3.5 rounded-2xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] hover:border-[#D97706] hover:shadow-md transition-all flex flex-col justify-between"
            >
              <div class="space-y-2">
                <StoryIllustration story={story} size="compact" lang={currentLang} />
                <div class="flex items-center justify-between text-[11px] text-[#6B5644] dark:text-[#C8BFAF]">
                  <span class="font-bold text-[#D97706]">{story.collection}</span>
                  <span>⏱ {story.reading_time || '2m'}</span>
                </div>
                <h3 class="text-xs sm:text-sm font-bold text-[#3B2A1A] dark:text-[#F3EBDD] line-clamp-2 leading-snug group-hover:text-[#D97706] transition-colors">
                  {story.title}
                </h3>
              </div>
              <p class="text-[11px] text-[#6B5644] dark:text-[#C8BFAF] line-clamp-2 mt-2 pedagogy-learning-suite">
                {story.moral}
              </p>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Classic Cultural Story Collections -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-xl sm:text-2xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD]">
            {t.collections}
          </h2>
          <p class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF]">
            {currentLang === 'ta' ? 'பண்பாட்டுச் சிறப்புமிக்க உலகக் கதைகளின் பொக்கிஷம்' : (currentLang === 'hi' ? 'विश्व प्रसिद्ध सांस्कृतिक लोककथाओं का अनुपम संग्रह' : 'Treasures of world folklore translated with cultural reverence')}
          </p>
        </div>
        <a href={`/${currentLang}/collections/`} class="text-xs sm:text-sm font-bold text-[#D97706] hover:underline">
          {t.collections} →
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4">
        {collectionList.map(col => {
          const colSlug = getCollectionSlug(col.name);
          return (
            <a
              href={`/${currentLang}/collections/${colSlug}/`}
              class="group p-4 rounded-2xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] hover:border-[#D97706] hover:shadow-md transition-all flex flex-col justify-between"
            >
              <div class="space-y-2">
                <div class="aspect-16/10 rounded-xl overflow-hidden bg-[#EEDFC8]/30">
                  <img
                    src={col.image}
                    alt={col.name}
                    width="300"
                    height="190"
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
                <h3 class="text-sm sm:text-base font-black text-[#3B2A1A] dark:text-[#F3EBDD] group-hover:text-[#D97706] transition-colors leading-tight">
                  {localizedCollectionNames[currentLang]?.[colSlug] || col.name}
                </h3>
              </div>
              <span class="text-xs font-semibold text-[#0F766E] dark:text-[#2DD4BF] mt-3">
                {col.count} {t.stories} →
              </span>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Latest Stories Grid (Responsive: 2-col Phone, 3-col Tablet, 4-col PC) -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-xl sm:text-2xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD]">
            {currentLang === 'ta' ? 'படிக்க வேண்டிய அழியா நற்கதைகள்' : (currentLang === 'hi' ? 'सदाबहार प्रेरक कहानियाँ' : 'Timeless Stories to Read')}
          </h2>
          <p class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF]">
            {currentLang === 'ta' ? 'அறிவு, விவேகம், வீரம் மற்றும் நற்பண்புகள் நிறைந்த கதைகள்' : (currentLang === 'hi' ? 'बुद्धिमत्ता, साहस और सदाचार से भरी कहानियाँ' : 'Stories of wit, virtue, courage and laughter')}
          </p>
        </div>
        <a href={`/${currentLang}/search/`} class="text-xs sm:text-sm font-bold text-[#D97706] hover:underline">
          {t.stories} →
        </a>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-5">
        {recentStories.map(story => (
          <a
            href={getStoryUrl(story, currentLang)}
            class="group p-3.5 sm:p-4 rounded-2xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] hover:border-[#D97706] hover:shadow-lg transition-all flex flex-col justify-between"
          >
            <div class="space-y-2.5">
              <StoryIllustration story={story} size="card" lang={currentLang} />

              <div class="flex items-center justify-between text-[11px] text-[#6B5644] dark:text-[#C8BFAF]">
                <span class="font-bold text-[#D97706] truncate max-w-[55%]">{story.collection}</span>
                {isStoryTranslated(story, currentLang) ? (
                  <span class="px-2 py-0.5 rounded-md bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 font-bold text-[10px]">
                    ✓ {t.fullTranslationBadge || "Full"}
                  </span>
                ) : (
                  <span>⏱ {story.reading_time || '4m'}</span>
                )}
              </div>

              <h3 class="text-xs sm:text-sm font-black text-[#3B2A1A] dark:text-[#F3EBDD] line-clamp-2 leading-snug group-hover:text-[#D97706] transition-colors">
                {story.title}
              </h3>

              <p class="text-xs text-[#6B5644] dark:text-[#C8BFAF] line-clamp-2 leading-relaxed">
                {story.summary}
              </p>
            </div>

            <div class="pt-3 border-t border-[#EEDFC8]/60 dark:border-[#383659]/60 flex items-center justify-between text-xs mt-3">
              <span class="text-[11px] font-semibold text-[#0F766E] dark:text-[#2DD4BF]">
                {getAudienceCategory(story.age_group) === 'kids' ? t.kids : (getAudienceCategory(story.age_group) === 'teens' ? t.teens : t.everyone)}
              </span>
              <span class="font-bold text-[#D97706] group-hover:translate-x-1 transition-transform">
                {t.readStory || "Read →"}
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>

<script is:inline>
  // Check for "Continue Reading" from localStorage
  try {
    const lastRead = JSON.parse(localStorage.getItem('dailytale_last_read'));
    if (lastRead && lastRead.title && lastRead.url) {
      const section = document.getElementById('continue-reading-section');
      const titleEl = document.getElementById('continue-reading-title');
      const linkEl = document.getElementById('continue-reading-link');
      if (section && titleEl && linkEl) {
        titleEl.textContent = lastRead.title;
        linkEl.href = lastRead.url;
        section.classList.remove('hidden');
      }
    }
  } catch(e) {}
</script>
