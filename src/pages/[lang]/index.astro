</BaseLayout>

<script is:inline>
  // Check for "Continue Reading / Listening" from localStorage
  (function initContinueWidget() {
    try {
      const raw = localStorage.getItem('dailytale_last_read');
      if (!raw) return;
      const data = JSON.parse(raw);
      if (!data || !data.title || !data.url) return;

      const section = document.getElementById('continue-reading-section');
      const titleEl = document.getElementById('continue-reading-title');
      const collectionEl = document.getElementById('continue-reading-collection');
      const typeBadge = document.getElementById('continue-type-badge');
      const progressBadge = document.getElementById('continue-progress-badge');
      const iconBox = document.getElementById('continue-icon-box');
      const readLink = document.getElementById('continue-read-link');
      const listenLink = document.getElementById('continue-listen-link');
      const dismissBtn = document.getElementById('continue-dismiss-btn');

      if (!section) return;

      if (titleEl) titleEl.textContent = data.title;
      if (collectionEl) collectionEl.textContent = data.collection ? '📚 ' + data.collection : '';

      const isListening = data.type === 'listening';
      if (iconBox) iconBox.textContent = isListening ? '🎧' : '📖';
      if (typeBadge) {
        typeBadge.textContent = isListening 
          ? (document.documentElement.lang === 'ta' ? 'கேட்பதைத் தொடரவும்' : 'Continue Listening')
          : (document.documentElement.lang === 'ta' ? 'வாசிப்பைத் தொடரவும்' : 'Continue Reading');
      }

      const pct = isListening ? (data.listeningPercent || 0) : (data.scrollPercent || 0);
      if (progressBadge) {
        progressBadge.textContent = pct > 0 ? pct + '% ' + (isListening ? 'listened' : 'read') : 'In Progress';
      }

      if (readLink) readLink.href = data.url + '#resume';
      if (listenLink) listenLink.href = data.url + '#listen';

      if (dismissBtn) {
        dismissBtn.addEventListener('click', function() {
          localStorage.removeItem('dailytale_last_read');
          section.classList.add('hidden');
        });
      }

      section.classList.remove('hidden');
    } catch(e) {
      console.warn('Error loading continue reading widget:', e);
    }
  })();
</script>
