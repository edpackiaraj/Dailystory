---
import brandConfig from '../../../config/brand.json';
import { getT, getLanguageMeta } from '../../lib/i18n';
import {
  getAllReviewedStories,
  getTodaysStory,
  getCollectionSlug,
  getAudienceCategory,
  getLengthCategory,
  getStoryUrl,
  isStoryTranslated,
  type Story
} from '../../lib/stories';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryIllustration from '../../components/StoryIllustration.astro';

export function getStaticPaths() {
  return brandConfig.supportedLanguages.map(l => ({
    params: { lang: l.code }
  }));
}

const { lang } = Astro.params;
const currentLang = lang || 'en';
const t = getT(currentLang);
const currentLangObj = getLanguageMeta(currentLang);

const allStories = getAllReviewedStories(currentLang);
const todaysStory = getTodaysStory(currentLang);

// Short stories under 3 min (word count <= 350)
const shortStories = allStories.filter(s => (s.word_count || 400) <= 350).slice(0, 8);

// Core cultural collections
const collectionsMap: Record<string, { name: string; count: number; image: string }> = {};
for (const s of allStories) {
  if (!collectionsMap[s.collection]) {
    collectionsMap[s.collection] = {
      name: s.collection,
      count: 0,
      image: s.image || '/images/og-default.png'
    };
  }
  collectionsMap[s.collection].count++;
}
const collectionList = Object.values(collectionsMap);

const localizedCollectionNames: Record<string, Record<string, string>> = {
  ta: {
    "cinderella-stories": "சிண்ட்ரெல்லா உலகக் கதைகள்",
    "akbar-birbal": "அக்பர்–பீர்பால் கதைகள்",
    "panchatantra": "பஞ்சதந்திரக் கதைகள்",
    "tenali-rama": "தெனாலிராமன் கதைகள்",
    "aesop-s-fables": "ஈசாப் நீதிக்கதைகள்",
    "aesops-fables": "ஈசாப் நீதிக்கதைகள்",
    "grimm-fairy-tales": "கிரிம் சகோதரர்கள் கதைகள்",
    "hans-christian-andersen": "ஹான்ஸ் கிறிஸ்டியன் ஆண்டர்சன் கதைகள்",
    "mulla-nasruddin": "முல்லா நஸ்ருதீன் கதைகள்",
    "jataka-tales": "ஜாதகக் கதைகள் (புத்தர் நீதிக்கதைகள்)",
    "arabian-nights": "ஆயிரத்தொரு இரவுகள் (அரேபிய இரவுகள்)",
    "paramartha-guru": "பரமார்த்த குரு கதைகள் (வீரமாமுனிவர்)",
    "vikram-vetal": "விக்கிரமாதித்தன்–வேதாளம் கதைகள்",
    "charles-perrault": "சார்லஸ் பெரோ கதைகள்"
  },
  hi: {
    "cinderella-stories": "सिंड्रेला की कहानियाँ",
    "akbar-birbal": "अकबर–बीरबल की कहानियाँ",
    "panchatantra": "पंचतंत्र की कहानियाँ",
    "tenali-rama": "तेनालीराम की कहानियाँ",
    "aesops-fables": "ईसप की नीतिकथाएँ",
    "grimm-fairy-tales": "ग्रिम्स की परिकथाएँ",
    "hans-christian-andersen": "हंस एंडरसन की कहानियाँ",
    "mulla-nasruddin": "मुल्ला नसरुद्दीन के किस्से",
    "jataka-tales": "जातक कथाएँ",
    "arabian-nights": "अलिफ लैला (1001 रातें)",
    "paramartha-guru": "परमार्थ गुरु की कहानियाँ",
    "vikram-vetal": "विक्रम और बेताल",
    "charles-perrault": "चार्ल्स पेरोट की कहानियाँ"
  }
};

// Latest stories for grid: prioritize translated stories in non-English editions
const translatedFirst = currentLang === 'en'
  ? allStories
  : [...allStories].sort((a, b) => {
      const aTr = isStoryTranslated(a, currentLang) ? 1 : 0;
      const bTr = isStoryTranslated(b, currentLang) ? 1 : 0;
      return bTr - aTr;
    });

const recentStories = translatedFirst.slice(0, 16);
---

<BaseLayout
  lang={currentLang}
  canonicalUrl={`${brandConfig.siteUrl}/${currentLang}/`}
  ogImage={todaysStory?.image}
  activeNavTab="home"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 space-y-12 sm:space-y-16">
    
    <!-- Multilingual Quick Switcher Banner -->
    <div class="p-3 sm:p-4 rounded-2xl bg-white dark:bg-[#1E1D36] border border-[#EEDFC8] dark:border-[#383659] shadow-xs flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
      <div class="flex items-center gap-2 font-bold text-[#3B2A1A] dark:text-[#F3EBDD]">
        <span class="text-base">🌐</span>
        <span>{t.selectLanguage || "Language"}:</span>
      </div>
      <div class="flex items-center gap-1.5 flex-wrap justify-center font-bold">
        {brandConfig.supportedLanguages.map(l => (
          <a
            href={`/${l.code}/`}
            class={`px-3 py-1.5 rounded-xl border transition-all text-xs ${
              l.code === currentLang
                ? 'bg-[#D97706] text-white border-[#D97706] shadow-2xs'
                : 'bg-[#FFF8EC] dark:bg-[#151426] border-[#EEDFC8] dark:border-[#383659] text-[#3B2A1A] dark:text-[#F3EBDD] hover:border-[#D97706]'
            }`}
          >
            {l.native}
          </a>
        ))}
      </div>
    </div>

    <!-- Hero: "Story of the Day" -->
    {todaysStory && (
      <section class="relative rounded-3xl bg-linear-to-br from-amber-100/80 via-[#FFFDF9] to-amber-50 dark:from-[#25243E] dark:via-[#1B1A2E] dark:to-[#25243E] p-6 sm:p-10 border border-[#EEDFC8] dark:border-[#383659] shadow-md overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <!-- Story Info (lg:col-span-7) -->
          <div class="lg:col-span-7 space-y-4">
            
            <div class="flex flex-wrap items-center gap-2">
              <span class="px-3.5 py-1 rounded-full bg-[#D97706] text-white font-black text-xs uppercase tracking-wider shadow-xs">
                ⭐ {t.storyOfTheDay}
              </span>
              <span class="px-3 py-1 rounded-full bg-white dark:bg-[#1B1A2E] border border-[#EEDFC8] dark:border-[#383659] text-xs font-bold text-[#6B5644] dark:text-[#C8BFAF]">
                {todaysStory.collection}
              </span>
              <span class="px-3 py-1 rounded-full bg-[#0F766E]/15 text-[#0F766E] dark:text-[#2DD4BF] text-xs font-semibold">
                {getAudienceCategory(todaysStory.age_group) === 'kids' ? t.kids : (getAudienceCategory(todaysStory.age_group) === 'teens' ? t.teens : t.everyone)}
              </span>
              <span class="text-xs text-[#6B5644] dark:text-[#C8BFAF]">
                ⏱ {todaysStory.reading_time || '4 min'}
              </span>
            </div>

            <h1 class={currentLang === 'ta'
              ? "text-xl sm:text-2xl md:text-3xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD] tracking-normal leading-snug"
              : "text-2xl sm:text-4xl lg:text-5xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD] tracking-tight leading-tight"
            }>
              {todaysStory.title}
            </h1>

            <p class="text-sm sm:text-base text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed line-clamp-3">
              {todaysStory.summary}
            </p>

            <!-- Actions -->
            <div class="pt-2 flex flex-wrap items-center gap-3">
              <a
                href={getStoryUrl(todaysStory, currentLang)}
                class="px-6 py-3.5 rounded-full bg-[#D97706] hover:bg-[#B45309] text-white font-black text-sm shadow-md hover:scale-105 transition-all flex items-center gap-2 min-h-[48px]"
              >
                <span>📖</span>
                <span>{t.stories} →</span>
              </a>

              <a
                href={`${getStoryUrl(todaysStory, currentLang)}#listen`}
                class="px-6 py-3.5 rounded-full bg-white dark:bg-[#2E2D4D] border border-[#EEDFC8] dark:border-[#383659] text-[#0F766E] dark:text-[#2DD4BF] hover:border-[#0F766E] font-bold text-sm shadow-xs transition-all flex items-center gap-2 min-h-[48px]"
              >
                <span>▶</span>
                <span>{t.listen}</span>
              </a>
            </div>

          </div>

          <!-- Story Visual (lg:col-span-5) -->
          <div class="lg:col-span-5">
            <StoryIllustration story={todaysStory} size="hero" lang={currentLang} />
          </div>

        </div>
      </section>
    )}

    <!-- Dynamic "Continue Reading / Listening" Section (Populated via client-side localStorage) -->
    <section id="continue-reading-section" class="hidden p-5 sm:p-6 rounded-3xl bg-linear-to-r from-amber-50 via-orange-50/50 to-amber-50 dark:from-[#25243E] dark:via-[#1F1E38] dark:to-[#25243E] border-2 border-amber-300 dark:border-amber-600/50 shadow-md transition-all">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-start sm:items-center gap-3.5">
          <div id="continue-icon-box" class="w-12 h-12 rounded-2xl bg-[#D97706] text-white flex items-center justify-center text-2xl shadow-sm shrink-0">
            📖
          </div>
          <div class="space-y-1">
            <div class="flex items-center gap-2 flex-wrap">
              <span id="continue-type-badge" class="px-2.5 py-0.5 rounded-full bg-[#D97706]/15 text-[#D97706] dark:text-[#F59E0B] text-[11px] font-black uppercase tracking-wider">
                {currentLang === 'ta' ? 'வாசிப்பைத் தொடரவும்' : (currentLang === 'hi' ? 'जारी रखें' : 'Continue Reading')}
              </span>
              <span id="continue-progress-badge" class="px-2 py-0.5 rounded-full bg-white dark:bg-[#151426] border border-[#EEDFC8] dark:border-[#383659] text-[11px] font-mono font-bold text-[#6B5644] dark:text-[#C8BFAF]">
                0%
              </span>
            </div>
            <p id="continue-reading-title" class="text-base sm:text-lg font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD] line-clamp-1"></p>
            <p id="continue-reading-collection" class="text-xs text-[#6B5644] dark:text-[#C8BFAF] font-medium"></p>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center gap-2 self-end sm:self-center shrink-0">
          <a
            id="continue-read-link"
            href="#"
            class="px-4 py-2.5 rounded-xl bg-[#D97706] hover:bg-[#B45309] text-white text-xs font-black shadow-xs transition-all flex items-center gap-1.5 min-h-[40px]"
          >
            <span>📖</span>
            <span>{currentLang === 'ta' ? 'வாசிக்க' : (currentLang === 'hi' ? 'पढ़ें' : 'Read')}</span>
          </a>
          <a
            id="continue-listen-link"
            href="#"
            class="px-4 py-2.5 rounded-xl bg-[#0F766E] hover:bg-[#0D655E] text-white text-xs font-black shadow-xs transition-all flex items-center gap-1.5 min-h-[40px]"
          >
            <span>🎧</span>
            <span>{currentLang === 'ta' ? 'கேட்க' : (currentLang === 'hi' ? 'सुनें' : 'Listen')}</span>
          </a>
          <button
            id="continue-dismiss-btn"
            type="button"
            aria-label="Dismiss Continue Reading"
            class="p-2.5 rounded-xl bg-white dark:bg-[#1E1D36] border border-[#EEDFC8] dark:border-[#383659] hover:bg-red-50 dark:hover:bg-red-950/30 text-slate-400 hover:text-red-500 transition-colors"
            title="Dismiss"
          >
            ✕
          </button>
        </div>
      </div>
    </section>

    <!-- Welcome & How to Effectively Use Section -->
    <section class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-[#1E1D36] border border-[#EEDFC8] dark:border-[#383659] shadow-sm space-y-6">
      
      <!-- Welcome Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-[#EEDFC8]/60 dark:border-[#383659]/60">
        <div class="space-y-1.5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#D97706]/15 text-[#D97706] dark:text-[#F59E0B] text-xs font-black uppercase tracking-wider">
            <span>🦉</span>
            <span>{currentLang === 'ta' ? 'நல்வரவு!' : (currentLang === 'hi' ? 'स्वागतम्' : 'Welcome to Daily Tale')}</span>
          </div>
          <h2 class="text-xl sm:text-2xl lg:text-3xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD] tracking-tight">
            {currentLang === 'ta' 
              ? 'தினமும் ஒரு கதைக்கு அன்புடன் வரவேற்கிறோம்!' 
              : (currentLang === 'hi' 
                  ? 'डेली टेल में आपका हार्दिक स्वागत है!' 
                  : 'Welcome to Daily Tale — Timeless Wisdom for Every Generation')}
          </h2>
          <p class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF] max-w-2xl leading-relaxed">
            {currentLang === 'ta'
              ? 'குழந்தைகள், மாணவர்கள் மற்றும் குடும்பங்களுக்கான நற்பண்பு நீதிக்கதைகள், வரலாற்று நாட்டுப்புறக் கதைகள் மற்றும் தூக்க நேரக் கதைகளின் பாதுகாப்பான, விளம்பரங்கள் அற்ற பண்பாட்டு இல்லம்.'
              : (currentLang === 'hi'
                  ? 'बच्चों, परिवारों और शिक्षकों के लिए नैतिक कथाओं, लोककथाओं और ज्ञानवर्धक कहानियों का विज्ञापन-रहित सुरक्षित संसार।'
                  : 'An ad-free, child-safe sanctuary offering timeless moral fables, cultural folktales, and bilingual bedtime stories across 8+ world languages.')}
          </p>
        </div>

        <a
          href={`/${currentLang}/guide/`}
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-[#FFF8EC] dark:bg-[#151426] border border-[#EEDFC8] dark:border-[#383659] text-xs font-bold text-[#D97706] hover:border-[#D97706] transition-all self-start md:self-auto shrink-0 shadow-2xs"
        >
          <span>📘</span>
          <span>{currentLang === 'ta' ? 'முழு வழிகாட்டி' : (currentLang === 'hi' ? 'मार्गदर्शिका' : 'Reading Guide')} →</span>
        </a>
      </div>

      <!-- How to Effectively Use (4 Educational Pillars) -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-[#6B5644] dark:text-[#C8BFAF]">
          💡 {currentLang === 'ta' ? 'எவ்வாறு பயனுறக் கற்கலாம்? (வழிகாட்டி)' : (currentLang === 'hi' ? 'कहानियों का सर्वोत्तम उपयोग कैसे करें?' : 'How to Get the Most Out of Every Story')}
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          
          <!-- Card 1: Audio Read-Along -->
          <div class="p-4 rounded-2xl bg-[#FFF8EC] dark:bg-[#151426] border border-[#EEDFC8]/80 dark:border-[#383659] space-y-2">
            <div class="w-9 h-9 rounded-xl bg-teal-500/15 text-teal-600 dark:text-teal-400 flex items-center justify-center text-lg font-bold">
              🎧
            </div>
            <h4 class="text-sm font-bold text-[#3B2A1A] dark:text-[#F3EBDD]">
              {currentLang === 'ta' ? '1. கேட்டு வாசியுங்கள்' : (currentLang === 'hi' ? '1. सुनकर पढ़ें' : '1. Listen & Read-Along')}
            </h4>
            <p class="text-xs text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
              {currentLang === 'ta'
                ? 'ஒலிப்பானை (Play) அழுத்தி இயற்கையான வாசிப்பைக் கேளுங்கள்; வாசிக்கும் சொற்கள் நிறம் மாறுவதால் உச்சரிப்பும் கேட்டல் திறனும் கூடும்.'
                : (currentLang === 'hi'
                    ? 'प्ले बटन दबाकर कथावाचन सुनें। शब्द स्वतः हाइलाइट होते हैं जिससे उच्चारण और भाषा पकड़ मजबूत होती है।'
                    : 'Click Play to hear speech narration while words highlight in sync — boosting fluency, pronunciation, and listening comprehension.')}
            </p>
          </div>

          <!-- Card 2: Bilingual Mode -->
          <div class="p-4 rounded-2xl bg-[#FFF8EC] dark:bg-[#151426] border border-[#EEDFC8]/80 dark:border-[#383659] space-y-2">
            <div class="w-9 h-9 rounded-xl bg-amber-500/15 text-amber-600 dark:text-amber-400 flex items-center justify-center text-lg font-bold">
              🌐
            </div>
            <h4 class="text-sm font-bold text-[#3B2A1A] dark:text-[#F3EBDD]">
              {currentLang === 'ta' ? '2. இருமொழி ஒப்பீடு' : (currentLang === 'hi' ? '2. द्विभाषी अध्ययन' : '2. Bilingual Mode')}
            </h4>
            <p class="text-xs text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
              {currentLang === 'ta'
                ? 'தாய்மொழி கதைகளை ஆங்கிலத்துடன் பக்கவாட்டில் ஒப்பிட்டுப் படித்து இருமொழி சொல்லாற்றலை எளிதாகப் பெருக்கலாம்.'
                : (currentLang === 'hi'
                    ? 'कहानियों को अंग्रेजी और अपनी भाषा में समानांतर पढ़कर शब्दावली और अनुवाद कौशल सहजता से बढ़ाएँ।'
                    : 'Switch side-by-side between regional folklore and English to build vocabulary and contextual translation skills effortlessly.')}
            </p>
          </div>

          <!-- Card 3: Think & Talk Quizzes -->
          <div class="p-4 rounded-2xl bg-[#FFF8EC] dark:bg-[#151426] border border-[#EEDFC8]/80 dark:border-[#383659] space-y-2">
            <div class="w-9 h-9 rounded-xl bg-orange-500/15 text-orange-600 dark:text-orange-400 flex items-center justify-center text-lg font-bold">
              💡
            </div>
            <h4 class="text-sm font-bold text-[#3B2A1A] dark:text-[#F3EBDD]">
              {currentLang === 'ta' ? '3. வினாடி வினா & சிந்தனை' : (currentLang === 'hi' ? '3. प्रश्नोत्तरी व संवाद' : '3. Think & Talk Quizzes')}
            </h4>
            <p class="text-xs text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
              {currentLang === 'ta'
                ? 'ஒவ்வொரு கதையின் முடிவிலும் உள்ள 3 எளிய வினாக்களுக்கு விடையளித்து கதையின் நன்னெறிகளை குடும்பத்துடன் உரையாடுங்கள்.'
                : (currentLang === 'hi'
                    ? 'हर कहानी के अंत में 3 सरल प्रश्नों के उत्तर देकर सीख पर चर्चा करें और नैतिक मूल्य आत्मसात करें।'
                    : 'Check understanding with 3 quick interactive quiz questions and thoughtful conversation prompts after each tale.')}
            </p>
          </div>

          <!-- Card 4: Calming Bedtime & Focus -->
          <div class="p-4 rounded-2xl bg-[#FFF8EC] dark:bg-[#151426] border border-[#EEDFC8]/80 dark:border-[#383659] space-y-2">
            <div class="w-9 h-9 rounded-xl bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-lg font-bold">
              🌙
            </div>
            <h4 class="text-sm font-bold text-[#3B2A1A] dark:text-[#F3EBDD]">
              {currentLang === 'ta' ? '4. கண் சோர்வற்ற வாசிப்பு' : (currentLang === 'hi' ? '4. शांत रात्रि वाचन' : '4. Bedtime & Aa Focus')}
            </h4>
            <p class="text-xs text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed">
