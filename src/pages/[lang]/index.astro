---
import brandConfig from '../../../config/brand.json';
import { getT } from '../../lib/i18n';
import { getAllReviewedStories, getTodaysStory, getSurpriseStory, getGenresWithCounts, getCollectionsWithCounts, getStoryUrl } from '../../lib/stories';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MascotCompanion from '../../components/MascotCompanion.astro';
import StoryGarden from '../../components/StoryGarden.astro';
import StoryPassport from '../../components/StoryPassport.astro';

export function getStaticPaths() {
  return brandConfig.supportedLanguages.map(l => ({
    params: { lang: l.code }
  }));
}

const { lang } = Astro.params;
const t = getT(lang);
const localizedMeta = (brandConfig.localizedBrand as Record<string, any>)[lang] || brandConfig.localizedBrand.en;

const stories = getAllReviewedStories(lang);
const todaysStory = getTodaysStory(lang);
const surpriseStory = getSurpriseStory(lang, todaysStory?.id);

const genresCount = getGenresWithCounts(lang);
const collectionsCount = getCollectionsWithCounts(lang);

// Available moods for interactive mood picker
const moods = [
  { id: 'happy', label: 'Happy & Joyful', icon: '😄' },
  { id: 'calm', label: 'Calm & Relaxed', icon: '🍃' },
  { id: 'brave', label: 'Brave & Bold', icon: '🦁' },
  { id: 'curious', label: 'Curious & Wondering', icon: '✨' },
  { id: 'comforting', label: 'Comforting Bedtime', icon: '🌙' },
  { id: 'funny', label: 'Funny & Silly', icon: '🤪' }
];
---

<BaseLayout
  title={localizedMeta.title}
  description={localizedMeta.metaDescription}
  lang={lang}
  ogImage={todaysStory?.image || '/images/og-default.svg'}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-12 sm:space-y-16">
    
    <!-- Katha Mascot Welcome Banner -->
    <MascotCompanion tip={`"Welcome to today's reading journey in ${brandConfig.supportedLanguages.find(l => l.code === lang)?.native}! Read with an open heart and gentle curiosity."`} />

    <!-- 1. "Today's Story" Hero Card -->
    {todaysStory && (
      <section class="relative rounded-3xl bg-linear-to-br from-amber-100 via-orange-50 to-amber-100/40 dark:from-slate-900 dark:via-slate-800 dark:to-slate-900 p-6 sm:p-10 border border-amber-300 dark:border-slate-700 shadow-md overflow-hidden">
        
        <div class="flex flex-col lg:flex-row items-center justify-between gap-8">
          
          <div class="flex-1 space-y-4">
            
            <div class="flex flex-wrap items-center gap-2">
              <span class="px-3.5 py-1 rounded-full bg-amber-500 text-white font-black text-xs uppercase tracking-wider shadow-xs">
                ⭐ {t.todaysStory}
              </span>
              <span class="px-3 py-1 rounded-full bg-white dark:bg-slate-800 border border-amber-200 dark:border-slate-700 text-xs font-bold text-slate-700 dark:text-slate-300">
                {todaysStory.genre}
              </span>
              <span class="px-3 py-1 rounded-full bg-white dark:bg-slate-800 border border-amber-200 dark:border-slate-700 text-xs font-bold text-slate-700 dark:text-slate-300">
                {todaysStory.collection}
              </span>
              <span class="text-xs text-slate-500 font-medium">
                ⏱️ {todaysStory.reading_time}
              </span>
            </div>

            <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
              {todaysStory.title}
            </h1>

            <p class="text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed max-w-2xl">
              {todaysStory.summary}
            </p>

            <!-- Moral Preview Box -->
            <div class="p-4 rounded-2xl bg-white/80 dark:bg-slate-800/80 border border-amber-200 dark:border-slate-700">
              <span class="text-xs font-bold text-amber-800 dark:text-amber-300 uppercase tracking-wider block mb-1">
                {t.moral}:
              </span>
              <span class="text-xs sm:text-sm italic font-medium text-slate-800 dark:text-slate-200">
                "{todaysStory.moral}"
              </span>
            </div>

            <!-- Action Buttons: Read Story & Surprise Me -->
            <div class="flex flex-wrap items-center gap-3 pt-2">
              <a
                href={getStoryUrl(todaysStory, lang)}
                class="px-6 py-3.5 rounded-full bg-amber-500 hover:bg-amber-600 text-white font-extrabold text-sm sm:text-base shadow-lg hover:shadow-amber-500/25 transition-all flex items-center gap-2"
              >
                <span>📖 {t.readStory}</span>
                <span>→</span>
              </a>

              {surpriseStory && (
                <a
                  href={getStoryUrl(surpriseStory, lang)}
                  class="px-5 py-3 rounded-full bg-white dark:bg-slate-800 border border-amber-300 dark:border-slate-700 hover:bg-amber-50 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 font-bold text-sm shadow-xs transition-all flex items-center gap-2"
                >
                  <span>🎲</span>
                  <span>{t.surpriseMe}</span>
                </a>
              )}
            </div>

          </div>

          <!-- Hero Image Illustration -->
          <div class="w-full lg:w-96 shrink-0">
            <div class="aspect-4/3 rounded-2xl overflow-hidden shadow-xl border-4 border-white dark:border-slate-800">
              <img
                src={todaysStory.image}
                alt={todaysStory.image_alt}
                loading="eager"
                class="w-full h-full object-cover"
              />
            </div>
          </div>

        </div>
      </section>
    )}

    <!-- 2. Interactive Mood Picker ("How are you feeling today?") -->
    <section class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-amber-200 dark:border-slate-800 shadow-sm">
      <div class="text-center max-w-xl mx-auto mb-6">
        <h2 class="text-lg sm:text-2xl font-black text-slate-900 dark:text-white mb-1">
          {t.howAreYouFeeling}
        </h2>
        <p class="text-xs sm:text-sm text-slate-500">
          Pick your mood and let Katha find a gentle, matching story for your heart.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
        {moods.map(m => (
          <a
            href={`/${lang}/search/?mood=${m.id}`}
            class="p-4 rounded-2xl bg-amber-50/60 dark:bg-slate-800/60 border border-amber-100 dark:border-slate-700 hover:border-amber-400 hover:scale-105 text-center transition-all group"
          >
            <div class="text-3xl mb-1 group-hover:scale-110 transition-transform">{m.icon}</div>
            <div class="text-xs font-bold text-slate-800 dark:text-slate-200">{m.label}</div>
          </a>
        ))}
      </div>
    </section>

    <!-- 3. Latest Stories Grid -->
    <section>
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">
            {t.latestStories}
          </h2>
          <p class="text-xs sm:text-sm text-slate-500">
            Timeless fables and moral folktales translated with care
          </p>
        </div>
        <a href={`/${lang}/search/`} class="text-xs sm:text-sm font-bold text-amber-600 hover:underline">
          View all stories →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {stories.map(s => (
          <article class="bg-white dark:bg-slate-900 rounded-3xl border border-amber-200 dark:border-slate-800 shadow-sm hover:shadow-md transition-shadow overflow-hidden flex flex-col justify-between">
            <div>
              <div class="aspect-16/10 overflow-hidden relative">
                <img
                  src={s.image}
                  alt={s.image_alt}
                  loading="lazy"
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                />
                <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-black/60 backdrop-blur-sm text-white text-[11px] font-bold">
                  {s.collection}
                </span>
                <span class="absolute bottom-3 right-3 px-2.5 py-0.5 rounded-full bg-amber-500 text-white text-[11px] font-bold">
                  ⏱️ {s.reading_time}
                </span>
              </div>

              <div class="p-6">
                <div class="flex items-center gap-2 text-xs text-slate-400 mb-2">
                  <span>{s.culture_region}</span>
                  <span>•</span>
                  <span>{s.age_group}</span>
                </div>

                <h3 class="text-lg font-bold text-slate-900 dark:text-white leading-snug mb-2 hover:text-amber-600 transition-colors">
                  <a href={getStoryUrl(s, lang)}>
                    {s.title}
                  </a>
                </h3>

                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 line-clamp-3 mb-4 leading-relaxed">
                  {s.summary}
                </p>

                <div class="p-3 rounded-xl bg-amber-50 dark:bg-slate-800 text-xs text-amber-900 dark:text-amber-200 italic">
                  💡 {s.moral}
                </div>
              </div>
            </div>

            <div class="px-6 pb-6 pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
              <span class="text-xs text-slate-400">
                Level: <strong>{s.reading_level}</strong>
              </span>
              <a
                href={getStoryUrl(s, lang)}
                class="px-4 py-2 rounded-full bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs shadow-xs transition-colors"
              >
                {t.readStory} →
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 4. Story Garden & World Story Passport Widgets -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <StoryGarden />
      <StoryPassport />
    </div>

  </div>
</BaseLayout>
