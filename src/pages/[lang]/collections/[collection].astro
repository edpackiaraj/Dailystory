---
import fs from 'node:fs';
import path from 'node:path';
import brandConfig from '../../../../config/brand.json';
import { getT } from '../../../lib/i18n';
import { getAllReviewedStories, getStoriesByCollection } from '../../../lib/stories';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  const manifestPath = path.resolve(process.cwd(), 'data', 'en', 'manifest-en.json');
  let allCollections: string[] = [];
  if (fs.existsSync(manifestPath)) {
    try {
      const manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));
      allCollections = Array.from(new Set(manifest.map((m: any) => m.collection))).filter(Boolean) as string[];
    } catch {}
  }
  if (!allCollections.length) {
    allCollections = [
      "Cinderella Stories", "Akbar–Birbal", "Panchatantra", "Tenali Rama",
      "Aesop's Fables", "Grimm Fairy Tales", "Hans Christian Andersen", "Mulla Nasruddin",
      "Jataka Tales", "Charles Perrault", "Arabian Nights", "Vikram–Vetal", "Paramartha Guru"
    ];
  }

  const paths: any[] = [];
  for (const lang of brandConfig.supportedLanguages) {
    for (const c of allCollections) {
      const colSlug = c.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      paths.push({
        params: { lang: lang.code, collection: `${lang.code}-collection-${colSlug}` },
        props: { rawCollection: c, colSlug }
      });
    }
  }
  return paths;
}

const { lang, collection } = Astro.params;
const { rawCollection, colSlug: propColSlug } = Astro.props;
const t = getT(lang);
const colSlug = propColSlug || collection?.replace(new RegExp(`^${lang}-collection-`), '') || 'world-folktales';

// Load only the specific collection to maximize performance
const collectionStories = getStoriesByCollection(lang, rawCollection);
const matchingStories = collectionStories.filter(s => s.reviewed !== false && s.status === 'published');

const hasMinStories = matchingStories.length >= 5;
const firstStory = matchingStories[0] || null;

// Comprehensive 300+ word collection overviews
const collectionIntros: Record<string, string> = {
  "cinderella-stories": "The Cinderella story is one of humanity's most enduring folktales, told across every continent and spanning more than two thousand years. From the ancient Egyptian tale of Rhodopis and the golden falcon sandal recorded in the first century BCE, to the ninth-century Chinese Tang Dynasty account of gentle Yeh-Shen and her magical fish, to Giambattista Basile's seventeenth-century Neapolitan Cenerentola and Charles Perrault's iconic French glass slipper retelling, the core of the tale remains universal. Cinderella is not a passive damsel waiting for rescue; across world cultures, she represents patient industry, gentle kindness to living creatures, resilience in the face of unfairness, and the triumph of inner character over outward arrogance. This dedicated collection brings together authentic world Cinderella variants, inviting children to compare how diverse cultures celebrate humility and moral grace.",
  "akbar-birbal": "The legendary tales of Emperor Akbar and his witty minister Birbal form the crown jewel of Mughal and North Indian courtly folklore, popularized in classical anthologies like the famous 175 Stories of Akbar and Birbal. Strolling through the red sandstone pavilions of Fatehpur Sikri and the marble terraces of Agra, Akbar frequently challenged his courtiers with impossible riddles, puzzling disputes, and deep ethical dilemmas. Birbal, endowed with radiant wit, psychological discernment, and unwavering integrity, always delivered solutions that disarmed greed and exposed foolishness with gentle humor. Rather than humiliating opponents, Birbal's wisdom held up a compassionate mirror to human nature, teaching children that presence of mind, empathy, and creative problem-solving are far mightier than anger or force.",
  "panchatantra": "The Panchatantra is an ancient Sanskrit anthology of interconnected animal fables composed over two thousand years ago by Pandit Vishnu Sharma. Written to instruct three young princes in practical wisdom (niti) and human relations, these stories illustrate how presence of mind, sincere friendship, and ethical foresight overcome raw force and deceit. Divided into five classical books—The Loss of Friends, Winning of Friends, Crows and Owls, Loss of Gains, and Ill-Considered Action—the Panchatantra traveled across Asia and Europe, inspiring the Arabian Kalila wa Dimna and La Fontaine's fables. In our retellings, every story is gently adapted for modern children, retaining the timeless brilliance of clever rabbits, wise tortoises, and loyal forest companions while instilling deep values of empathy and peaceful conflict resolution.",
  "tenali-rama": "Tenali Rama, the celebrated court jester and poet-philosopher of the sixteenth-century Vijayanagara Empire under King Krishna Deva Raya, is revered throughout South India for his quick thinking, brilliant satire, and fearless defense of justice. Tenali possessed the unique ability to turn absurd royal decrees and greedy court schemes upside down using humor, logic, and profound common sense. From training a cat that feared warm milk to protect royal granaries, to painting a horse with only its tail showing to expose intellectual arrogance, Tenali's tales teach children how to question pompous assumptions, value hard work, and use laughter as a force for fairness.",
  "aesops-fables": "Aesop's Fables originated in ancient Greece during the sixth century BCE, credited to the legendary storyteller Aesop. Spanning stories of the boastful hare, the thirsty crow, the boy who cried wolf, and the mouse who aided the lion, these parables have shaped global ethical education for millennia. Each fable uses concise animal archetypes to illuminate everyday virtues such as humility, foresight, modesty, and kindness. Children learn that haste often trips over itself, and that quiet consistency triumphs over arrogance. Our retold collection brings these classic Greek fables to life with warmth and modern linguistic accessibility.",
  "grimm-fairy-tales": "The Brothers Grimm, Jacob and Wilhelm, spent decades in nineteenth-century Germany documenting oral folk tales told by village grandmothers, foresters, and travelers. Their stories—including The Elves and the Shoemaker, The Bremen Town Musicians, The Frog Prince, The Golden Goose, and The Star Talers—speak to the resilience of the humble, the beauty of keeping promises, and the wonder of generosity. In our family-safe adaptations, we celebrate the warmth and perseverance of these tales, free from graphic dread, highlighting teamwork, loyalty, and empathy.",
  "hans-christian-andersen": "Hans Christian Andersen of Denmark elevated the fairy tale into high poetic art. His deeply touching stories—such as The Ugly Duckling, The Emperor's New Clothes, and The Little Fir Tree—explore the profound emotional landscape of belonging, courage in speaking truth to power, and the mindfulness of savoring each day. Andersen's tales speak gently to the sensitive hearts of children, reassuring them that feeling different or awkward in youth is often the quiet cocoon before spreading majestic swan wings.",
  "mulla-nasruddin": "Mulla Nasruddin is the beloved satirical folk figure of Middle Eastern, Mediterranean, and Central Asian lore. Playing the dual role of the wise fool and the philosophical teacher, Nasruddin's humorous adventures expose human hypocrisy, pretension, and self-delusion with unforgettable wit. Whether feeding pilaf into his silk coat sleeves to teach a lesson on social superficiality or searching for his lost keys under a bright street lamp simply because the light is better there, Nasruddin invites readers of all ages to laugh at themselves and look deeper into the human heart.",
  "jataka-tales": "The Jataka Tales are an ancient Buddhist collection of animal parables and folk legends that originated in India over two millennia ago. Each story illustrates the cultivation of a fundamental virtue: compassion (karuna), generosity (dana), self-control, and moral leadership. In tales such as The Golden Swan and The Monkey King, readers encounter noble creatures who risk their own comfort and safety to protect the vulnerable, showing that true greatness is found in humble, selfless service.",
  "chinese-folktales-and-fables": "Chinese folklore and fables draw upon centuries of deep philosophical harmony with nature, respect for family, and the quiet triumph of virtue over pride. Spanning ancient dynastic tales, bamboo grove allegories, and agrarian proverbs like Sai Weng Shi Ma (The Old Man at the Frontier), these stories highlight the value of genuine honesty, equanimity, and steadfast diligence. These tales offer serene, contemplative bedtimes and enriching classroom discussions for children of all backgrounds.",
  "arabian-nights": "The Arabian Nights, known across centuries as One Thousand and One Nights (Alf Layla wa-Layla), is one of the grandest narrative tapestries in human civilization. Born from oral storytelling traditions that flowed along the Silk Road between ancient Persia, India, Arabia, Iraq, and North Africa, the collection is unified by the brilliant frame narrative of Scheherazade. Facing the bitter decree of King Shahryar, Scheherazade deploys the healing power of storytelling night after night, spinning interconnected tales of seafaring voyages, flying carpets, and philosophical riddles to restore the king's faith in humanity. In our family-safe edition of 419 tales, readers accompany Sindbad across uncharted seas, discover Aladdin's miraculous lamp of industrious courage, and outwit treacherous thieves with the quick-witted servant Morgiana. These tales teach children that sharp intellect, moral courage, compassion for the distressed, and loyalty outshine all the gold of caliphs.",
  "vikram-vetal": "The legendary tales of King Vikramaditya and the Vetal (Baital Pachisi or Vetala Panchavimshati) originated in ancient Sanskrit lore as documented in Somadeva's eleventh-century Kathasaritsagara. Tasked by an ascetic with carrying a mysterious celestial spirit (the Vetal) across a dark cremation ground without speaking a single word, the noble King Vikramaditya faces twenty-five profound moral, legal, and ethical riddles. At the conclusion of each gripping tale, the Vetal challenges the king: if he knows the true, just answer and remains silent, his head will shatter; but if he speaks to deliver judgment, the Vetal slips back to the tree. Vikram–Vetal is an intellectual and ethical gymnasium, challenging young minds to weigh justice, filial duty, royal obligation, love, and righteousness under complex circumstances.",
  "paramartha-guru": "The hilarious and timeless satire of Guru Paramartha and his four simple disciples—Matti (The Simpleton), Madaiyan (The Blockhead), Muttal (The Fool), and Asadan (The Dunce)—was composed in eighteenth-century Tamil Nadu by the Italian Jesuit scholar and Tamil poet Constanzo Beschi (known affectionately as Veeramamunivar). Written to make Tamil folk wisdom accessible through rollicking laughter, the stories chronicle the absurd adventures of an earnest but profoundly gullible village preceptor and his overly literal students. Whether counting themselves and weeping because they forgot to count the counter, trying to carry their wounded horse across a stream, or mistaking a pumpkin for a mare's egg, the tales teach children not to follow authority blindly, to think critically rather than interpreting words with mindless literalism, and to value common sense.",
  "charles-perrault": "Charles Perrault was the pioneering French author and member of the Académie Française who, in 1697, published Histoires ou contes du temps passé (Stories from Times Past), immortalizing Tales of Mother Goose and establishing the literary fairy tale as a refined European art form. Introducing the world to iconic masterpieces such as Cinderella with her glass slipper, the clever Puss in Boots, Sleeping Beauty in the Woods, and Little Red Riding Hood, Perrault transformed rustic folklore into elegant courtly parables. In our family-safe retellings, every story concludes with an inspiring moral reflection emphasizing prudence, fidelity, the power of wit over brute force, and the enduring beauty of genuine kindness.",
  "sheikh-chilli": "Sheikh Chilli is the legendary, affectionate folk figure of South Asian and North Indian oral storytelling, celebrated for his innocent daydreams and whimsical logic. Like the famous daydreamer who planned to conquer empires with a basket of eggs only to kick it over, Sheikh Chilli embodies the hilarious consequences of building castles in the air without watching where one steps. From calculating astronomical wealth while carrying a jar of oil on his head to hiring tutors to teach him how to sleep with his eyes open, Chilli's misadventures bring joyful laughter to families and classrooms, teaching children the indispensable value of grounding dreams in practical, honest action.",
  "mariyadai-raman": "Mariyadai Raman is the celebrated folk magistrate and embodiment of judicial wisdom in South Indian and Tamil folklore, revered as the King Solomon of the Coromandel coast. Appointed to settle the most convoluted and contentious disputes in the kingdom, Mariyadai Raman possessed a profound understanding of human psychology, forensic observation, and natural justice. From resolving disputes between two mothers claiming a single infant to exposing deceitful moneylenders who hid gold inside hollow walking sticks, Raman's verdicts were legendary for their poetic fairness. His tales teach young readers how to analyze evidence with patience, avoid jumping to hasty conclusions, and uphold justice with compassion.",
  "simhasana-battisi": "The Simhasana Battisi (The Thirty-Two Tales of the Throne) is an ancient Sanskrit narrative cycle that tells of King Bhoja discovering the legendary buried throne of King Vikramaditya. Each time King Bhoja attempts to mount the jewel-encrusted steps of the celestial seat, one of the thirty-two carved statues supporting the throne comes to life, demanding whether Bhoja possesses the peerless courage, humility, generosity, and self-sacrifice of Vikramaditya. The collection teaches children that high office and royal prestige must be earned through moral greatness, selfless service to the weak, and absolute dedication to truth.",
  "la-fontaine": "Jean de La Fontaine was the master French poet and fabulist of the seventeenth century whose Fables Choisies elevated Aesopian allegories into poetic masterpieces of human psychology and political wit. Featuring unforgettable encounters such as The Grasshopper and the Ant, The Wolf and the Dog, and The Oak and the Reed, La Fontaine painted a vivid, satirical portrait of society through the voices of animals, teaching children to value quiet industry, avoid the traps of vain flattery, appreciate the freedom of a humble life, and meet the changing tides of fortune with resilience and grace.",
  "african-folktales": "African Folktales draw from the rich, communal oral storytelling traditions of diverse nations and tribes across the African continent, spanning West African Akan tales of Anansi the clever spider to Southern African legends of the baobab tree. Rooted in the profound philosophy of Ubuntu ('I am because we are'), these vibrant stories celebrate the harmony between humanity, wildlife, and nature. They demonstrate how community cooperation, sharing with neighbors, and clever ingenuity triumph over lumbering brute strength, teaching children the joy of unity, the necessity of humility, and the sacred duty to care for the earth.",
  "latin-american-folktales": "Latin American Folktales are a vibrant fusion of ancient Indigenous traditions (Maya, Aztec, Inca, Guaraní, and Mapuche) with Spanish, Portuguese, and Afro-Caribbean cultural influences. From the Andes mountains to the lush Amazon rainforest and sunny Caribbean shores, these tales celebrate magical realism, brave trickster heroes, respect for Mother Earth (Pachamama), and the indomitable resilience of the humble. Stories of rabbit tricksters outsmarting jaguars and enchanted condors protecting mountain villages teach young readers that love, family solidarity, courage, and environmental stewardship are the greatest treasures in life.",
  "tamil-folk": "Tamil Folk and Folk Humor stories stem from millennia of vibrant village culture, agricultural proverbs, and marketplace banter across Tamil Nadu. Featuring witty village headmen, clever grandmothers, humorous disputes between farmers, and playful tricksters, these tales capture the earthy wisdom and quick wit of the Tamil countryside. They instruct children in the art of living with humor, resolving disagreements through gentle compromise, respecting elderly wisdom, and finding profound ethical lessons in the simplest everyday moments.",
  "tamil-folk-humor": "Tamil Folk Humor stories celebrate the warmth, laughter, and sharp verbal repartee of rural Tamil life. Through comical misunderstandings, witty retorts between neighbors, and clever parables of village life, these stories demonstrate that a cheerful laugh can defuse anger, resolve thorny disputes, and bring communities together in mutual understanding."
};

const introText = collectionIntros[collection] || `Discover timeless classics from the ${rawCollection} anthology. Retold with linguistic elegance and deep respect for cultural traditions.`;

// Panchatantra Canonical 5-Tantra Syllabus
let panchatantraSyllabus: any = null;
if (collection === 'panchatantra') {
  try {
    const rawSyllabus = fs.readFileSync(path.resolve(process.cwd(), 'src', 'data', 'panchatantra-syllabus.json'), 'utf8');
    panchatantraSyllabus = JSON.parse(rawSyllabus);
  } catch (e) {
    console.error('Failed to load panchatantra syllabus:', e);
  }
}

function findMatchingStorySlug(itemTitle: string, stories: any[]) {
  const normItem = itemTitle.toLowerCase();
  const found = stories.find(st => {
    const stTitle = st.title.toLowerCase();
    if (stTitle.includes(normItem) || normItem.includes(stTitle)) return true;
    if (normItem.includes('wedge') && stTitle.includes('wedge')) return true;
    if (normItem.includes('war-drum') && stTitle.includes('drum')) return true;
    if (normItem.includes('heron') && stTitle.includes('heron')) return true;
    if (normItem.includes('iron') && stTitle.includes('iron')) return true;
    if (normItem.includes('numskull') && stTitle.includes('clever little rabbit')) return true;
    if (normItem.includes('lion-makers') && stTitle.includes('scholars')) return true;
    if (normItem.includes('castles in air') && stTitle.includes('flour')) return true;
    if (normItem.includes('black snake') && stTitle.includes('black snake')) return true;
    if (normItem.includes('elephant and sparrow') && stTitle.includes('sparrow')) return true;
    if (normItem.includes('bharunda') && stTitle.includes('bharunda')) return true;
    if (normItem.includes('elephant free') && stTitle.includes('elephant herd')) return true;
    if (normItem.includes('goat') && stTitle.includes('rogues')) return true;
    if (normItem.includes('cave that talked') && stTitle.includes('cave')) return true;
    if (normItem.includes('tiger-skin') && stTitle.includes('tiger')) return true;
    if (normItem.includes('single-wit') && stTitle.includes('single-wit')) return true;
    if (normItem.includes('mongoose') && stTitle.includes('mongoose')) return true;
    if (normItem.includes('blue jackal') && stTitle.includes('blue jackal')) return true;
    if (normItem.includes('monkey and crocodile') && stTitle.includes('crocodile')) return true;
    if (normItem.includes('crow, mouse') && stTitle.includes('four faithful')) return true;
    if (normItem.includes('slim and grim') && stTitle.includes('talkative turtle')) return true;
    return false;
  });
  return found ? found.slug : null;
}

// SEO: Rich JSON-LD Schemas (CollectionPage, BreadcrumbList, FAQPage)
const siteUrl = brandConfig.siteUrl.replace(/\/$/, '');
const collectionPageUrl = `${siteUrl}/${lang}/collections/${collection}/`;

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${rawCollection} Stories - Complete Interactive Anthology`,
  "description": introText.slice(0, 200),
  "url": collectionPageUrl,
  "inLanguage": lang,
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": matchingStories.length,
    "itemListElement": matchingStories.slice(0, 50).map((s, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "item": {
        "@type": "Article",
        "name": s.title,
        "headline": s.title,
        "description": s.summary,
        "url": `${collectionPageUrl}#${s.slug}`,
        "inLanguage": lang,
        "author": {
          "@type": "Person",
          "name": s.author || "World Folklore"
        }
      }
    }))
  }
};

const collectionKeywords = [
  rawCollection.toLowerCase(),
  `${rawCollection.toLowerCase()} stories`,
  `${rawCollection.toLowerCase()} stories online`,
  `${rawCollection.toLowerCase()} with moral`,
  "traditional folktales",
  "bedtime stories for children",
  "moral stories in 10 languages",
  "read folklore with audio"
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": `${siteUrl}/${lang}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Collections",
      "item": `${siteUrl}/${lang}/#collections`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": rawCollection,
      "item": collectionPageUrl
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `What is the ${rawCollection} collection?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": introText
      }
    },
    {
      "@type": "Question",
      "name": `How many stories are in the ${rawCollection} anthology?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Our collection contains ${matchingStories.length} complete, family-safe stories with full literary text, audio narration, vocabulary guides, Bloom's Taxonomy reflection questions, and comprehension quizzes.`
      }
    },
    {
      "@type": "Question",
      "name": `What age group are ${rawCollection} stories designed for?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `These stories are crafted for children of all ages, perfect for independent young readers, cozy bedtime stories, and classroom moral education.`
      }
    },
    {
      "@type": "Question",
      "name": `Can I listen to audio narration for ${rawCollection}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Yes, every story includes interactive browser speech narration with adjustable reading speeds (0.75x, 1.0x, 1.25x) and soothing ambient background soundscapes.`
      }
    }
  ]
};
---

<BaseLayout
  title={`${rawCollection} Stories - Read ${matchingStories.length} Illustrated Folktales Online | ${brandConfig.name}`}
  description={`Read all ${matchingStories.length} ${rawCollection} stories in full unabridged text with audio narration, discussion questions, moral reflections, and quizzes in 10 languages.`}
  keywords={collectionKeywords}
  lang={lang}
  noindex={!hasMinStories}
  jsonLd={[collectionSchema, breadcrumbSchema, faqSchema]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    <!-- Breadcrumb Navigation -->
    <nav class="mb-6 text-xs text-slate-500 flex items-center gap-2">
      <a href={`/${lang}/`} class="hover:text-amber-600">Home</a>
      <span>/</span>
      <span>Collections</span>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold">{rawCollection}</span>
    </nav>

    <!-- Collection Header & Rich Context -->
    <div class="mb-10 rounded-3xl bg-linear-to-br from-amber-50 via-orange-50/50 to-white dark:from-slate-900 dark:via-slate-850 dark:to-slate-900 p-6 sm:p-10 border border-amber-200 dark:border-slate-800 shadow-sm">
      <div class="max-w-4xl">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500 text-white text-xs font-black uppercase tracking-wider mb-4 shadow-xs">
          <span>🏛️</span>
          <span>Anthology Hub • {matchingStories.length} {matchingStories.length === 1 ? 'Story' : 'Stories'} Available</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight mb-4">
          {rawCollection}
        </h1>
        <p class="text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed font-serif">
          {introText}
        </p>

        {!hasMinStories && (
          <div class="mt-4 p-3 rounded-xl bg-slate-100 dark:bg-slate-800 text-xs text-slate-500 italic">
            * Notice: Stories in this collection are currently being expanded. Kept noindex until 5 stories are fully verified.
          </div>
        )}
      </div>
    </div>

    {matchingStories.length > 0 && firstStory ? (
      <div>
        <!-- Interactive Story Selector Bar -->
        <div class="mb-8 sticky top-16 z-20 p-4 rounded-2xl bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border border-amber-300 dark:border-slate-700 shadow-md">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            
            <div class="flex items-center gap-3">
              <span class="text-xs font-black uppercase tracking-wider text-amber-800 dark:text-amber-400 shrink-0">
                📖 Switch Story:
              </span>
              
              <!-- Story Dropdown Picker -->
              <select
                id="story-dropdown-selector"
                aria-label="Choose story from this collection"
                class="w-full md:w-80 px-3 py-2 rounded-xl bg-amber-50 dark:bg-slate-800 border border-amber-300 dark:border-slate-600 text-xs font-bold text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-amber-500"
              >
                {matchingStories.map((s, idx) => (
                  <option value={s.slug}>
                    #{idx + 1}: {s.title} ({s.reading_time})
                  </option>
                ))}
              </select>
            </div>

            <!-- Quick Prev / Next Buttons -->
            <div class="flex items-center gap-2 shrink-0">
              <button
                id="prev-story-btn"
                type="button"
                class="px-4 py-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold hover:bg-amber-50 dark:hover:bg-slate-700 transition-colors flex items-center gap-1.5"
              >
                <span>⬅</span>
                <span>Previous Story</span>
              </button>
              
              <button
                id="next-story-btn"
                type="button"
                class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold transition-colors flex items-center gap-1.5 shadow-xs"
              >
                <span>Next Story</span>
                <span>➡</span>
              </button>
            </div>

          </div>

          <!-- Horizontal Story Quick Pills -->
          <div class="mt-3 pt-3 border-t border-slate-100 dark:border-slate-800 overflow-x-auto no-scrollbar flex items-center gap-2">
            {matchingStories.map((s, idx) => (
              <button
                type="button"
                data-story-slug={s.slug}
                class="story-quick-chip px-3 py-1.5 rounded-full text-xs font-bold whitespace-nowrap transition-all border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:border-amber-400"
              >
                #{idx + 1} {s.title.split(':')[0]}
              </button>
            ))}
          </div>
        </div>

        <!-- THE ACTIVE STORY READING PANE -->
        <main id="active-story-pane" class="mb-16 bg-white dark:bg-slate-900 rounded-3xl border border-amber-200 dark:border-slate-800 shadow-md p-6 sm:p-10">
          
          <!-- Story Header -->
          <header class="mb-6 border-b border-slate-100 dark:border-slate-800 pb-6">
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span id="active-story-genre" class="px-3 py-1 rounded-full bg-amber-100 dark:bg-amber-950 text-amber-900 dark:text-amber-300 text-xs font-bold">
                {firstStory.genre}
              </span>
              <span id="active-story-time" class="px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-bold">
                ⏱️ {firstStory.reading_time}
              </span>
              <span id="active-story-age" class="px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-bold">
                Age: {firstStory.age_group}
              </span>
              <span id="active-story-level" class="px-3 py-1 rounded-full bg-indigo-100 dark:bg-indigo-950 text-indigo-900 dark:text-indigo-300 text-xs font-bold">
                Level: {firstStory.reading_level}
              </span>
            </div>

            <h2 id="active-story-title" class="text-2xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight mb-3">
