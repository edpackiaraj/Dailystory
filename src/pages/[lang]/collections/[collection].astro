---
import fs from 'node:fs';
import path from 'node:path';
import brandConfig from '../../../../config/brand.json';
import { getT } from '../../../lib/i18n';
import {
  getAllReviewedStories,
  getStoriesByCollection,
  getCollectionSlug,
  getAudienceCategory,
  getLengthCategory,
  getStoryUrl,
  isStoryTranslated,
  type Story
} from '../../../lib/stories';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StoryIllustration from '../../../components/StoryIllustration.astro';

export function getStaticPaths() {
  const manifestPath = path.resolve(process.cwd(), 'data', 'en', 'manifest-en.json');
  let allCollections: string[] = [];
  if (fs.existsSync(manifestPath)) {
    try {
      const manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));
      allCollections = Array.from(new Set(manifest.map((m: any) => m.collection))).filter(Boolean) as string[];
    } catch {}
  }
  if (!allCollections.length) {
    allCollections = [
      "Cinderella Stories", "Akbar–Birbal", "Panchatantra", "Tenali Rama",
      "Aesop's Fables", "Grimm Fairy Tales", "Hans Christian Andersen", "Mulla Nasruddin",
      "Jataka Tales", "Charles Perrault", "Arabian Nights", "Vikram–Vetal", "Paramartha Guru"
    ];
  }

  const paths: any[] = [];
  for (const lang of brandConfig.supportedLanguages) {
    for (const c of allCollections) {
      const colSlug = c.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      // Clean path: /en/collections/aesop-s-fables/
      paths.push({
        params: { lang: lang.code, collection: colSlug },
        props: { rawCollection: c, colSlug }
      });
    }
  }
  return paths;
}

const { lang, collection } = Astro.params;
const { rawCollection, colSlug: propColSlug } = Astro.props;
const currentLang = lang || 'en';
const t = getT(currentLang);
const colSlug = propColSlug || collection?.replace(new RegExp(`^${currentLang}-collection-`), '') || 'world-folktales';

const collectionStories = getStoriesByCollection(currentLang, rawCollection);
const matchingStories = collectionStories
  .filter(s => s.reviewed !== false && s.status === 'published')
  .sort((a, b) => {
    if (currentLang === 'en') return 0;
    const aTr = isStoryTranslated(a, currentLang) ? 1 : 0;
    const bTr = isStoryTranslated(b, currentLang) ? 1 : 0;
    return bTr - aTr;
  });
const firstStory = matchingStories[0] || null;

