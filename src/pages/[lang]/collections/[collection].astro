---
import fs from 'node:fs';
import path from 'node:path';
import brandConfig from '../../../../config/brand.json';
import { getT } from '../../../lib/i18n';
import {
  getAllReviewedStories,
  getStoriesByCollection,
  getCollectionSlug,
  getAudienceCategory,
  getLengthCategory,
  getStoryUrl,
  type Story
} from '../../../lib/stories';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  const manifestPath = path.resolve(process.cwd(), 'data', 'en', 'manifest-en.json');
  let allCollections: string[] = [];
  if (fs.existsSync(manifestPath)) {
    try {
      const manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));
      allCollections = Array.from(new Set(manifest.map((m: any) => m.collection))).filter(Boolean) as string[];
    } catch {}
  }
  if (!allCollections.length) {
    allCollections = [
      "Cinderella Stories", "Akbar–Birbal", "Panchatantra", "Tenali Rama",
      "Aesop's Fables", "Grimm Fairy Tales", "Hans Christian Andersen", "Mulla Nasruddin",
      "Jataka Tales", "Charles Perrault", "Arabian Nights", "Vikram–Vetal", "Paramartha Guru"
    ];
  }

  const paths: any[] = [];
  for (const lang of brandConfig.supportedLanguages) {
    for (const c of allCollections) {
      const colSlug = c.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      // Clean path: /en/collections/aesop-s-fables/
      paths.push({
        params: { lang: lang.code, collection: colSlug },
        props: { rawCollection: c, colSlug }
      });
      // Legacy path: /en/collections/en-collection-aesop-s-fables/
      paths.push({
        params: { lang: lang.code, collection: `${lang.code}-collection-${colSlug}` },
        props: { rawCollection: c, colSlug }
      });
    }
  }
  return paths;
}

const { lang, collection } = Astro.params;
const { rawCollection, colSlug: propColSlug } = Astro.props;
const currentLang = lang || 'en';
const t = getT(currentLang);
const colSlug = propColSlug || collection?.replace(new RegExp(`^${currentLang}-collection-`), '') || 'world-folktales';

const collectionStories = getStoriesByCollection(currentLang, rawCollection);
const matchingStories = collectionStories.filter(s => s.reviewed !== false && s.status === 'published');
const firstStory = matchingStories[0] || null;

const collectionIntros: Record<string, string> = {
  "cinderella-stories": "The Cinderella story is one of humanity's most enduring folktales, told across every continent and spanning more than two thousand years. Across cultures, it celebrates humility, gentle kindness, and inner strength.",
  "akbar-birbal": "The legendary tales of Emperor Akbar and his witty minister Birbal form the crown jewel of courtly folklore. Birbal's wisdom holds a compassionate mirror to human nature, teaching that presence of mind is mightier than force.",
  "panchatantra": "The ancient Sanskrit animal fables composed over two thousand years ago by Pandit Vishnu Sharma. Divided into five books of niti (practical wisdom), they teach friendship, ethical foresight, and peaceful problem-solving.",
  "tenali-rama": "Tenali Rama, the celebrated court poet-philosopher of King Krishna Deva Raya, is revered for his quick wit, brilliant satire, and fearless defense of justice using laughter as a tool for fairness.",
  "aesops-fables": "Originating in ancient Greece in the sixth century BCE, these parables use animal archetypes to illuminate everyday virtues such as humility, perseverance, and modesty.",
  "grimm-fairy-tales": "Folk stories documented by Jacob and Wilhelm Grimm in nineteenth-century Germany, celebrating the resilience of the humble, the wonder of generosity, and the beauty of keeping promises.",
  "hans-christian-andersen": "Hans Christian Andersen of Denmark elevated the fairy tale into high poetic art, exploring the emotional landscape of belonging, courage, and discovering inner beauty.",
  "mulla-nasruddin": "Mulla Nasruddin of Middle Eastern, Mediterranean, and Central Asian lore plays the wise fool whose comical misadventures expose human hypocrisy with unforgettable warmth and laughter.",
  "jataka-tales": "Ancient Buddhist parables highlighting selfless compassion, truthfulness, and courage across diverse animal and human incarnations.",
  "arabian-nights": "The grand cycle of 1001 Nights retold with reverence, where cleverness, loyalty, and the healing wonder of storytelling restore peace and understanding.",
  "paramartha-guru": "Delightful South Indian satirical folklore chronicling the philosophical Guru Paramartha and his well-meaning yet hilariously literal disciples.",
  "vikram-vetal": "Classic Indian riddles between King Vikramaditya and the celestial riddle-telling Vetal, exploring ethical dilemmas and moral discernment."
};

const introText = collectionIntros[colSlug] || `Explore authentic, beautifully illustrated stories from the ${rawCollection} collection on Daily Tale.`;
const canonicalUrl = `${brandConfig.siteUrl}/${currentLang}/collections/${currentLang}-collection-${colSlug}/`;
---

<BaseLayout
  title={`${rawCollection} Stories`}
  description={introText}
  lang={currentLang}
  canonicalUrl={canonicalUrl}
  ogImage={firstStory?.image}
  activeNavTab="stories"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8">
    
    <!-- Header & Collection Intro -->
    <header class="space-y-4 max-w-4xl">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-[#6B5644] dark:text-[#C8BFAF]">
        <a href={`/${currentLang}/`} class="hover:text-[#D97706] transition-colors">{t.home}</a>
        <span>/</span>
        <a href={`/${currentLang}/collections/`} class="hover:text-[#D97706] transition-colors">{t.collections}</a>
        <span>/</span>
        <span class="text-[#3B2A1A] dark:text-[#F3EBDD] font-bold">{rawCollection}</span>
      </nav>

      <div class="flex items-center gap-3">
        <h1 class="text-3xl sm:text-5xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD] tracking-tight">
          {rawCollection}
        </h1>
        <span class="px-3.5 py-1 rounded-full bg-[#D97706]/15 text-[#D97706] dark:text-[#F59E0B] text-xs font-black">
          {matchingStories.length} {t.stories}
        </span>
      </div>

      <p class="text-sm sm:text-base text-[#6B5644] dark:text-[#C8BFAF] leading-relaxed max-w-3xl">
        {introText}
      </p>
    </header>

    <!-- Interactive Filter & Search Controls (Chips + Live Search) -->
    <section class="p-4 sm:p-6 rounded-3xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] shadow-sm space-y-4">
      
      <!-- Top Row: In-Collection Search -->
      <div class="relative">
        <span class="absolute inset-y-0 left-3.5 flex items-center pointer-events-none text-slate-400">
          🔍
        </span>
        <input
          type="search"
          id="collection-search-input"
          placeholder={`Search within ${rawCollection}...`}
          class="w-full pl-10 pr-4 py-3 rounded-2xl bg-[#FFF8EC] dark:bg-[#1B1A2E] border border-[#EEDFC8] dark:border-[#383659] text-sm text-[#3B2A1A] dark:text-[#F3EBDD] placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#D97706] transition-all"
        />
      </div>

      <!-- Filter Chips: Audience & Length -->
      <div class="flex flex-wrap items-center gap-4 text-xs">
        
        <!-- Audience Chips -->
        <div class="flex items-center gap-1.5 flex-wrap">
          <span class="font-bold text-[#6B5644] dark:text-[#C8BFAF] uppercase tracking-wider">{t.audience}:</span>
          <button type="button" class="filter-audience-chip px-3 py-1.5 rounded-full border border-[#D97706] bg-[#D97706] text-white font-bold transition-all" data-audience="all">
            {t.all}
          </button>
          <button type="button" class="filter-audience-chip px-3 py-1.5 rounded-full border border-[#EEDFC8] dark:border-[#383659] font-medium text-[#6B5644] dark:text-[#C8BFAF] hover:border-[#D97706] transition-all" data-audience="everyone">
            {t.everyone}
          </button>
          <button type="button" class="filter-audience-chip px-3 py-1.5 rounded-full border border-[#EEDFC8] dark:border-[#383659] font-medium text-[#6B5644] dark:text-[#C8BFAF] hover:border-[#D97706] transition-all" data-audience="kids">
            {t.kids}
          </button>
          <button type="button" class="filter-audience-chip px-3 py-1.5 rounded-full border border-[#EEDFC8] dark:border-[#383659] font-medium text-[#6B5644] dark:text-[#C8BFAF] hover:border-[#D97706] transition-all" data-audience="teens">
            {t.teens}
          </button>
        </div>

        <span class="text-[#EEDFC8] dark:text-[#383659] hidden sm:inline">|</span>

        <!-- Length Chips -->
        <div class="flex items-center gap-1.5 flex-wrap">
          <span class="font-bold text-[#6B5644] dark:text-[#C8BFAF] uppercase tracking-wider">{t.length}:</span>
          <button type="button" class="filter-length-chip px-3 py-1.5 rounded-full border border-[#D97706] bg-[#D97706] text-white font-bold transition-all" data-length="all">
            {t.all}
          </button>
          <button type="button" class="filter-length-chip px-3 py-1.5 rounded-full border border-[#EEDFC8] dark:border-[#383659] font-medium text-[#6B5644] dark:text-[#C8BFAF] hover:border-[#D97706] transition-all" data-length="short">
            {t.short}
          </button>
          <button type="button" class="filter-length-chip px-3 py-1.5 rounded-full border border-[#EEDFC8] dark:border-[#383659] font-medium text-[#6B5644] dark:text-[#C8BFAF] hover:border-[#D97706] transition-all" data-length="medium">
            {t.medium}
          </button>
          <button type="button" class="filter-length-chip px-3 py-1.5 rounded-full border border-[#EEDFC8] dark:border-[#383659] font-medium text-[#6B5644] dark:text-[#C8BFAF] hover:border-[#D97706] transition-all" data-length="long">
            {t.long}
          </button>
        </div>

      </div>

    </section>

    <!-- Story Grid (2 cols mobile, 3 cols tablet, 4 cols desktop) -->
    <div id="collection-stories-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-5">
      {matchingStories.map((story, idx) => {
        const aud = getAudienceCategory(story.age_group);
        const len = getLengthCategory(story.word_count);
        return (
          <article
            class={`story-card group p-3.5 sm:p-4 rounded-2xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] hover:border-[#D97706] hover:shadow-lg transition-all flex flex-col justify-between ${idx >= 12 ? 'hidden' : ''}`}
            data-index={idx}
            data-title={story.title.toLowerCase()}
            data-summary={(story.summary || '').toLowerCase()}
            data-audience={aud}
            data-length={len}
          >
            <div class="space-y-2.5">
              <div class="aspect-4/3 rounded-xl overflow-hidden bg-[#EEDFC8]/30">
                <img
                  src={story.image}
                  alt={story.title}
                  width="400"
                  height="300"
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </div>

              <div class="flex items-center justify-between text-[11px] text-[#6B5644] dark:text-[#C8BFAF]">
                <span class="px-2 py-0.5 rounded-md bg-[#0F766E]/10 text-[#0F766E] dark:text-[#2DD4BF] font-semibold">
                  {aud === 'kids' ? t.kids : (aud === 'teens' ? t.teens : t.everyone)}
                </span>
                <span>⏱ {story.reading_time || '4m'}</span>
              </div>

              <h2 class="text-xs sm:text-sm font-black text-[#3B2A1A] dark:text-[#F3EBDD] line-clamp-2 leading-snug group-hover:text-[#D97706] transition-colors">
                <a href={getStoryUrl(story, currentLang)}>
                  {story.title}
                </a>
              </h2>

              <p class="text-xs text-[#6B5644] dark:text-[#C8BFAF] line-clamp-2 leading-relaxed">
                {story.summary}
              </p>
            </div>

            <div class="pt-3 border-t border-[#EEDFC8]/60 dark:border-[#383659]/60 flex items-center justify-between text-xs mt-3">
              <span class="text-[11px] text-[#6B5644] dark:text-[#C8BFAF]">
                {story.word_count || 450} words
              </span>
              <a
                href={getStoryUrl(story, currentLang)}
                class="font-bold text-[#D97706] group-hover:translate-x-1 transition-transform"
              >
                Read →
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Empty State -->
    <div id="no-filter-results" class="hidden text-center py-12 space-y-2">
      <span class="text-3xl">🔍</span>
      <p class="text-sm font-bold text-[#3B2A1A] dark:text-[#F3EBDD]">{t.noResults}</p>
    </div>

    <!-- Load More Button (12 at a time) -->
    {matchingStories.length > 12 && (
      <div class="text-center pt-4" id="load-more-container">
        <button
          type="button"
          id="load-more-btn"
          class="px-8 py-3.5 rounded-full bg-white dark:bg-[#25243E] border-2 border-[#D97706] text-[#D97706] dark:text-[#F59E0B] hover:bg-[#D97706] hover:text-white font-black text-sm shadow-sm transition-all min-h-[48px]"
        >
          Load More Stories (12 more) ↓
        </button>
      </div>
    )}

  </div>
</BaseLayout>

<script is:inline>
  // Filter & Search & Load-More Logic
  let activeAudience = 'all';
  let activeLength = 'all';
  let searchQuery = '';
  let visibleLimit = 12;

  const cards = Array.from(document.querySelectorAll('.story-card'));
  const searchInput = document.getElementById('collection-search-input');
  const loadMoreBtn = document.getElementById('load-more-btn');
  const loadMoreContainer = document.getElementById('load-more-container');
  const noResults = document.getElementById('no-filter-results');

  function updateCards() {
    let matchCount = 0;

    cards.forEach(card => {
      const title = card.getAttribute('data-title') || '';
      const summary = card.getAttribute('data-summary') || '';
      const audience = card.getAttribute('data-audience') || '';
      const length = card.getAttribute('data-length') || '';

      const matchesAudience = activeAudience === 'all' || audience === activeAudience;
      const matchesLength = activeLength === 'all' || length === activeLength;
      const matchesSearch = !searchQuery || title.includes(searchQuery) || summary.includes(searchQuery);

      if (matchesAudience && matchesLength && matchesSearch) {
        matchCount++;
        if (matchCount <= visibleLimit) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      } else {
        card.classList.add('hidden');
      }
    });

    if (noResults) {
      if (matchCount === 0) noResults.classList.remove('hidden');
      else noResults.classList.add('hidden');
    }

    if (loadMoreContainer) {
      if (matchCount > visibleLimit) loadMoreContainer.classList.remove('hidden');
      else loadMoreContainer.classList.add('hidden');
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchQuery = e.target.value.trim().toLowerCase();
      visibleLimit = 12;
      updateCards();
    });
  }

  // Audience Chips
  document.querySelectorAll('.filter-audience-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      activeAudience = chip.getAttribute('data-audience');
      document.querySelectorAll('.filter-audience-chip').forEach(c => {
        c.className = 'filter-audience-chip px-3 py-1.5 rounded-full border border-[#EEDFC8] dark:border-[#383659] font-medium text-[#6B5644] dark:text-[#C8BFAF] hover:border-[#D97706] transition-all';
      });
      chip.className = 'filter-audience-chip px-3 py-1.5 rounded-full border border-[#D97706] bg-[#D97706] text-white font-bold transition-all';
      visibleLimit = 12;
      updateCards();
    });
  });

  // Length Chips
  document.querySelectorAll('.filter-length-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      activeLength = chip.getAttribute('data-length');
      document.querySelectorAll('.filter-length-chip').forEach(c => {
        c.className = 'filter-length-chip px-3 py-1.5 rounded-full border border-[#EEDFC8] dark:border-[#383659] font-medium text-[#6B5644] dark:text-[#C8BFAF] hover:border-[#D97706] transition-all';
      });
      chip.className = 'filter-length-chip px-3 py-1.5 rounded-full border border-[#D97706] bg-[#D97706] text-white font-bold transition-all';
      visibleLimit = 12;
      updateCards();
    });
  });

  // Load More
  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', () => {
      visibleLimit += 12;
      updateCards();
    });
  }
</script>
