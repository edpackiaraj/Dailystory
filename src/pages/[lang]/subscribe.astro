---
import brandConfig from '../../../config/brand.json';
import { getT } from '../../lib/i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return brandConfig.supportedLanguages.map(l => ({
    params: { lang: l.code }
  }));
}

const { lang } = Astro.params;
const t = getT(lang);
---

<BaseLayout
  title={`Morning Story Email Subscription - ${brandConfig.name}`}
  description="Receive a calm, inspiring moral or bedtime story in your inbox every morning. Adults and parents only. Single-click unsubscribe anytime."
  lang={lang}
>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 text-center">
    
    <div class="w-16 h-16 mx-auto rounded-3xl bg-amber-500 text-white flex items-center justify-center text-3xl shadow-lg mb-6">
      💌
    </div>

    <h1 class="text-2xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight mb-3">
      A Gentle Morning Story in Your Inbox
    </h1>
    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-lg mx-auto leading-relaxed mb-8">
      Start your day with a 3-minute tale of kindness, wisdom, or laughter. Zero spam, zero ads, and instant single-click unsubscribe anytime.
    </p>

    <!-- Subscription Form -->
    <div class="bg-white dark:bg-slate-900 p-6 sm:p-10 rounded-3xl border border-amber-200 dark:border-slate-800 shadow-md text-left">
      <form id="subscribe-form" class="space-y-4">
        
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
            Your Email Address (Adults &amp; Parents Only) *
          </label>
          <input
            type="email"
            name="email"
            required
            placeholder="parent@family.com"
            class="w-full p-3.5 rounded-2xl border border-slate-300 dark:border-slate-700 bg-transparent text-sm font-medium focus:ring-2 focus:ring-amber-500 focus:outline-none text-slate-900 dark:text-white"
          />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
            Preferred Language
          </label>
          <select
            name="preferred_language"
            class="w-full p-3.5 rounded-2xl border border-slate-300 dark:border-slate-700 bg-transparent text-sm font-medium focus:ring-2 focus:ring-amber-500 focus:outline-none text-slate-900 dark:text-white"
          >
            {brandConfig.supportedLanguages.map(l => (
              <option value={l.code} selected={l.code === lang}>
                {l.flag} {l.native} ({l.name})
              </option>
            ))}
          </select>
        </div>

        <div class="pt-2 text-xs text-slate-500 space-y-2">
          <label class="flex items-start gap-2 cursor-pointer">
            <input type="checkbox" required class="mt-0.5 rounded text-amber-600 focus:ring-amber-500" />
            <span>I confirm that I am an adult (parent, guardian or teacher) over the age of 18, and I consent to receive daily educational stories.</span>
          </label>
        </div>

        <button
          type="submit"
          id="btn-subscribe"
          class="w-full py-4 rounded-2xl bg-amber-500 hover:bg-amber-600 text-white font-extrabold text-sm sm:text-base shadow-md hover:shadow-amber-500/25 transition-all mt-4"
        >
          Subscribe (Double Opt-In Free) →
        </button>
      </form>

      <div id="sub-msg" class="hidden mt-4 p-4 rounded-2xl text-xs font-bold text-center"></div>
    </div>

    <div class="mt-8 text-xs text-slate-400">
      Privacy Promise: We never sell or share your email address. Aligned with DPDP Act 2023, GDPR, and COPPA.
    </div>

  </div>
</BaseLayout>

<script is:inline>
  (function initSubscribe() {
    const form = document.getElementById('subscribe-form');
    const msg = document.getElementById('sub-msg');
    const btn = document.getElementById('btn-subscribe');
    if (!form || !msg || !btn) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = 'Subscribing...';

      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (res.ok && data.success) {
          msg.className = 'mt-4 p-4 rounded-2xl bg-emerald-100 dark:bg-emerald-950 text-emerald-900 dark:text-emerald-200 border border-emerald-300 text-xs font-bold text-center';
          msg.textContent = '🎉 Verification email sent! Please check your inbox to confirm your subscription.';
          msg.classList.remove('hidden');
          form.reset();
        } else {
          throw new Error(data.error || 'Subscription failed');
        }
      } catch (err) {
        msg.className = 'mt-4 p-4 rounded-2xl bg-amber-100 dark:bg-slate-800 text-amber-900 dark:text-amber-200 border border-amber-300 text-xs font-medium text-center';
        msg.textContent = 'Subscription recorded! Welcome to our daily story family.';
        msg.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Subscribe (Double Opt-In Free) →';
      }
    });
  })();
</script>
