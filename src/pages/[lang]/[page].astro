---
import fs from 'node:fs';
import path from 'node:path';
import brandConfig from '../../../config/brand.json';
import legalData from '../../../data/legal/en.json';
import { getT } from '../../lib/i18n';
import {
  getAllReviewedStories,
  getStoryUrl,
  getCollectionSlug,
  getAudienceCategory,
  getLengthCategory,
  isStoryTranslated
} from '../../lib/stories';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryIllustration from '../../components/StoryIllustration.astro';

export function getStaticPaths() {
  const legalKeys = Object.keys(legalData.pages);
  const paths: any[] = [];

  for (const lang of brandConfig.supportedLanguages) {
    // Clean canonical paths (e.g., /en/search/, /en/about/)
    paths.push({ params: { lang: lang.code, page: 'search' }, props: { view: 'search' } });
    paths.push({ params: { lang: lang.code, page: 'favorites' }, props: { view: 'favorites' } });
    paths.push({ params: { lang: lang.code, page: 'collections' }, props: { view: 'collections' } });
    paths.push({ params: { lang: lang.code, page: 'submit' }, props: { view: 'submit' } });
    paths.push({ params: { lang: lang.code, page: 'guide' }, props: { view: 'guide' } });

    // English legacy URL aliases (prevent 404 from external legacy links)
    if (lang.code === 'en') {
      const legacyAliases: Record<string, string> = {
        'en-favorites': '/en/favorites/',
        'en-submit': '/en/submit/',
        'en-privacy': '/en/privacy/',
        'en-about': '/en/about/',
        'en-terms': '/en/terms/',
        'en-disclaimer': '/en/disclaimer/',
        'en-cookies': '/en/privacy/',
        'en-accessibility': '/en/about/',
        'en-guidelines': '/en/guide/',
        'en-parent-guide': '/en/guide/',
        'en-editorial-policy': '/en/about/',
        'en-search': '/en/search/',
        'en-contact': '/en/contact/'
      };
      for (const [alias, target] of Object.entries(legacyAliases)) {
        paths.push({
          params: { lang: 'en', page: alias },
          props: { view: 'redirect', redirectTo: target }
        });
      }
    }

    for (const key of legalKeys) {
      if (key === 'contact') {
        paths.push({
          params: { lang: lang.code, page: key },
          props: {
            view: 'contact',
            pageKey: key,
            pageData: (legalData.pages as Record<string, any>)[key],
            lastUpdated: legalData.lastUpdated
          }
        });
      } else if (key === 'about') {
        paths.push({
          params: { lang: lang.code, page: key },
          props: {
            view: 'about',
            pageKey: key,
            pageData: (legalData.pages as Record<string, any>)[key],
            lastUpdated: legalData.lastUpdated
          }
        });
      } else {
        paths.push({
          params: { lang: lang.code, page: key },
          props: {
            view: 'legal',
            pageKey: key,
            pageData: (legalData.pages as Record<string, any>)[key],
            lastUpdated: legalData.lastUpdated
          }
        });
      }
    }
  }

  return paths;
}

const { lang, page } = Astro.params;
const { view, pageKey, pageData, lastUpdated, disclaimer, redirectTo } = Astro.props;
const currentLang = lang || 'en';
const t = getT(currentLang);

// Data for Search, Favorites, and Collections
const allStories = getAllReviewedStories(currentLang);
const collectionsMap: Record<string, { name: string; count: number; image: string }> = {};
for (const s of allStories) {
  if (!collectionsMap[s.collection]) {
    collectionsMap[s.collection] = {
      name: s.collection,
      count: 0,
      image: s.image || '/images/og-default.png'
    };
  }
  collectionsMap[s.collection].count++;
}
const collectionList = Object.values(collectionsMap);

// Compact stories for instant client-side search (prioritize translated stories in non-English editions)
const orderedStories = currentLang === 'en'
  ? allStories
  : [...allStories].sort((a, b) => {
      const aTr = isStoryTranslated(a, currentLang) ? 1 : 0;
      const bTr = isStoryTranslated(b, currentLang) ? 1 : 0;
      return bTr - aTr;
    });

const compactStories = (view === 'search' || view === 'favorites') ? orderedStories.map(s => ({
  id: s.id,
  title: s.title,
  slug: s.slug,
  summary: s.summary,
  moral: s.moral,
  reading_time: s.reading_time,
  collection: s.collection,
  image: s.image,
  url: getStoryUrl(s, currentLang),
  audience: getAudienceCategory(s.age_group),
  length: getLengthCategory(s.word_count),
  is_translated: isStoryTranslated(s, currentLang),
  keywords: (s.keywords || []).join(' ').toLowerCase()
})) : [];

// Page Titles and Metadata
let pageTitle = `${brandConfig.name}`;
let pageDesc = `${brandConfig.description}`;

if (view === 'search') {
  pageTitle = `${t.search} — ${brandConfig.name}`;
  pageDesc = t.searchPlaceholder;
} else if (view === 'favorites') {
  pageTitle = `${t.favourites} — ${brandConfig.name}`;
  pageDesc = "Your saved storybook collection for offline reading.";
} else if (view === 'collections') {
  pageTitle = `${t.collections} — ${brandConfig.name}`;
  pageDesc = "Explore all timeless cultural folklore collections on Daily Tale.";
} else if (view === 'guide') {
  pageTitle = `${t.guide} — ${brandConfig.name}`;
  pageDesc = "Educational framework, Bloom's taxonomy discussion prompts, and reading guidance for families and classrooms.";
} else if (view === 'submit') {
  pageTitle = `${t.submit} — ${brandConfig.name}`;
  pageDesc = "Submit your original folktale, fable or moral story for global publication.";
} else if (view === 'contact') {
  pageTitle = `Contact Dr. S. Edward Packiaraj — ${brandConfig.name}`;
  pageDesc = "Get in touch with Dr. S. Edward Packiaraj and the Daily Tale team for educational partnerships, classroom materials, sister projects (EnglishPesalaam & NCERT Quiz Hub), or content feedback.";
} else if (view === 'about') {
  pageTitle = `About Daily Tale — ${brandConfig.tagline}`;
  pageDesc = "Learn about Daily Tale, our global multilingual folktale treasury in 8 languages, educational mission, and founder Dr. S. Edward Packiaraj.";
} else if (view === 'legal' && pageData) {
  pageTitle = `${pageData.title} — ${brandConfig.name}`;
  pageDesc = pageData.summary || `${pageData.title} for ${brandConfig.name}`;
}
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  lang={currentLang}
  activeNavTab={view === 'search' ? 'search' : (view === 'favorites' ? 'favourites' : (view === 'collections' ? 'stories' : 'home'))}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    <!-- VIEW 0: LEGACY URL REDIRECT -->
    {view === 'redirect' && (
      <div class="max-w-md mx-auto text-center py-20 space-y-4">
        <meta http-equiv="refresh" content={`0;url=${redirectTo}`} />
        <link rel="canonical" href={`${brandConfig.siteUrl}${redirectTo}`} />
        <p class="text-sm font-bold text-[#3B2A1A] dark:text-[#F3EBDD]">
          Redirecting to <a href={redirectTo} class="text-[#D97706] underline font-bold">{redirectTo}</a>...
        </p>
        <script is:inline define:vars={{ redirectTo }}>
          window.location.replace(redirectTo);
        </script>
      </div>
    )}

    <!-- VIEW 1: SEARCH PAGE -->
    {view === 'search' && (
      <div class="space-y-8">
        
        <header class="max-w-2xl mx-auto text-center space-y-3">
          <h1 class="text-3xl sm:text-5xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD] tracking-tight">
            {t.search}
          </h1>
          <p class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF]">
            Search by keyword, animal, moral virtue, culture or reading time
          </p>

          <!-- Search Input -->
          <div class="relative pt-2">
            <span class="absolute inset-y-0 left-4 top-2 flex items-center pointer-events-none text-xl text-slate-400">
              🔍
            </span>
            <input
              type="search"
              id="global-search-input"
              placeholder={t.searchPlaceholder}
              class="w-full pl-12 pr-4 py-4 rounded-3xl bg-white dark:bg-[#25243E] border-2 border-[#EEDFC8] dark:border-[#383659] shadow-md text-sm sm:text-base text-[#3B2A1A] dark:text-[#F3EBDD] placeholder-slate-400 focus:outline-none focus:border-[#D97706] transition-all"
              autofocus
            />
          </div>
        </header>

        <!-- Filters: Audience & Length Chips -->
        <div class="p-4 sm:p-6 rounded-3xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] shadow-sm flex flex-wrap items-center justify-between gap-4 text-xs">
          
          <div class="flex items-center gap-2 flex-wrap">
            <span class="font-bold text-[#6B5644] dark:text-[#C8BFAF] uppercase tracking-wider">{t.audience}:</span>
            <button type="button" class="search-aud-chip px-3 py-1.5 rounded-full border border-[#D97706] bg-[#D97706] text-white font-bold" data-audience="all">{t.all}</button>
            <button type="button" class="search-aud-chip px-3 py-1.5 rounded-full border border-[#EEDFC8] dark:border-[#383659] font-medium" data-audience="everyone">{t.everyone}</button>
            <button type="button" class="search-aud-chip px-3 py-1.5 rounded-full border border-[#EEDFC8] dark:border-[#383659] font-medium" data-audience="kids">{t.kids}</button>
            <button type="button" class="search-aud-chip px-3 py-1.5 rounded-full border border-[#EEDFC8] dark:border-[#383659] font-medium" data-audience="teens">{t.teens}</button>
          </div>

          <div class="flex items-center gap-2 flex-wrap">
            <span class="font-bold text-[#6B5644] dark:text-[#C8BFAF] uppercase tracking-wider">{t.length}:</span>
            <button type="button" class="search-len-chip px-3 py-1.5 rounded-full border border-[#D97706] bg-[#D97706] text-white font-bold" data-length="all">{t.all}</button>
            <button type="button" class="search-len-chip px-3 py-1.5 rounded-full border border-[#EEDFC8] dark:border-[#383659] font-medium" data-length="short">{t.short}</button>
            <button type="button" class="search-len-chip px-3 py-1.5 rounded-full border border-[#EEDFC8] dark:border-[#383659] font-medium" data-length="medium">{t.medium}</button>
            <button type="button" class="search-len-chip px-3 py-1.5 rounded-full border border-[#EEDFC8] dark:border-[#383659] font-medium" data-length="long">{t.long}</button>
          </div>

          <!-- Theme Quick Chips -->
          <div class="w-full pt-3 border-t border-[#EEDFC8]/60 dark:border-[#383659]/60 flex items-center gap-1.5 flex-wrap">
            <span class="font-bold text-[#6B5644] dark:text-[#C8BFAF] uppercase tracking-wider text-[11px]">Themes:</span>
            {['Honesty', 'Kindness', 'Courage', 'Wisdom', 'Hard Work', 'Friendship', 'Greed', 'Humility'].map(theme => (
              <button
                type="button"
                class="search-theme-chip px-2.5 py-1 rounded-full border border-[#EEDFC8] dark:border-[#383659] text-[11px] font-medium text-[#6B5644] dark:text-[#C8BFAF] hover:border-[#D97706] hover:bg-[#FFF4E0] dark:hover:bg-[#1E1D36] transition-all"
                data-theme={theme.toLowerCase()}
              >
                {theme}
              </button>
            ))}
          </div>

        </div>

        <!-- Search Results Count -->
        <div class="flex items-center justify-between text-xs font-semibold text-[#6B5644] dark:text-[#C8BFAF]">
          <span id="search-results-count">Showing {compactStories.length} stories</span>
        </div>

        <!-- Stories Grid (2 cols mobile, 3 cols tablet, 4 cols desktop) -->
        <div id="search-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-5">
          {compactStories.map((story, idx) => (
            <article
              class={`search-card group p-3.5 sm:p-4 rounded-2xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] hover:border-[#D97706] hover:shadow-lg transition-all flex flex-col justify-between ${idx >= 24 ? 'hidden' : ''}`}
              data-title={story.title.toLowerCase()}
              data-summary={story.summary.toLowerCase()}
              data-collection={story.collection.toLowerCase()}
              data-keywords={story.keywords}
              data-audience={story.audience}
              data-length={story.length}
            >
              <div class="space-y-2.5">
                <StoryIllustration story={story} size="card" lang={currentLang} />

                <div class="flex items-center justify-between text-[11px] text-[#6B5644] dark:text-[#C8BFAF]">
                  <span class="font-bold text-[#D97706] truncate max-w-[55%]">{story.collection}</span>
                  {story.is_translated ? (
                    <span class="px-2 py-0.5 rounded-md bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 font-bold text-[10px]">
                      ✓ {t.fullTranslationBadge || "Full"}
                    </span>
                  ) : (
                    <span>⏱ {story.reading_time || '4m'}</span>
                  )}
                </div>

                <h2 class="text-xs sm:text-sm font-black text-[#3B2A1A] dark:text-[#F3EBDD] line-clamp-2 leading-snug group-hover:text-[#D97706] transition-colors">
                  <a href={story.url}>{story.title}</a>
                </h2>

                <p class="text-xs text-[#6B5644] dark:text-[#C8BFAF] line-clamp-2 leading-relaxed">
                  {story.summary}
                </p>
              </div>

              <div class="pt-3 border-t border-[#EEDFC8]/60 dark:border-[#383659]/60 flex items-center justify-between text-xs mt-3">
                <span class="text-[11px] font-semibold text-[#0F766E] dark:text-[#2DD4BF]">
                  {story.audience === 'kids' ? t.kids : (story.audience === 'teens' ? t.teens : t.everyone)}
                </span>
                <a href={story.url} class="font-bold text-[#D97706] group-hover:translate-x-1 transition-transform">
                  {t.readStory || "Read →"}
                </a>
              </div>
            </article>
          ))}
        </div>

        <div id="search-empty" class="hidden text-center py-16 space-y-2">
          <span class="text-4xl">🔍</span>
          <p class="text-base font-bold text-[#3B2A1A] dark:text-[#F3EBDD]">{t.noResults}</p>
        </div>

      </div>
    )}

    <!-- VIEW 2: FAVOURITES PAGE -->
    {view === 'favorites' && (
      <div class="space-y-8 max-w-5xl mx-auto">
        
        <header class="space-y-2">
          <div class="flex items-center gap-2">
            <span class="text-3xl">⭐</span>
            <h1 class="text-3xl sm:text-4xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD] tracking-tight">
              {t.favourites}
            </h1>
          </div>
          <p class="text-sm text-[#6B5644] dark:text-[#C8BFAF]">
            Your personal story sanctuary. Saved stories work offline so you can read anytime.
          </p>
        </header>

        <!-- Favourites Grid Container -->
        <div id="favourites-list" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          <!-- Dynamically populated via client-side script -->
        </div>

        <!-- Empty State -->
        <div id="favourites-empty" class="text-center py-16 space-y-4 rounded-3xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] p-8">
          <div class="w-16 h-16 mx-auto rounded-2xl bg-[#D97706]/15 flex items-center justify-center text-3xl">
            ⭐
          </div>
          <div class="space-y-1">
            <h2 class="text-lg font-black text-[#3B2A1A] dark:text-[#F3EBDD]">Your Story Corner is Empty</h2>
            <p class="text-xs sm:text-sm text-[#6B5644] dark:text-[#C8BFAF] max-w-md mx-auto">
              {t.noFavourites}
            </p>
          </div>
          <a
            href={`/${currentLang}/`}
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#D97706] text-white font-bold text-xs sm:text-sm shadow-md hover:bg-[#B45309] transition-all min-h-[44px]"
          >
            Explore Stories →
          </a>
        </div>

      </div>
    )}

    <!-- VIEW 3: COLLECTIONS INDEX PAGE -->
    {view === 'collections' && (
      <div class="space-y-8">
        
        <header class="space-y-2 max-w-3xl">
          <h1 class="text-3xl sm:text-5xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD] tracking-tight">
            {t.collections}
          </h1>
          <p class="text-sm sm:text-base text-[#6B5644] dark:text-[#C8BFAF]">
            Discover the great folklore, wisdom anthologies, courtly riddles, and bedtime stories of world literature.
          </p>
        </header>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
          {collectionList.map(col => {
            const colSlug = getCollectionSlug(col.name);
            return (
              <a
                href={`/${currentLang}/collections/${colSlug}/`}
                class="group p-4 sm:p-5 rounded-3xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] hover:border-[#D97706] hover:shadow-xl transition-all flex flex-col justify-between"
              >
                <div class="space-y-3">
                  <div class="aspect-4/3 rounded-2xl overflow-hidden bg-[#EEDFC8]/30">
                    <img
                      src={col.image}
                      alt={col.name}
                      width="400"
                      height="300"
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    />
                  </div>
                  <h2 class="text-base sm:text-lg font-black text-[#3B2A1A] dark:text-[#F3EBDD] group-hover:text-[#D97706] transition-colors leading-snug">
                    {col.name}
                  </h2>
                </div>
                <div class="pt-3 border-t border-[#EEDFC8]/60 dark:border-[#383659]/60 flex items-center justify-between text-xs mt-4">
                  <span class="font-bold text-[#0F766E] dark:text-[#2DD4BF]">{col.count} {t.stories}</span>
                  <span class="font-bold text-[#D97706] group-hover:translate-x-1 transition-transform">Browse →</span>
                </div>
              </a>
            );
          })}
        </div>

      </div>
    )}

    <!-- VIEW 4: TEACHER & PARENT GUIDE -->
    {view === 'guide' && (
      <div class="max-w-3xl mx-auto space-y-8">
        
        <header class="space-y-3 text-center">
          <div class="w-16 h-16 mx-auto rounded-3xl bg-[#0F766E]/15 flex items-center justify-center text-3xl">
            🌱
          </div>
          <h1 class="text-3xl sm:text-4xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD] tracking-tight">
            {t.guide}
          </h1>
          <p class="text-sm text-[#6B5644] dark:text-[#C8BFAF]">
            A guide for families, educators, and language learners to spark meaningful discussions and deep reading joy.
          </p>
        </header>

        <div class="p-6 rounded-3xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] shadow-sm space-y-6 text-sm text-[#3B2A1A] dark:text-[#F3EBDD] leading-relaxed">
          <div class="space-y-2">
            <h2 class="text-lg font-black text-[#D97706]">1. Audience &amp; Age Guidance</h2>
            <p>
              We classify stories under three respectful categories: <strong>Everyone</strong> (universal folklore suitable for all ages), <strong>Kids</strong> (gentle animal fables, simple rhymes, bedtime tales), and <strong>Teens</strong> (moral dilemmas, courtly satire, and nuanced decisions). We deliberately avoid patronizing labels to encourage family co-reading.
            </p>
          </div>

          <div class="space-y-2">
            <h2 class="text-lg font-black text-[#D97706]">2. Using the Bloom's Taxonomy "Think &amp; Talk" Prompts</h2>
            <p>
              At the bottom of every story, you will find discussion prompts graded from basic recall (Remembering) to higher-order ethical reasoning (Evaluating &amp; Creating). Use these questions during dinner, car rides, or bedtime to encourage children to articulate why a character made a specific choice.
            </p>
          </div>

          <div class="space-y-2">
            <h2 class="text-lg font-black text-[#D97706]">3. Dual-Language &amp; Vocabulary Learning</h2>
            <p>
              Readers learning a new language can listen to speech narration at slower speeds (0.8x) while following the text. The "Words to Learn" section highlights challenging or poetic words to build vocabulary naturally in context.
            </p>
          </div>
        </div>

      </div>
    )}

    <!-- VIEW 5: SUBMIT A STORY -->
    {view === 'submit' && (
      <div class="max-w-2xl mx-auto space-y-8">
        
        <header class="space-y-3 text-center">
          <div class="w-16 h-16 mx-auto rounded-3xl bg-[#D97706]/15 flex items-center justify-center text-3xl">
            ✍️
          </div>
          <h1 class="text-3xl sm:text-4xl font-black font-display text-[#3B2A1A] dark:text-[#F3EBDD] tracking-tight">
            {t.submit}
          </h1>
          <p class="text-sm text-[#6B5644] dark:text-[#C8BFAF]">
            Share your traditional folklore retelling or original wisdom story with readers around the globe.
          </p>
        </header>

        <form class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-[#25243E] border border-[#EEDFC8] dark:border-[#383659] shadow-sm space-y-5 text-xs sm:text-sm">
          <div>
            <label class="block font-bold text-[#3B2A1A] dark:text-[#F3EBDD] mb-1.5">Your Name or Pen Name</label>
            <input type="text" required class="w-full p-3 rounded-2xl bg-[#FFF8EC] dark:bg-[#1B1A2E] border border-[#EEDFC8] dark:border-[#383659] focus:ring-2 focus:ring-[#D97706] focus:outline-none" />
          </div>

          <div>
            <label class="block font-bold text-[#3B2A1A] dark:text-[#F3EBDD] mb-1.5">Email Address</label>
            <input type="email" required class="w-full p-3 rounded-2xl bg-[#FFF8EC] dark:bg-[#1B1A2E] border border-[#EEDFC8] dark:border-[#383659] focus:ring-2 focus:ring-[#D97706] focus:outline-none" />
          </div>

          <div>
            <label class="block font-bold text-[#3B2A1A] dark:text-[#F3EBDD] mb-1.5">Story Title</label>
            <input type="text" required class="w-full p-3 rounded-2xl bg-[#FFF8EC] dark:bg-[#1B1A2E] border border-[#EEDFC8] dark:border-[#383659] focus:ring-2 focus:ring-[#D97706] focus:outline-none" />
          </div>

          <div>
            <label class="block font-bold text-[#3B2A1A] dark:text-[#F3EBDD] mb-1.5">Story Full Text</label>
            <textarea rows="8" required class="w-full p-3 rounded-2xl bg-[#FFF8EC] dark:bg-[#1B1A2E] border border-[#EEDFC8] dark:border-[#383659] focus:ring-2 focus:ring-[#D97706] focus:outline-none leading-relaxed" placeholder="Write or paste your story here (300 to 1,200 words)..."></textarea>
          </div>

          <div>
            <label class="block font-bold text-[#3B2A1A] dark:text-[#F3EBDD] mb-1.5">Moral / Takeaway</label>
            <input type="text" required class="w-full p-3 rounded-2xl bg-[#FFF8EC] dark:bg-[#1B1A2E] border border-[#EEDFC8] dark:border-[#383659] focus:ring-2 focus:ring-[#D97706] focus:outline-none" />
          </div>

          <button
            type="submit"
