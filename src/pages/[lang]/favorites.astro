---
import brandConfig from '../../../config/brand.json';
import { getT } from '../../lib/i18n';
import { getAllReviewedStories } from '../../lib/stories';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryGarden from '../../components/StoryGarden.astro';
import StoryPassport from '../../components/StoryPassport.astro';

export function getStaticPaths() {
  return brandConfig.supportedLanguages.map(l => ({
    params: { lang: l.code }
  }));
}

const { lang } = Astro.params;
const t = getT(lang);
const allStories = getAllReviewedStories(lang);
---

<BaseLayout
  title={`My Story Corner - ${brandConfig.name}`}
  description="Your private reading sanctuary: bookmarked stories, reading streak, garden blossoms, and world passport."
  lang={lang}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-12">
    
    <!-- Header -->
    <div class="max-w-3xl">
      <div class="flex items-center gap-3 mb-2">
        <span class="text-3xl">⭐</span>
        <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white">
          {t.myCorner}
        </h1>
      </div>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400">
        Your reading progress, bookmarked tales, and earned stickers. All kept privately inside your device!
      </p>
    </div>

    <!-- Garden and Passport Overview -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <StoryGarden />
      <StoryPassport />
    </div>

    <!-- Bookmarked Stories Section -->
    <section>
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-black text-slate-900 dark:text-white flex items-center gap-2">
          <span>❤️</span> Saved Favorite Stories
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6" id="favorites-grid">
        <!-- Loaded dynamically from localStorage -->
      </div>

      <div id="no-favorites" class="p-8 text-center bg-white dark:bg-slate-900 rounded-3xl border border-amber-200 dark:border-slate-800">
        <span class="text-4xl block mb-2">🤍</span>
        <h3 class="font-bold text-slate-800 dark:text-slate-200 text-sm mb-1">No stories saved yet</h3>
        <p class="text-xs text-slate-500 mb-4">Click "Save to My Corner" on any story page to keep your favorite tales right here.</p>
        <a href={`/${lang}/`} class="inline-block px-4 py-2 rounded-full bg-amber-500 text-white font-bold text-xs">
          Explore Stories Today
        </a>
      </div>
    </section>

    <!-- Hidden Store with all story metadata for client matching -->
    <div id="all-stories-store" class="hidden">
      {allStories.map(s => (
        <div
          data-id={s.id}
          data-title={s.title}
          data-slug={s.slug}
          data-image={s.image}
          data-image-alt={s.image_alt}
          data-collection={s.collection}
          data-reading-time={s.reading_time}
          data-summary={s.summary}
        />
      ))}
    </div>

  </div>
</BaseLayout>

<script is:inline>
  (function initMyCorner() {
    const favGrid = document.getElementById('favorites-grid');
    const noFavBox = document.getElementById('no-favorites');
    const store = document.getElementById('all-stories-store');
    if (!favGrid || !store) return;

    const favIds = JSON.parse(localStorage.getItem('story_favorites') || '[]');
    const storyElems = Array.from(store.children);

    let matchCount = 0;
    favGrid.innerHTML = '';

    storyElems.forEach(el => {
      const id = el.getAttribute('data-id');
      if (favIds.includes(id)) {
        matchCount++;
        const title = el.getAttribute('data-title');
        const slug = el.getAttribute('data-slug');
        const image = el.getAttribute('data-image');
        const imageAlt = el.getAttribute('data-image-alt');
        const collection = el.getAttribute('data-collection');
        const time = el.getAttribute('data-reading-time');
        const summary = el.getAttribute('data-summary');

        const card = document.createElement('div');
        card.className = 'bg-white dark:bg-slate-900 rounded-3xl border border-amber-200 dark:border-slate-800 overflow-hidden shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between';
        card.innerHTML = `
          <div>
            <div class="aspect-16/10 overflow-hidden relative">
              <img src="${image}" alt="${imageAlt}" class="w-full h-full object-cover" />
              <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-black/60 text-white text-[11px] font-bold">${collection}</span>
              <span class="absolute bottom-3 right-3 px-2 py-0.5 rounded-full bg-amber-500 text-white text-[11px] font-bold">${time}</span>
            </div>
            <div class="p-5">
              <h3 class="font-bold text-base text-slate-800 dark:text-slate-100 mb-2">${title}</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 line-clamp-2 leading-relaxed">${summary}</p>
            </div>
          </div>
          <div class="p-5 pt-0">
            <a href="/${window.location.pathname.split('/')[1] || 'en'}/collections/${(collection || 'world-folktales').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}/#${slug}" class="block text-center py-2.5 rounded-full bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs shadow-xs transition-colors">
              Read Again →
            </a>
          </div>
        `;
        favGrid.appendChild(card);
      }
    });

    if (matchCount > 0 && noFavBox) {
      noFavBox.classList.add('hidden');
    }
  })();
</script>
